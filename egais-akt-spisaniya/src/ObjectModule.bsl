#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция Версия() Экспорт
	Возврат "0.1.1";
КонецФункции

// Заполняет табличную часть Результаты по выбранному акту.
Процедура ВыполнитьДиагностику() Экспорт
	
	Результаты.Очистить();
	
	Если Не ЗначениеЗаполнено(Акт) Тогда
		ВызватьИсключение "Не выбран акт списания ЕГАИС.";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаДиагностики());
	Запрос.УстановитьПараметр("Акт", Акт);
	Запрос.УстановитьПараметр("СтатусВНаличии", ЗначениеСтатуса("ВНаличии"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результаты.Добавить(), Выборка);
	КонецЦикла;
	
	ДополнитьДиагностикуКейс1();
	
	Для Каждого СтрокаРезультата Из Результаты Цикл
		Классифицировать(СтрокаРезультата);
	КонецЦикла;
	
	ОбновитьОписанияКейса4();
	
КонецПроцедуры

// Формирует ПланИзменений по результатам диагностики.
Процедура СформироватьПлан() Экспорт
	
	ПланИзменений.Очистить();
	
	СформироватьПланКейс1();   // кейс 1, части 1 и 2
	СформироватьПланКейс2();   // кейс 2
	СформироватьПланКейс3();   // кейс 3
	СформироватьПланКейс4();   // кейс 4
	ДобавитьПланПоКрепости();  // крепость, по всем справкам акта
	СформироватьПланАкта();    // заполнение акта
	
КонецПроцедуры

// Применяет подтверждённые строки плана, каждую в своей транзакции.
Процедура ПрименитьПлан() Экспорт
	
	Выполнено = 0;
	
	Для Каждого СтрокаПлана Из ПланИзменений Цикл
		
		Если Не СтрокаПлана.Подтверждено Или СтрокаПлана.Выполнено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выполнено >= ЛимитПакета Тогда
			Прервать;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			ВыполнитьДействие(СтрокаПлана);
			ЗафиксироватьТранзакцию();
			СтрокаПлана.Выполнено = Истина;
			СтрокаПлана.Результат = "OK";
			Выполнено = Выполнено + 1;
			ЗапомнитьИсправленнуюСправку(СтрокаПлана);
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			СтрокаПлана.Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		ЗаписатьВЖурнал(СтрокаПлана);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что все объекты из адаптера существуют в конфигурации.
Функция ПроверитьАдаптер() Экспорт
	
	Ошибки = Новый Массив;
	Имена = ИменаОбъектов();
	
	// Акцизные марки
	ПроверитьОбъект(Имена.ТаблицаМарок, Ошибки);
	Для Каждого Ключ Из СтрРазделить("МаркаКод,МаркаСтатус,МаркаСправка2,МаркаАлкопродукция,МаркаОснование,МаркаНоменклатура", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаМарок, Имена[Ключ], Ошибки);
	КонецЦикла;
	
	// Справочники
	ПроверитьОбъект(Имена.ТаблицаСправок2, Ошибки);
	ПроверитьРеквизит(Имена.ТаблицаСправок2, Имена.Справка2Алкопродукция, Ошибки);
	ПроверитьОбъект(Имена.ТаблицаАлкопродукции, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АлкопродукцияВидПродукции,АлкопродукцияОбъем,АлкопродукцияКрепость,АлкопродукцияПроизводитель", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаАлкопродукции, Имена[Ключ], Ошибки);
	КонецЦикла;
	ПроверитьОбъект(Имена.ТаблицаНоменклатуры, Ошибки);
	Для Каждого Ключ Из СтрРазделить("НоменклатураВидПродукции,НоменклатураОбъем,НоменклатураКрепость", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаНоменклатуры, Имена[Ключ], Ошибки);
	КонецЦикла;
	
	// Соответствие номенклатуры
	ПроверитьОбъект(Имена.РегистрСоответствий, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеНоменклатура, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеАлкопродукция, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеСправка2, Ошибки);
	
	// ТТН
	ПроверитьОбъект(Имена.ДокументТТН, Ошибки);
	ПроверитьТабличнуюЧасть(Имена.ДокументТТН, Имена.ТЧТТН, Ошибки);
	Для Каждого Ключ Из СтрРазделить("ТТНСправка2,ТТНАлкопродукция,ТТННоменклатура,ТТНКоличество", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументТТН, Имена[Ключ], Ошибки, Имена.ТЧТТН);
	КонецЦикла;
	Если Имена.ОснованиеТТН_Способ = "РеквизитТТН" Тогда
		ПроверитьРеквизит(Имена.ДокументТТН, Имена.ТТНРеквизитОснования, Ошибки);
	КонецЕсли;
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		Если Метаданные.НайтиПоПолномуИмени(Описание.ПолноеИмя) = Неопределено Тогда
			Ошибки.Добавить("Не найден документ-основание ТТН (можно убрать из ДокументыОснованияТТН): " + Описание.ПолноеИмя);
		Иначе
			ПроверитьТабличнуюЧасть(Описание.ПолноеИмя, Описание.ТЧ, Ошибки);
			ПроверитьРеквизит(Описание.ПолноеИмя, Описание.Номенклатура, Ошибки, Описание.ТЧ);
			ПроверитьРеквизит(Описание.ПолноеИмя, Описание.Количество, Ошибки, Описание.ТЧ);
			Если Имена.ОснованиеТТН_Способ = "РеквизитОснования" Тогда
				ПроверитьРеквизит(Описание.ПолноеИмя, Описание.СсылкаНаТТН, Ошибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Акт списания
	ПроверитьОбъект(Имена.ДокументАкт, Ошибки);
	ПроверитьРеквизит(Имена.ДокументАкт, Имена.АктОрганизацияЕГАИС, Ошибки);
	ПроверитьТабличнуюЧасть(Имена.ДокументАкт, Имена.ТЧАктаТовары, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АктСправка2,АктКоличество,АктТоварыКлючСвязи,АктТоварыАлкопродукция", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументАкт, Имена[Ключ], Ошибки, Имена.ТЧАктаТовары);
	КонецЦикла;
	ПроверитьТабличнуюЧасть(Имена.ДокументАкт, Имена.ТЧАктаМарки, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АктМаркиКлючСвязи,АктМаркиЗначение", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументАкт, Имена[Ключ], Ошибки, Имена.ТЧАктаМарки);
	КонецЦикла;
	
	// Марки в чеках (необязательно)
	Если ЗначениеЗаполнено(Имена.ТаблицаМарокЧеков) Тогда
		Части = СтрРазделить(Имена.ТаблицаМарокЧеков, ".");
		Если Части.Количество() = 3 Тогда
			ПолноеИмяЧека = Части[0] + "." + Части[1];
			ПроверитьОбъект(ПолноеИмяЧека, Ошибки);
			ПроверитьТабличнуюЧасть(ПолноеИмяЧека, Части[2], Ошибки);
			ПроверитьРеквизит(ПолноеИмяЧека, Имена.ЧекМаркаКод, Ошибки, Части[2]);
		Иначе
			Ошибки.Добавить("ТаблицаМарокЧеков должна иметь вид Документ.Имя.ТабличнаяЧасть");
		КонецЕсли;
	КонецЕсли;
	
	// Документ запроса марок
	ПроверитьОбъект(Имена.ДокументЗапросаМарок, Ошибки);
	Для Каждого Ключ Из СтрРазделить("ЗапросОрганизацияЕГАИС,ЗапросСправка2,ЗапросАлкопродукция", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументЗапросаМарок, Имена[Ключ], Ошибки);
	КонецЦикла;
	
	// Перечисление статусов и его значения
	МетаПеречисление = Метаданные.Перечисления.Найти(Имена.ПеречислениеСтатусов);
	Если МетаПеречисление = Неопределено Тогда
		Ошибки.Добавить("Не найдено перечисление статусов: " + Имена.ПеречислениеСтатусов);
	Иначе
		Для Каждого КлючЗначение Из СоответствиеСтатусов() Цикл
			Если МетаПеречисление.ЗначенияПеречисления.Найти(КлючЗначение.Значение) = Неопределено Тогда
				Ошибки.Добавить(СтрШаблон("Нет значения статуса ""%1"" (логический статус ""%2"")",
					КлючЗначение.Значение, КлючЗначение.Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

#КонецОбласти

#Область АдаптерМетаданных

// ЕДИНСТВЕННОЕ место с именами объектов конфигурации.
// Значения реквизитов номенклатуры/алкопродукции могут быть путём через точку
// (например, "ВидАлкогольнойПродукции.Код").
Функция ИменаОбъектов() Экспорт
	
	Имена = Новый Структура;
	
	// Акцизные марки ЕГАИС
	Имена.Вставить("ТаблицаМарок",       "Справочник.АкцизныеМаркиЕГАИС"); // УТОЧНИТЬ: справочник или регистр сведений
	Имена.Вставить("МаркаКод",           "Код");                           // УТОЧНИТЬ
	Имена.Вставить("МаркаСтатус",        "Статус");                        // УТОЧНИТЬ
	Имена.Вставить("МаркаСправка2",      "Справка2");                      // УТОЧНИТЬ
	Имена.Вставить("МаркаАлкопродукция", "АлкогольнаяПродукция");          // УТОЧНИТЬ
	Имена.Вставить("МаркаОснование",     "ДокументОснование");             // УТОЧНИТЬ. Основание меняется: ТТН → чек → акт
	Имена.Вставить("МаркаНоменклатура",  "Номенклатура");                  // УТОЧНИТЬ: номенклатура, видимая в марке через «Функции технического специалиста»
	
	// Справки 2
	Имена.Вставить("ТаблицаСправок2",       "Справочник.СправкиБЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("Справка2Алкопродукция", "АлкогольнаяПродукция");     // УТОЧНИТЬ
	
	// Алкогольная продукция
	Имена.Вставить("ТаблицаАлкопродукции",       "Справочник.КлассификаторАлкогольнойПродукцииЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияВидПродукции",  "ВидПродукции");   // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияОбъем",         "Объем");          // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияКрепость",      "Крепость");       // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияПроизводитель", "Производитель");  // УТОЧНИТЬ
	
	// Номенклатура
	Имена.Вставить("ТаблицаНоменклатуры",      "Справочник.Номенклатура");       // УТОЧНИТЬ
	Имена.Вставить("НоменклатураВидПродукции", "ВидАлкогольнойПродукции");       // УТОЧНИТЬ
	Имена.Вставить("НоменклатураОбъем",        "ОбъемДАЛ");                      // УТОЧНИТЬ: единицы!
	Имена.Вставить("НоменклатураКрепость",     "КрепостьАлкогольнойПродукции");  // УТОЧНИТЬ
	
	// Соответствие номенклатуры ЕГАИС
	Имена.Вставить("РегистрСоответствий",       "РегистрСведений.СоответствиеНоменклатурыЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("СоответствиеНоменклатура",  "Номенклатура");         // УТОЧНИТЬ
	Имена.Вставить("СоответствиеАлкопродукция", "АлкогольнаяПродукция"); // УТОЧНИТЬ
	Имена.Вставить("СоответствиеСправка2",      "Справка2");             // УТОЧНИТЬ, пусто — измерения нет
	
	// ТТН ЕГАИС
	Имена.Вставить("ДокументТТН",      "Документ.ТТНВходящаяЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("ТЧТТН",            "Товары");                    // УТОЧНИТЬ
	Имена.Вставить("ТТНСправка2",      "Справка2");                  // УТОЧНИТЬ
	Имена.Вставить("ТТНАлкопродукция", "АлкогольнаяПродукция");      // УТОЧНИТЬ
	Имена.Вставить("ТТННоменклатура",  "Номенклатура");              // УТОЧНИТЬ
	Имена.Вставить("ТТНКоличество",    "Количество");                // УТОЧНИТЬ
	
	// Связь ТТН с поступлением/перемещением: "РеквизитТТН" или "РеквизитОснования". УТОЧНИТЬ
	Имена.Вставить("ОснованиеТТН_Способ",  "РеквизитОснования");
	Имена.Вставить("ТТНРеквизитОснования", "ДокументОснование"); // УТОЧНИТЬ, при способе "РеквизитТТН"
	
	// Акт списания ЕГАИС
	Имена.Вставить("ДокументАкт",            "Документ.АктСписанияЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("АктОрганизацияЕГАИС",    "ОрганизацияЕГАИС");          // УТОЧНИТЬ
	Имена.Вставить("ТЧАктаТовары",           "Товары");                    // УТОЧНИТЬ
	Имена.Вставить("АктСправка2",            "Справка2");                  // УТОЧНИТЬ
	Имена.Вставить("АктКоличество",          "Количество");                // УТОЧНИТЬ
	Имена.Вставить("АктТоварыКлючСвязи",     "ИдентификаторСтроки");       // УТОЧНИТЬ
	Имена.Вставить("АктТоварыАлкопродукция", "АлкогольнаяПродукция");      // УТОЧНИТЬ
	Имена.Вставить("ТЧАктаМарки",            "АкцизныеМарки");             // УТОЧНИТЬ
	Имена.Вставить("АктМаркиКлючСвязи",      "ИдентификаторСтроки");       // УТОЧНИТЬ
	Имена.Вставить("АктМаркиЗначение",       "АкцизнаяМарка");             // УТОЧНИТЬ
	
	// Марки в чеках. Пусто — проверка «нет чека» отключена.
	Имена.Вставить("ТаблицаМарокЧеков", "Документ.ЧекККМ.АкцизныеМарки"); // УТОЧНИТЬ
	Имена.Вставить("ЧекМаркаКод",       "КодМарки");                      // УТОЧНИТЬ
	
	// Запрос марок / остатков регистра 3
	Имена.Вставить("ДокументЗапросаМарок",   "Документ.ЗапросОстатковЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("ЗапросОрганизацияЕГАИС", "ОрганизацияЕГАИС");             // УТОЧНИТЬ
	Имена.Вставить("ЗапросСправка2",         "Справка2");                     // УТОЧНИТЬ
	Имена.Вставить("ЗапросАлкопродукция",    "АлкогольнаяПродукция");         // УТОЧНИТЬ
	
	// Статусы марок
	Имена.Вставить("ПеречислениеСтатусов", "СтатусыАкцизныхМарокЕГАИС"); // УТОЧНИТЬ
	
	Возврат Имена;
	
КонецФункции

// Логический статус -> имя значения перечисления.
Функция СоответствиеСтатусов() Экспорт
	
	Статусы = Новый Структура;
	Статусы.Вставить("ВНаличии",                 "ВНаличии");                 // УТОЧНИТЬ
	Статусы.Вставить("Реализована",              "Реализована");              // УТОЧНИТЬ
	Статусы.Вставить("ВРезерве",                 "ВРезерве");                 // УТОЧНИТЬ
	Статусы.Вставить("НаОстаткахПоЧекуВозврата", "НаОстаткахПоЧекуВозврата"); // УТОЧНИТЬ
	Возврат Статусы;
	
КонецФункции

// Документы, которые могут быть основанием ТТН. УТОЧНИТЬ все имена.
Функция ДокументыОснованияТТН() Экспорт
	
	Документы = Новый Массив;
	Документы.Добавить(Новый Структура("ПолноеИмя, ТЧ, Номенклатура, Количество, СсылкаНаТТН",
		"Документ.ПоступлениеТоваров", "Товары", "Номенклатура", "Количество", "ТТНЕГАИС"));
	Документы.Добавить(Новый Структура("ПолноеИмя, ТЧ, Номенклатура, Количество, СсылкаНаТТН",
		"Документ.ПеремещениеТоваров", "Товары", "Номенклатура", "Количество", "ТТНЕГАИС"));
	Возврат Документы;
	
КонецФункции

Функция ЗначениеСтатуса(ЛогическийСтатус) Экспорт
	
	Имена = ИменаОбъектов();
	ИмяЗначения = СоответствиеСтатусов()[ЛогическийСтатус];
	Возврат Перечисления[Имена.ПеречислениеСтатусов][ИмяЗначения];
	
КонецФункции

// Значение перечисления -> логический статус. Неизвестный — пустая строка.
Функция ЛогическийСтатус(ЗначениеСтатусаВ1С) Экспорт
	
	Для Каждого КлючЗначение Из СоответствиеСтатусов() Цикл
		Если ЗначениеСтатуса(КлючЗначение.Ключ) = ЗначениеСтатусаВ1С Тогда
			Возврат КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Функция МаркиВСправочнике() Экспорт
	Возврат СтрНачинаетсяС(ИменаОбъектов().ТаблицаМарок, "Справочник.");
КонецФункции

// Подставляет имена из адаптера в текст запроса: #Ключ# -> значение.
Функция ПодготовитьТекстЗапроса(Знач Текст) Экспорт
	
	Для Каждого КлючЗначение Из ИменаОбъектов() Цикл
		Текст = СтрЗаменить(Текст, "#" + КлючЗначение.Ключ + "#", КлючЗначение.Значение);
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

