// Какой статус ставить в 1С по состоянию марки в ЕГАИС.
// СостояниеЕГАИС: "НаБалансе", "Списана", "Чужая". Подтвердить с заказчиком.
Функция МатрицаСтатусов() Экспорт
	
	М = Новый ТаблицаЗначений;
	М.Колонки.Добавить("СостояниеЕГАИС");
	М.Колонки.Добавить("СтатусВ1С");
	М.Колонки.Добавить("НовыйСтатус");
	
	ДобавитьПравило(М, "НаБалансе", "Реализована",              "ВНаличии");
	ДобавитьПравило(М, "НаБалансе", "ВРезерве",                 "ВНаличии");
	ДобавитьПравило(М, "НаБалансе", "НаОстаткахПоЧекуВозврата", "ВНаличии");
	ДобавитьПравило(М, "Списана",   "ВНаличии",                 "Реализована");
	ДобавитьПравило(М, "Списана",   "ВРезерве",                 "Реализована");
	ДобавитьПравило(М, "Списана",   "НаОстаткахПоЧекуВозврата", "Реализована");
	// "Чужая" — никогда не меняем автоматически.
	
	Возврат М;
	
КонецФункции

Процедура ДобавитьПравило(М, СостояниеЕГАИС, СтатусВ1С, НовыйСтатус)
	
	Правило = М.Добавить();
	Правило.СостояниеЕГАИС = СостояниеЕГАИС;
	Правило.СтатусВ1С = СтатусВ1С;
	Правило.НовыйСтатус = НовыйСтатус;
	
КонецПроцедуры

#КонецОбласти

#Область Диагностика

Функция ТекстЗапросаДиагностики()
	
	Текст =
	"ВЫБРАТЬ
	|	СтрокиАкта.#АктСправка2# КАК Справка2,
	|	СУММА(СтрокиАкта.#АктКоличество#) КАК ТребуетсяМарок
	|ПОМЕСТИТЬ ВТСправкиАкта
	|ИЗ
	|	#ДокументАкт#.#ТЧАктаТовары# КАК СтрокиАкта
	|ГДЕ
	|	СтрокиАкта.Ссылка = &Акт
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиАкта.#АктСправка2#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция
	|ПОМЕСТИТЬ ВТСопоставленные
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСправкиАкта.Справка2 КАК Справка2,
	|	ВТСправкиАкта.ТребуетсяМарок КАК ТребуетсяМарок,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК ВсегоМарок,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаСтатус# = &СтатусВНаличии
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВНаличии,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаАлкопродукция# = ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезАлкопродукции,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|					И Сопоставленные.Алкопродукция ЕСТЬ NULL
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезСоответствия
	|ИЗ
	|	ВТСправкиАкта КАК ВТСправкиАкта
	|		ЛЕВОЕ СОЕДИНЕНИЕ #ТаблицаМарок# КАК Марки
	|		ПО (Марки.#МаркаСправка2# = ВТСправкиАкта.Справка2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСопоставленные КАК Сопоставленные
	|		ПО (Сопоставленные.Алкопродукция = Марки.#МаркаАлкопродукция#)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСправкиАкта.Справка2,
	|	ВТСправкиАкта.ТребуетсяМарок";
	
	Возврат ПодготовитьТекстЗапроса(Текст);
	
КонецФункции

// Порядок проверок: нет марок → номенклатура → соответствие → статусы.
Процедура Классифицировать(СтрокаРезультата)
	
	Если СтрокаРезультата.ВсегоМарок = 0 Тогда
		СтрокаРезультата.Кейс = 4;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = "По справке нет ни одной марки в 1С.";
		
	ИначеЕсли СтрокаРезультата.БезАлкопродукции > 0 Или СтрокаРезультата.НеверныхНоменклатур > 0 Тогда
		СтрокаРезультата.Кейс = 1;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон("Номенклатура: пустая алкопродукция — %1, неверная номенклатура — %2.",
			СтрокаРезультата.БезАлкопродукции, СтрокаРезультата.НеверныхНоменклатур);
		
	ИначеЕсли СтрокаРезультата.БезСоответствия > 0 Тогда
		СтрокаРезультата.Кейс = 3;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон("Нет соответствия номенклатуры для %1 марок.", СтрокаРезультата.БезСоответствия);
		
	ИначеЕсли СтрокаРезультата.ВНаличии < СтрокаРезультата.ТребуетсяМарок Тогда
		СтрокаРезультата.Кейс = 2;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон("В наличии %1 из %2 требуемых марок.",
			СтрокаРезультата.ВНаличии, СтрокаРезультата.ТребуетсяМарок);
		
	ИначеЕсли СтрокаРезультата.ВНаличии > СтрокаРезультата.ТребуетсяМарок Тогда
		СтрокаРезультата.Кейс = 0;
		СтрокаРезультата.Статус = "Предупреждение";
		СтрокаРезультата.Описание = СтрШаблон("В наличии %1 марок, требуется %2. Проверить остатки вручную.",
			СтрокаРезультата.ВНаличии, СтрокаРезультата.ТребуетсяМарок);
		
	Иначе
		СтрокаРезультата.Кейс = 0;
		СтрокаРезультата.Статус = "Готово";
		СтрокаРезультата.Описание = "";
	КонецЕсли;
	
КонецПроцедуры

Функция СправкиКейса(Кейс) Экспорт
	
	Справки = Новый Массив;
	Для Каждого СтрокаРезультата Из Результаты.НайтиСтроки(Новый Структура("Кейс", Кейс)) Цикл
		Справки.Добавить(СтрокаРезультата.Справка2);
	КонецЦикла;
	Возврат Справки;
	
КонецФункции

#КонецОбласти

#Область ПланИПрименение

Процедура ДобавитьВПлан(Кейс, Справка2, ТипДействия, Объект, Было, Стало, Основание, ПараметрыДействия = Неопределено) Экспорт
	
	СтрокаПлана = ПланИзменений.Добавить();
	СтрокаПлана.Кейс = Кейс;
	СтрокаПлана.Справка2 = Справка2;
	СтрокаПлана.ТипДействия = ТипДействия;
	СтрокаПлана.Объект = Объект;
	СтрокаПлана.Было = Было;
	СтрокаПлана.Стало = Стало;
	СтрокаПлана.Основание = Основание;
	СтрокаПлана.Подтверждено = Ложь;
	
	Если ПараметрыДействия <> Неопределено Тогда
		СтрокаПлана.ПараметрыСтрокой = ЗначениеВСтрокуВнутр(ПараметрыДействия);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДействие(СтрокаПлана)
	
	ПараметрыДействия = Неопределено;
	Если ЗначениеЗаполнено(СтрокаПлана.ПараметрыСтрокой) Тогда
		ПараметрыДействия = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
	КонецЕсли;
	
	ТипДействия = СтрокаПлана.ТипДействия;
	
	Если ТипДействия = "ПерепроведениеДокумента" Тогда
		ДействиеПерепровестиДокумент(СтрокаПлана.Объект, ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗаполнениеНоменклатуры" Тогда
		ДействиеЗаполнитьНоменклатуруТТН(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ИзменениеКрепости" Тогда
		ДействиеИзменитьКрепость(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "СменаСтатуса" Тогда
		ДействиеСменитьСтатус(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "СозданиеСоответствия" Тогда
		ДействиеСоздатьСоответствие(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗапросМарок" Тогда
		ДействиеПоставитьВОчередь(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ПерепривязкаМарки" Тогда
		ДействиеПерепривязатьМарку(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗаполнениеСтрокиАкта" Тогда
		ДействиеЗаполнитьСтрокуАкта(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "Информация" Тогда
		ВызватьИсключение "Информационная строка: применять нечего, нужна ручная проверка.";
		
	Иначе
		ВызватьИсключение "Неизвестный тип действия: " + ТипДействия;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапомнитьИсправленнуюСправку(СтрокаПлана)
	
	Если СтрокаПлана.ТипДействия = "ЗаполнениеСтрокиАкта" Или СтрокаПлана.ТипДействия = "ЗапросМарок" Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПлана.Справка2)
		И ИсправленныеСправки.Найти(СтрокаПлана.Справка2, "Справка2") = Неопределено Тогда
		ИсправленныеСправки.Добавить().Справка2 = СтрокаПлана.Справка2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВЖурнал(СтрокаПлана)
	
	Уровень = ?(СтрокаПлана.Выполнено, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	
	Комментарий = СтрШаблон("Кейс %1. Справка 2: %2. Было: %3. Стало: %4. Основание: %5. Результат: %6",
		СтрокаПлана.Кейс, СтрокаПлана.Справка2, СтрокаПлана.Было, СтрокаПлана.Стало,
		СтрокаПлана.Основание, СтрокаПлана.Результат);
	
	ЗаписьЖурналаРегистрации("ПомощникАктаЕГАИС." + СтрокаПлана.ТипДействия, Уровень, ,
		СтрокаПлана.Объект, Комментарий);
	
КонецПроцедуры

#КонецОбласти

#Область Кейс1_НоменклатураНаМарке

Процедура ДополнитьДиагностикуКейс1()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Текст =
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК НеверныхНоменклатур
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|		ПО (СтрокиТТН.Ссылка = Марки.#МаркаОснование#)
	|			И (СтрокиТТН.#ТТНСправка2# = Марки.#МаркаСправка2#)
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|	И (СтрокиТТН.#ТТННоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|			ИЛИ СтрокиТТН.#ТТННоменклатура#.#НоменклатураВидПродукции# <> Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции#
	|			ИЛИ (&ПроверятьОбъем
	|				И СтрокиТТН.#ТТННоменклатура#.#НоменклатураОбъем# <> Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем#))
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаСправка2#";
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	Запрос.УстановитьПараметр("ПроверятьОбъем", НастройкаПроверятьОбъем());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультата = Результаты.Найти(Выборка.Справка2, "Справка2");
		Если СтрокаРезультата <> Неопределено Тогда
			СтрокаРезультата.НеверныхНоменклатур = Выборка.НеверныхНоменклатур;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПланКейс1()
	
	Справки = СправкиКейса(1);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Шаг A: каждую ТТН-основание — один раз.
	Для Каждого СтрокаТТН Из ТТНПоСправкам(Справки) Цикл
		ДобавитьВПлан(1, СтрокаТТН.Справка2, "ПерепроведениеДокумента", СтрокаТТН.ТТН,
			"Номенклатура не дозаполнена / ТТН не перепроведена",
			"Дозаполнена и проведена",
			"Аналог «Провести и закрыть» в форме ТТН",
			Новый Структура("Дозаполнить", Истина));
	КонецЦикла;
	
	// Шаг B: подстановка из другой строки той же ТТН.
	ДобавитьПланПодстановкиИзТТН(Справки);
	
	// Шаг C: поиск в документе-основании ТТН.
	ДобавитьПланПоОснованиюТТН(Справки);
	
КонецПроцедуры

Функция ТТНПоСправкам(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Марки.#МаркаОснование# КАК ТТН,
	|	МИНИМУМ(Марки.#МаркаСправка2#) КАК Справка2
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаОснование# ССЫЛКА #ДокументТТН#
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаОснование#"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьПланПодстановкиИзТТН(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пустые.Ссылка КАК ТТН,
	|	Пустые.НомерСтроки КАК НомерСтроки,
	|	Пустые.#ТТНСправка2# КАК Справка2,
	|	Заполненные.#ТТННоменклатура# КАК Номенклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК Пустые
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументТТН#.#ТЧТТН# КАК Заполненные
	|		ПО (Пустые.Ссылка = Заполненные.Ссылка)
	|			И (Пустые.#ТТНАлкопродукция# = Заполненные.#ТТНАлкопродукция#)
	|			И (Заполненные.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка))
	|ГДЕ
	|	Пустые.#ТТНСправка2# В (&Справки)
	|	И Пустые.#ТТННоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	// Только однозначные случаи: для строки ТТН найдена ровно одна номенклатура.
	Счетчик = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = КлючСтрокиТТН(СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки);
		Счетчик.Вставить(Ключ, ?(Счетчик.Получить(Ключ) = Неопределено, 1, Счетчик.Получить(Ключ) + 1));
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Ключ = КлючСтрокиТТН(СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки);
		Количество = Счетчик.Получить(Ключ);
		
		Если Количество > 1 Тогда
			ДобавитьВПлан(1, СтрокаТаблицы.Справка2, "Информация", СтрокаТаблицы.ТТН, "", "",
				СтрШаблон("Строка %1: в ТТН несколько разных номенклатур для этой алкопродукции — выбрать вручную",
					СтрокаТаблицы.НомерСтроки));
			Счетчик.Вставить(Ключ, 0);
			Продолжить;
		ИначеЕсли Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьВПлан(1, СтрокаТаблицы.Справка2, "ЗаполнениеНоменклатуры", СтрокаТаблицы.ТТН,
			СтрШаблон("Строка %1: номенклатура не указана", СтрокаТаблицы.НомерСтроки),
			СтрШаблон("%1", СтрокаТаблицы.Номенклатура),
			"Взято из другой строки этой же ТТН с той же алкопродукцией",
			Новый Структура("ТТН, НомерСтроки, Номенклатура, Заменить",
				СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки, СтрокаТаблицы.Номенклатура, Ложь));
		
	КонецЦикла;
	
КонецПроцедуры

Функция КлючСтрокиТТН(ТТН, НомерСтроки)
	Возврат Строка(ТТН.УникальныйИдентификатор()) + "|" + Формат(НомерСтроки, "ЧГ=0");
КонецФункции

Процедура ПроверитьРазрешениеПроведенияТТН()
	
	Если Не РазрешитьПроведениеТТН Тогда
		ВызватьИсключение "Проведение ТТН запрещено настройкой «Разрешить проведение ТТН». "
			+ "Включите её после проверки, что проведение ТТН ничего не отправляет в ЕГАИС.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ДействиеПерепровестиДокумент(ДокументСсылка, ПараметрыДействия = Неопределено)
	
	Если ДокументСсылка.Метаданные().ПолноеИмя() = ИменаОбъектов().ДокументТТН Тогда
		ПроверитьРазрешениеПроведенияТТН();
	КонецЕсли;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.Заблокировать();
	
	Если ПараметрыДействия <> Неопределено
		И ПараметрыДействия.Свойство("Дозаполнить")
		И ПараметрыДействия.Дозаполнить Тогда
		ДозаполнитьНоменклатуруТТН(ДокументОбъект);
	КонецЕсли;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Параметры: ТТН, НомерСтроки, Номенклатура, Заменить.
Процедура ДействиеЗаполнитьНоменклатуруТТН(П)
	
	ПроверитьРазрешениеПроведенияТТН();
	
	Если Не ЗначениеЗаполнено(П.Номенклатура) Тогда
		ВызватьИсключение "Номенклатура не выбрана.";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	ТТНОбъект = П.ТТН.ПолучитьОбъект();
	ТТНОбъект.Заблокировать();
	
	СтрокаТЧ = ТТНОбъект[Имена.ТЧТТН].Найти(П.НомерСтроки, "НомерСтроки");
	Если СтрокаТЧ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В ТТН %1 нет строки %2.", П.ТТН, П.НомерСтроки);
	КонецЕсли;
	
	ТекущаяНоменклатура = СтрокаТЧ[Имена.ТТННоменклатура];
	
	Если ТекущаяНоменклатура = П.Номенклатура Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяНоменклатура) И Не П.Заменить Тогда
		ВызватьИсключение СтрШаблон("Строка %1 уже заполнена номенклатурой «%2». Проверьте вручную.",
			П.НомерСтроки, ТекущаяНоменклатура);
	КонецЕсли;
	
	СтрокаТЧ[Имена.ТТННоменклатура] = П.Номенклатура;
	ТТНОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// ВАРИАНТ 1 (предпочтительный): подставить вызов типовой процедуры, которую вызывает
// форма ТТН при открытии (ПриСозданииНаСервере / ПриЧтенииНаСервере). УТОЧНИТЬ.
// ВАРИАНТ 2 (ниже): собственное дозаполнение по регистру соответствий.
Процедура ДозаполнитьНоменклатуруТТН(ТТНОбъект)
	
	Имена = ИменаОбъектов();
	ТЧ = ТТНОбъект[Имена.ТЧТТН];
	
	Алкопродукции = Новый Массив;
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТННоменклатура])
			И ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТНАлкопродукция]) Тогда
			Алкопродукции.Добавить(СтрокаТЧ[Имена.ТТНАлкопродукция]);
		КонецЕсли;
	КонецЦикла;
	
	Если Алкопродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Карта = ОднозначныеСоответствия(Алкопродукции);
	
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТННоменклатура]) Тогда
			Номенклатура = Карта.Получить(СтрокаТЧ[Имена.ТТНАлкопродукция]);
			Если Номенклатура <> Неопределено Тогда
				СтрокаТЧ[Имена.ТТННоменклатура] = Номенклатура;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Алкопродукция -> Номенклатура только там, где номенклатура ровно одна.
Функция ОднозначныеСоответствия(Алкопродукции) Экспорт
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция,
	|	МАКСИМУМ(Соотв.#СоответствиеНоменклатура#) КАК Номенклатура
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция# В (&Алкопродукции)
	|
	|СГРУППИРОВАТЬ ПО
	|	Соотв.#СоответствиеАлкопродукция#
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Соотв.#СоответствиеНоменклатура#) = 1"));
	Запрос.УстановитьПараметр("Алкопродукции", Алкопродукции);
	
	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(Выборка.Алкопродукция, Выборка.Номенклатура);
	КонецЦикла;
	Возврат Карта;
	
КонецФункции

#КонецОбласти

#Область Кейс1_ОснованиеТТН

Функция НайтиОснованиеТТН(ТТН) Экспорт
	
	Имена = ИменаОбъектов();
	
	Если Имена.ОснованиеТТН_Способ = "РеквизитТТН" Тогда
		Основание = ТТН[Имена.ТТНРеквизитОснования];
		Если ЗначениеЗаполнено(Основание) И ОписаниеДокументаОснования(Основание) <> Неопределено Тогда
			Возврат Основание;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		
		Если Метаданные.НайтиПоПолномуИмени(Описание.ПолноеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Д.Ссылка КАК Ссылка
			|ИЗ
			|	%1 КАК Д
			|ГДЕ
			|	Д.%2 = &ТТН
			|	И НЕ Д.ПометкаУдаления", Описание.ПолноеИмя, Описание.СсылкаНаТТН));
		Запрос.УстановитьПараметр("ТТН", ТТН);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОписаниеДокументаОснования(Основание)
	
	ПолноеИмя = Основание.Метаданные().ПолноеИмя();
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		Если Описание.ПолноеИмя = ПолноеИмя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьПланПоОснованиюТТН(Справки)
	
	Для Каждого СтрокаТТН Из ПроблемныеСтрокиТТН(Справки) Цикл
		
		Основание = НайтиОснованиеТТН(СтрокаТТН.ТТН);
		Если Основание = Неопределено Тогда
			ДобавитьВПлан(1, СтрокаТТН.Справка2, "Информация", СтрокаТТН.ТТН, "", "",
				СтрШаблон("Строка %1: не найден документ-основание ТТН — нужна ручная проверка", СтрокаТТН.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		Кандидаты = КандидатыИзОснования(Основание, СтрокаТТН);
		
		Если Кандидаты.Количество() = 0 Тогда
			ДобавитьВПлан(1, СтрокаТТН.Справка2, "Информация", СтрокаТТН.ТТН, "", "",
				СтрШаблон("Строка %1: в документе %2 нет подходящей номенклатуры", СтрокаТТН.НомерСтроки, Основание));
			Продолжить;
		КонецЕсли;
		
		Лучший = Кандидаты[0];
		Отрыв = ?(Кандидаты.Количество() > 1, Лучший.Оценка - Кандидаты[1].Оценка, Лучший.Оценка);
		
		Если Лучший.Оценка >= 40 И Отрыв >= 20 Тогда
			Пояснение = СтрШаблон("Рекомендуется: найдено в %1 (оценка %2)", Основание, Лучший.Оценка);
		Иначе
			Пояснение = СтрШаблон("Неоднозначно: лучший кандидат из %1 (оценка %2, вариантов %3). Проверьте или выберите вручную",
				Основание, Лучший.Оценка, Кандидаты.Количество());
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТТН.ТекущаяНоменклатура) Тогда
			Было = СтрШаблон("Строка %1: %2", СтрокаТТН.НомерСтроки, СтрокаТТН.ТекущаяНоменклатура);
		Иначе
			Было = СтрШаблон("Строка %1: номенклатура не указана", СтрокаТТН.НомерСтроки);
		КонецЕсли;
		
		ДобавитьВПлан(1, СтрокаТТН.Справка2, "ЗаполнениеНоменклатуры", СтрокаТТН.ТТН,
			Было, СтрШаблон("%1", Лучший.Номенклатура), Пояснение,
			Новый Структура("ТТН, НомерСтроки, Номенклатура, Заменить",
				СтрокаТТН.ТТН, СтрокаТТН.НомерСтроки, Лучший.Номенклатура,
				ЗначениеЗаполнено(СтрокаТТН.ТекущаяНоменклатура)));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроблемныеСтрокиТТН(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	СтрокиТТН.Ссылка КАК ТТН,
	|	СтрокиТТН.НомерСтроки КАК НомерСтроки,
	|	СтрокиТТН.#ТТНСправка2# КАК Справка2,
	|	СтрокиТТН.#ТТНАлкопродукция# КАК Алкопродукция,
	|	СтрокиТТН.#ТТНАлкопродукция#.Наименование КАК НаименованиеАлкопродукции,
	|	СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияВидПродукции# КАК Вид,
	|	СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияОбъем# КАК Объем,
	|	СтрокиТТН.#ТТНКоличество# КАК Количество,
	|	СтрокиТТН.#ТТННоменклатура# КАК ТекущаяНоменклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И (СтрокиТТН.#ТТННоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|			ИЛИ СтрокиТТН.#ТТННоменклатура#.#НоменклатураВидПродукции# <> СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияВидПродукции#)"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// ТаблицаЗначений кандидатов (Номенклатура, Наименование, Оценка) по убыванию оценки.
// ДанныеСтроки — строка/структура: Алкопродукция, НаименованиеАлкопродукции, Вид, Объем, Количество.
Функция КандидатыИзОснования(Основание, ДанныеСтроки) Экспорт
	
	Описание = ОписаниеДокументаОснования(Основание);
	
	Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.%3 КАК Номенклатура,
	|	Т.%3.Наименование КАК Наименование,
	|	Т.%3.#НоменклатураВидПродукции# КАК Вид,
	|	Т.%3.#НоменклатураОбъем# КАК Объем,
	|	СУММА(Т.%4) КАК Количество
	|ИЗ
	|	%1.%2 КАК Т
	|ГДЕ
	|	Т.Ссылка = &Основание
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.%3,
	|	Т.%3.Наименование,
	|	Т.%3.#НоменклатураВидПродукции#,
	|	Т.%3.#НоменклатураОбъем#",
		Описание.ПолноеИмя, Описание.ТЧ, Описание.Номенклатура, Описание.Количество);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Основание", Основание);
	Строки = Запрос.Выполнить().Выгрузить();
	
	Сопоставленные = НоменклатурыАлкопродукции(ДанныеСтроки.Алкопродукция);
	
	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Номенклатура");
	Кандидаты.Колонки.Добавить("Наименование");
	Кандидаты.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	
	Для Каждого Кандидат Из Строки Цикл
		Оценка = ОценкаКандидата(Кандидат, ДанныеСтроки, Сопоставленные);
		Если Оценка < 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Кандидат);
		НоваяСтрока.Оценка = Оценка;
	КонецЦикла;
	
	Кандидаты.Сортировать("Оценка Убыв");
	Возврат Кандидаты;
	
КонецФункции

Функция ОценкаКандидата(Кандидат, ДанныеСтроки, Сопоставленные)
	
	Если ЗначениеЗаполнено(Кандидат.Вид) И ЗначениеЗаполнено(ДанныеСтроки.Вид) И Кандидат.Вид <> ДанныеСтроки.Вид Тогда
		Возврат -1;
	КонецЕсли;
	Если НастройкаПроверятьОбъем() И ЗначениеЗаполнено(Кандидат.Объем) И Кандидат.Объем <> ДанныеСтроки.Объем Тогда
		Возврат -1;
	КонецЕсли;
	
	Оценка = 0;
	Если Сопоставленные.Получить(Кандидат.Номенклатура) <> Неопределено Тогда
		Оценка = Оценка + 100;
	КонецЕсли;
	Если Кандидат.Количество = ДанныеСтроки.Количество Тогда
		Оценка = Оценка + 30;
	КонецЕсли;
	Оценка = Оценка + Окр(30 * ПохожестьНаименований(Кандидат.Наименование, ДанныеСтроки.НаименованиеАлкопродукции));
	
	Возврат Оценка;
	
КонецФункции

// Номенклатуры, сопоставленные с алкопродукцией: Соответствие Номенклатура -> Истина.
Функция НоменклатурыАлкопродукции(Алкопродукция) Экспорт
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеНоменклатура# КАК Номенклатура
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция# = &Алкопродукция"));
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Истина);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// 0…1: доля общих значимых слов.
Функция ПохожестьНаименований(Знач А, Знач Б) Экспорт
	
	СловаА = ЗначимыеСлова(А);
	СловаБ = ЗначимыеСлова(Б);
	
	Если СловаА.Количество() = 0 Или СловаБ.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Общих = 0;
	Для Каждого Слово Из СловаА Цикл
		Если СловаБ.Найти(Слово) <> Неопределено Тогда
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Общих / Макс(СловаА.Количество(), СловаБ.Количество());
	
КонецФункции

Функция ЗначимыеСлова(Знач Текст)
	
	Текст = НРег(Текст);
	Разделители = """«»'.,;:()-/\";
	Для Н = 1 По СтрДлина(Разделители) Цикл
		Текст = СтрЗаменить(Текст, Сред(Разделители, Н, 1), " ");
	КонецЦикла;
	
	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Если СтрДлина(Слово) >= 3 И Слова.Найти(Слово) = Неопределено Тогда
			Слова.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;
	
КонецФункции

#КонецОбласти

#Область Кейс1_Крепость

Процедура ДобавитьПланПоКрепости()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	СтрокиТТН.#ТТННоменклатура# КАК Номенклатура,
	|	МИНИМУМ(СтрокиТТН.#ТТНСправка2#) КАК Справка2,
	|	МАКСИМУМ(СтрокиТТН.#ТТННоменклатура#.#НоменклатураКрепость#) КАК КрепостьНоменклатуры,
	|	МИНИМУМ(СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#) КАК КрепостьЕГАИСМин,
	|	МАКСИМУМ(СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#) КАК КрепостьЕГАИСМакс
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И СтрокиТТН.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|	И СтрокиТТН.#ТТННоменклатура#.#НоменклатураКрепость# <> СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиТТН.#ТТННоменклатура#"));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КрепостьЕГАИСМин <> Выборка.КрепостьЕГАИСМакс Тогда
			ДобавитьВПлан(1, Выборка.Справка2, "Информация", Выборка.Номенклатура, "", "",
				СтрШаблон("Номенклатура сопоставлена с продукцией разной крепости (%1–%2%%). Нужна отдельная номенклатура",
					Выборка.КрепостьЕГАИСМин, Выборка.КрепостьЕГАИСМакс));
			Продолжить;
		КонецЕсли;
		
		ДобавитьВПлан(1, Выборка.Справка2, "ИзменениеКрепости", Выборка.Номенклатура,
			СтрШаблон("Крепость %1%%", Выборка.КрепостьНоменклатуры),
			СтрШаблон("Крепость %1%%", Выборка.КрепостьЕГАИСМин),
			"Крепость номенклатуры не совпадает с алкопродукцией ЕГАИС",
			Новый Структура("Номенклатура, СтараяКрепость, НоваяКрепость",
				Выборка.Номенклатура, Выборка.КрепостьНоменклатуры, Выборка.КрепостьЕГАИСМин));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДействиеИзменитьКрепость(П)
	
	Если Не РазрешитьИзменениеНоменклатуры Тогда
		ВызватьИсключение "Изменение номенклатуры запрещено настройкой «Разрешить изменение номенклатуры».";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	НоменклатураОбъект = П.Номенклатура.ПолучитьОбъект();
	НоменклатураОбъект.Заблокировать();
	
	// Если НоменклатураКрепость — путь через точку, доработать под конфигурацию. УТОЧНИТЬ.
	Если НоменклатураОбъект[Имена.НоменклатураКрепость] <> П.СтараяКрепость Тогда
		ВызватьИсключение "Крепость уже изменилась с момента формирования плана. Сформируйте план заново.";
	КонецЕсли;
	
	НоменклатураОбъект[Имена.НоменклатураКрепость] = П.НоваяКрепость;
	НоменклатураОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область Кейс2_СтатусыМарок

Процедура ЗаполнитьСверкуМарок() Экспорт
	
	СверкаМарок.Очистить();
	
	Справки = СправкиКейса(2);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	ПроверятьЧеки = ЗначениеЗаполнено(Имена.ТаблицаМарокЧеков);
	
	Текст =
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки,
	|	Марки.#МаркаСтатус# КАК Статус,
	|	&ПолеЕстьЧек КАК ЕстьЧек
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|	&СоединениеЧеки
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)";
	
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Если ПроверятьЧеки Тогда
		Текст = СтрЗаменить(Текст, "&ПолеЕстьЧек", "НЕ Чеки.Код ЕСТЬ NULL");
		Текст = СтрЗаменить(Текст, "&СоединениеЧеки",
		"		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ЧМ.#ЧекМаркаКод# КАК Код
		|		ИЗ
		|			#ТаблицаМарокЧеков# КАК ЧМ
		|		ГДЕ
		|			ЧМ.Ссылка.Проведен) КАК Чеки
		|		ПО (Чеки.Код = Марки.#МаркаКод#)");
	Иначе
		Текст = СтрЗаменить(Текст, "&ПолеЕстьЧек", "ЛОЖЬ");
		Текст = СтрЗаменить(Текст, "&СоединениеЧеки", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаСверки = СверкаМарок.Добавить();
		СтрокаСверки.Справка2 = Выборка.Справка2;
		СтрокаСверки.Марка = Выборка.Марка;
		СтрокаСверки.КодМарки = Выборка.КодМарки;
		СтрокаСверки.СтатусВ1С = ЛогическийСтатус(Выборка.Статус);
		СтрокаСверки.ЕстьЧек = Выборка.ЕстьЧек;
		
		Если ПроверятьЧеки И СтрокаСверки.СтатусВ1С = "Реализована" И Не СтрокаСверки.ЕстьЧек Тогда
			СтрокаСверки.Подсказка = "Статус «Реализована», но проведённого чека с маркой нет";
		ИначеЕсли СтрокаСверки.СтатусВ1С = "ВРезерве" Тогда
			СтрокаСверки.Подсказка = "«В резерве» — всегда сверять с ЕГАИС";
		ИначеЕсли СтрокаСверки.СтатусВ1С = "" Тогда
			СтрокаСверки.Подсказка = "Неизвестный статус — добавить в СоответствиеСтатусов()";
		КонецЕсли;
		
	КонецЦикла;
	
	СверкаМарок.Сортировать("Подсказка Убыв, КодМарки");
	
КонецПроцедуры

Процедура ПроверитьСверкуПоУТМ() Экспорт
	
	Для Каждого СтрокаСверки Из СверкаМарок Цикл
		
		Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОшибки = "";
		Состояние = ЗапросСостоянияМаркиУТМ(СтрокаСверки.КодМарки, ТекстОшибки);
		
		Если ЗначениеЗаполнено(Состояние) Тогда
			СтрокаСверки.СостояниеЕГАИС = Состояние;
			СтрокаСверки.Источник = "Кеш УТМ";
		Иначе
			СтрокаСверки.Подсказка = Лев("УТМ: " + ТекстОшибки, 200);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// "НаБалансе", "Списана" или "" (с текстом ошибки).
// В безопасном режиме HTTP может быть запрещён.
Функция ЗапросСостоянияМаркиУТМ(КодМарки, ТекстОшибки)
	
	Настройки = НастройкиУТМ();
	
	Если Не ЗначениеЗаполнено(Настройки.ПутьПроверкиМарки) Тогда
		ТекстОшибки = "не задан путь проверки марки (НастройкиУТМ, УТОЧНИТЬ)";
		Возврат "";
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(Настройки.Адрес, Настройки.Порт, , , , Настройки.Таймаут);
		Адрес = СтрЗаменить(Настройки.ПутьПроверкиМарки, "{mark}",
			КодироватьСтроку(КодМарки, СпособКодированияСтроки.КодировкаURL));
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Адрес));
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = "HTTP " + Ответ.КодСостояния;
		Возврат "";
	КонецЕсли;
	
	Возврат РазобратьОтветПроверкиМарки(Ответ.ПолучитьТелоКакСтроку(), ТекстОшибки);
	
КонецФункции

// УТОЧНИТЬ: формат ответа УТМ 4 (из кода «Помощника ЕГАИС» / документации УТМ).
Функция РазобратьОтветПроверкиМарки(ТелоОтвета, ТекстОшибки)
	
	ТекстОшибки = "разбор ответа УТМ не реализован (УТОЧНИТЬ формат)";
	Возврат "";
	
КонецФункции

Процедура ЗаполнитьСверкуИзОтветаРегистра3() Экспорт
	
	Таблица = СверкаМарок.Выгрузить(, "Справка2");
	Таблица.Свернуть("Справка2");
	
	Для Каждого Справка2 Из Таблица.ВыгрузитьКолонку("Справка2") Цикл
		
		КодыНаБалансе = КодыМарокИзОтветаРегистра3(Справка2);
		Если КодыНаБалансе = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаСверки Из СверкаМарок.НайтиСтроки(Новый Структура("Справка2", Справка2)) Цикл
			Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаСверки.СостояниеЕГАИС = ?(КодыНаБалансе.Найти(СтрокаСверки.КодМарки) <> Неопределено, "НаБалансе", "Списана");
			СтрокаСверки.Источник = "Регистр 3";
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// УТОЧНИТЬ: где хранится ответ ЕГАИС по регистру 3. Нет ответа — Неопределено, иначе массив кодов.
Функция КодыМарокИзОтветаРегистра3(Справка2)
	Возврат Неопределено;
КонецФункции

Процедура СформироватьПланКейс2()
	
	Если СправкиКейса(2).Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СверкаМарок.Количество() = 0 Тогда
		ЗаполнитьСверкуМарок();
		Возврат; // сначала получить состояния ЕГАИС на странице «Сверка марок»
	КонецЕсли;
	
	Матрица = МатрицаСтатусов();
	ЕстьПроверкаЧеков = ЗначениеЗаполнено(ИменаОбъектов().ТаблицаМарокЧеков);
	
	Для Каждого СтрокаСверки Из СверкаМарок Цикл
		
		Если СтрокаСверки.СостояниеЕГАИС = "Чужая" Тогда
			ДобавитьВПлан(2, СтрокаСверки.Справка2, "Информация", СтрокаСверки.Марка, СтрокаСверки.КодМарки, "",
				"Марка числится у другой организации — ручной разбор, автоматически не меняем");
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
			
			Правила = Матрица.НайтиСтроки(Новый Структура("СостояниеЕГАИС, СтатусВ1С",
				СтрокаСверки.СостояниеЕГАИС, СтрокаСверки.СтатусВ1С));
			Если Правила.Количество() = 0 Или Не ЗначениеЗаполнено(Правила[0].НовыйСтатус) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьПланСменыСтатуса(СтрокаСверки, Правила[0].НовыйСтатус,
				СтрШаблон("ЕГАИС: %1 (%2)", СтрокаСверки.СостояниеЕГАИС, СтрокаСверки.Источник), Истина);
			
		ИначеЕсли ЕстьПроверкаЧеков И СтрокаСверки.СтатусВ1С = "Реализована" И Не СтрокаСверки.ЕстьЧек Тогда
			
			ДобавитьПланСменыСтатуса(СтрокаСверки, "ВНаличии",
				"Нет чека с маркой (без подтверждения ЕГАИС) — лучше сначала проверить", Ложь);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПланСменыСтатуса(СтрокаСверки, НовыйСтатус, Основание, Отметить)
	
	ДобавитьВПлан(2, СтрокаСверки.Справка2, "СменаСтатуса", СтрокаСверки.Марка,
		СтрШаблон("%1: %2", СтрокаСверки.КодМарки, СтрокаСверки.СтатусВ1С),
		НовыйСтатус, Основание,
		Новый Структура("Марка, КодМарки, СтарыйСтатус, НовыйСтатус",
			СтрокаСверки.Марка, СтрокаСверки.КодМарки, СтрокаСверки.СтатусВ1С, НовыйСтатус));
	
	ПланИзменений[ПланИзменений.Количество() - 1].Подтверждено = Отметить;
	
КонецПроцедуры

// Параметры: Марка, КодМарки, СтарыйСтатус, НовыйСтатус (логические).
Процедура ДействиеСменитьСтатус(П)
	
	Если Не РазрешитьСменуСтатусов Тогда
		ВызватьИсключение "Смена статусов запрещена настройкой «Разрешить смену статусов» "
			+ "(сначала выяснить, не перетрётся ли статус при перепроведении документов).";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	НовоеЗначение = ЗначениеСтатуса(П.НовыйСтатус);
	
	Если МаркиВСправочнике() Тогда
		
		МаркаОбъект = П.Марка.ПолучитьОбъект();
		МаркаОбъект.Заблокировать();
		ПроверитьСтарыйСтатус(МаркаОбъект[Имена.МаркаСтатус], П);
		МаркаОбъект[Имена.МаркаСтатус] = НовоеЗначение;
		МаркаОбъект.Записать();
		
	Иначе
		
		// Регистр сведений: отбор по коду марки. УТОЧНИТЬ состав измерений.
		ИмяРегистра = СтрЗаменить(Имена.ТаблицаМарок, "РегистрСведений.", "");
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор[Имена.МаркаКод].Установить(П.КодМарки);
		Набор.Прочитать();
		
		Если Набор.Количество() <> 1 Тогда
			ВызватьИсключение СтрШаблон("Для марки %1 найдено записей: %2 (ожидалась 1).", П.КодМарки, Набор.Количество());
		КонецЕсли;
		
		ПроверитьСтарыйСтатус(Набор[0][Имена.МаркаСтатус], П);
		Набор[0][Имена.МаркаСтатус] = НовоеЗначение;
		Набор.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтарыйСтатус(ТекущееЗначение, П)
	
	Если ЛогическийСтатус(ТекущееЗначение) <> П.СтарыйСтатус Тогда
		ВызватьИсключение "Статус марки изменился с момента формирования плана. Сформируйте план заново.";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Кейс3_СоответствиеНоменклатуры

// Кейс 3: у алкопродукции нет ни одного соответствия номенклатуры.
// Правила по ответам заказчика (21.09):
// — соответствие общее: алкопродукция → номенклатура, справка 2 не участвует;
// — номенклатуру только выбираем из существующих, новую не создаём;
// — одна алкопродукция может иметь несколько номенклатур — это допустимо;
// — источник номенклатуры у специалиста — акцизная марка (у марки есть номенклатура);
// — создавать соответствия могут только администраторы;
// — подтверждений нет: однозначные случаи применяются автоматически,
//   неоднозначные уходят в «Требует ручного решения».

Процедура СформироватьПланКейс3()
	
	Справки = СправкиКейса(3);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаАП Из НесопоставленныеАлкопродукции(Справки) Цикл
		
		Решение = РешениеПоКандидатам(КандидатыДляСоответствия(СтрокаАП));
		ПараметрыДействия = Новый Структура("Алкопродукция, Номенклатура, Справки",
			СтрокаАП.Алкопродукция, Решение.Номенклатура, Справки);
		
		Если Решение.Надежно Тогда
			ДобавитьВПлан(3, СтрокаАП.Справка2, "СозданиеСоответствия", СтрокаАП.Алкопродукция,
				"Соответствия нет", СтрШаблон("%1", Решение.Номенклатура),
				СтрШаблон("Автоматически: %1 (оценка %2)", Решение.Источник, Решение.Оценка),
				ПараметрыДействия);
			ПланИзменений[ПланИзменений.Количество() - 1].Подтверждено = Истина;
		Иначе
			// Не отмечаем. Администратор может выбрать номенклатуру кнопкой «Выбрать номенклатуру».
			ДобавитьВПлан(3, СтрокаАП.Справка2, "СозданиеСоответствия", СтрокаАП.Алкопродукция,
				"Соответствия нет", "Требует ручного решения", Решение.Пояснение,
				ПараметрыДействия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НесопоставленныеАлкопродукции(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция
	|ПОМЕСТИТЬ ВТСопоставленные
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Марки.#МаркаАлкопродукция# КАК Алкопродукция,
	|	Марки.#МаркаАлкопродукция#.Наименование КАК НаименованиеАлкопродукции,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции# КАК Вид,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем# КАК Объем,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияКрепость# КАК Крепость,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияПроизводитель# КАК Производитель,
	|	МИНИМУМ(Марки.#МаркаСправка2#) КАК Справка2
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСопоставленные КАК Сопоставленные
	|		ПО (Сопоставленные.Алкопродукция = Марки.#МаркаАлкопродукция#)
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|	И Сопоставленные.Алкопродукция ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаАлкопродукция#,
	|	Марки.#МаркаАлкопродукция#.Наименование,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияКрепость#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияПроизводитель#"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// ТаблицаЗначений: Номенклатура, Оценка, Источник — по убыванию оценки, без дублей.
Функция КандидатыДляСоответствия(СтрокаАП)
	
	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Номенклатура");
	Кандидаты.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	
	// 1. Номенклатура в акцизных марках этой алкопродукции — так делает специалист.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Марки.#МаркаНоменклатура# КАК Номенклатура,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК Марок
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаНоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаНоменклатура#"));
	Запрос.УстановитьПараметр("Алкопродукция", СтрокаАП.Алкопродукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 90,
			СтрШаблон("номенклатура в акцизных марках (%1 шт.)", Выборка.Марок));
	КонецЦикла;
	
	// 2. Строки ТТН с этой алкопродукцией и заполненной номенклатурой.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиТТН.#ТТННоменклатура# КАК Номенклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНАлкопродукция# = &Алкопродукция
	|	И СтрокиТТН.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)"));
	Запрос.УстановитьПараметр("Алкопродукция", СтрокаАП.Алкопродукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 80, "строка ТТН с этой алкопродукцией");
	КонецЦикла;
	
	// 3. «Родственная» алкопродукция (вид, объём, крепость, производитель) с похожим наименованием.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеНоменклатура# КАК Номенклатура,
	|	Соотв.#СоответствиеАлкопродукция#.Наименование КАК Наименование
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияВидПродукции# = &Вид
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияОбъем# = &Объем
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияКрепость# = &Крепость
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияПроизводитель# = &Производитель"));
	Запрос.УстановитьПараметр("Вид", СтрокаАП.Вид);
	Запрос.УстановитьПараметр("Объем", СтрокаАП.Объем);
	Запрос.УстановитьПараметр("Крепость", СтрокаАП.Крепость);
	Запрос.УстановитьПараметр("Производитель", СтрокаАП.Производитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПохожестьНаименований(Выборка.Наименование, СтрокаАП.НаименованиеАлкопродукции) >= 0.6 Тогда
			ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 60, "родственная алкопродукция");
		КонецЕсли;
	КонецЦикла;
	
	// 4. Поиск по наименованию в справочнике номенклатуры.
	ДобавитьКандидатовПоНаименованию(Кандидаты, СтрокаАП);
	
	ОтфильтроватьКандидатовПоВиду(Кандидаты, СтрокаАП);
	Кандидаты.Сортировать("Оценка Убыв");
	
	Возврат Кандидаты;
	
КонецФункции

// Надёжно: лучший кандидат ≥ 60 баллов и отрыв от второго ≥ 20.
Функция РешениеПоКандидатам(Кандидаты)
	
	Решение = Новый Структура("Надежно, Номенклатура, Оценка, Источник, Пояснение", Ложь, Неопределено, 0, "", "");
	
	Если Кандидаты.Количество() = 0 Тогда
		Решение.Пояснение = "Подходящей номенклатуры не найдено — выбрать вручную (новую номенклатуру создают на сервере)";
		Возврат Решение;
	КонецЕсли;
	
	Лучший = Кандидаты[0];
	Отрыв = ?(Кандидаты.Количество() > 1, Лучший.Оценка - Кандидаты[1].Оценка, Лучший.Оценка);
	
	Решение.Номенклатура = Лучший.Номенклатура;
	Решение.Оценка = Лучший.Оценка;
	Решение.Источник = Лучший.Источник;
	Решение.Надежно = Лучший.Оценка >= 60 И Отрыв >= 20;
	
	Если Не Решение.Надежно Тогда
		Варианты = Новый Массив;
		Для Индекс = 0 По Мин(2, Кандидаты.Количество() - 1) Цикл
			Варианты.Добавить(СтрШаблон("%1 (%2, %3)", Кандидаты[Индекс].Номенклатура,
				Кандидаты[Индекс].Оценка, Кандидаты[Индекс].Источник));
		КонецЦикла;
		Решение.Номенклатура = Неопределено; // не угадываем
		Решение.Пояснение = "Неоднозначно, варианты: " + СтрСоединить(Варианты, "; ");
	КонецЕсли;
	
	Возврат Решение;
	
КонецФункции

Процедура ДобавитьКандидата(Кандидаты, Номенклатура, Оценка, Источник)
	
	Существующий = Кандидаты.Найти(Номенклатура, "Номенклатура");
	Если Существующий = Неопределено Тогда
		НовыйКандидат = Кандидаты.Добавить();
		НовыйКандидат.Номенклатура = Номенклатура;
		НовыйКандидат.Оценка = Оценка;
		НовыйКандидат.Источник = Источник;
	ИначеЕсли Оценка > Существующий.Оценка Тогда
		Существующий.Оценка = Оценка;
		Существующий.Источник = Источник;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКандидатовПоНаименованию(Кандидаты, СтрокаАП)
	
	Ключ = "";
	Для Каждого Слово Из ЗначимыеСлова(СтрокаАП.НаименованиеАлкопродукции) Цикл
		Если СтрДлина(Слово) > СтрДлина(Ключ) Тогда
			Ключ = Слово;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Наименование КАК Наименование
	|ИЗ
	|	#ТаблицаНоменклатуры# КАК Н
	|ГДЕ
	|	Н.Наименование ПОДОБНО &Шаблон
	|	И НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа")); // УТОЧНИТЬ: убрать условие, если справочник без групп
	Запрос.УстановитьПараметр("Шаблон", "%" + Ключ + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Оценка = Окр(40 * ПохожестьНаименований(Выборка.Наименование, СтрокаАП.НаименованиеАлкопродукции));
		Если Оценка > 0 Тогда
			ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, Оценка, "поиск по наименованию");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтфильтроватьКандидатовПоВиду(Кандидаты, СтрокаАП)
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н.#НоменклатураВидПродукции# КАК Вид,
	|	Н.#НоменклатураОбъем# КАК Объем
	|ИЗ
	|	#ТаблицаНоменклатуры# КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Номенклатуры)"));
	Запрос.УстановитьПараметр("Номенклатуры", Кандидаты.ВыгрузитьКолонку("Номенклатура"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Отбросить = ЗначениеЗаполнено(Выборка.Вид) И ЗначениеЗаполнено(СтрокаАП.Вид) И Выборка.Вид <> СтрокаАП.Вид;
		Если Не Отбросить И НастройкаПроверятьОбъем() Тогда
			Отбросить = ЗначениеЗаполнено(Выборка.Объем) И Выборка.Объем <> СтрокаАП.Объем;
		КонецЕсли;
		
		Если Отбросить Тогда
			Кандидаты.Удалить(Кандидаты.Найти(Выборка.Номенклатура, "Номенклатура"));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры: Алкопродукция, Номенклатура, Справки (массив справок кейса 3 акта).
Процедура ДействиеСоздатьСоответствие(П)
	
	Если Не ЭтоАдминистратор() Тогда
		ВызватьИсключение "Создавать соответствия номенклатуры могут только администраторы.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(П.Номенклатура) Тогда
		ВызватьИсключение "Номенклатура не выбрана — требуется ручное решение (кнопка «Выбрать номенклатуру»).";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	
	// 1. Соответствие (общее, без справки 2). Другие номенклатуры у этой АП не мешают.
	Если НоменклатурыАлкопродукции(П.Алкопродукция).Получить(П.Номенклатура) = Неопределено Тогда
		ИмяРегистра = СтрЗаменить(Имена.РегистрСоответствий, "РегистрСведений.", "");
		Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		Запись[Имена.СоответствиеАлкопродукция] = П.Алкопродукция;
		Запись[Имена.СоответствиеНоменклатура] = П.Номенклатура;
		// УТОЧНИТЬ: другие обязательные измерения регистра (характеристика, упаковка).
		Запись.Записать(Истина);
	КонецЕсли;
	
	// 2. Номенклатура в марках этой АП, где она пустая.
	ЗаполнитьНоменклатуруМарок(П.Алкопродукция, П.Номенклатура, П.Справки);
	
	// 3. При необходимости — перепровести ТТН с дозаполнением.
	Если НастройкаПослеСоответствия() = "ЗаполнитьМаркиИПерепровестиТТН" Тогда
		Для Каждого ТТН Из ТТНПоСправкамИАлкопродукции(П.Справки, П.Алкопродукция) Цикл
			ДействиеПерепровестиДокумент(ТТН, Новый Структура("Дозаполнить", Истина));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет номенклатуру в марках справок акта, где она пустая.
// Непустую чужую номенклатуру не трогаем — это кейс 1 (неверная номенклатура).
Процедура ЗаполнитьНоменклатуруМарок(Алкопродукция, Номенклатура, Справки)
	
	Имена = ИменаОбъектов();
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	
	Текст =
	"ВЫБРАТЬ
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаНоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)";
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если МаркиВСправочнике() Тогда
			МаркаОбъект = Выборка.Марка.ПолучитьОбъект();
			МаркаОбъект.Заблокировать();
			МаркаОбъект[Имена.МаркаНоменклатура] = Номенклатура;
			МаркаОбъект.Записать();
		Иначе
			ИмяРегистра = СтрЗаменить(Имена.ТаблицаМарок, "РегистрСведений.", "");
			Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Набор.Отбор[Имена.МаркаКод].Установить(Выборка.КодМарки);
			Набор.Прочитать();
			Для Каждого ЗаписьНабора Из Набор Цикл
				ЗаписьНабора[Имена.МаркаНоменклатура] = Номенклатура;
			КонецЦикла;
			Набор.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// ТТН ищем по справке 2 в строках ТТН, а не по основанию марки:
// основание марки меняется (ТТН → чек → акт списания).
Функция ТТНПоСправкамИАлкопродукции(Справки, Алкопродукция)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиТТН.Ссылка КАК ТТН
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И СтрокиТТН.#ТТНАлкопродукция# = &Алкопродукция"));
	Запрос.УстановитьПараметр("Справки", Справки);
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТТН");
	
КонецФункции

// "ЗаполнитьМарки" — только соответствие и номенклатура в марках (по умолчанию);
// "ЗаполнитьМаркиИПерепровестиТТН" — дополнительно перепровести ТТН с дозаполнением.
// УТОЧНИТЬ на копии базы, чего достаточно, чтобы марки перестали быть красными в акте.
Функция НастройкаПослеСоответствия() Экспорт
	Возврат "ЗаполнитьМарки";
КонецФункции

// Администратор: роль полных прав. УТОЧНИТЬ имена ролей в конфигурации.
Функция ЭтоАдминистратор() Экспорт
	
	Для Каждого ИмяРоли Из СтрРазделить("ПолныеПрава,АдминистраторСистемы", ",") Цикл
		Если Метаданные.Роли.Найти(ИмяРоли) <> Неопределено И РольДоступна(ИмяРоли) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

#КонецОбласти


#Область Кейс4_НетМарок

Процедура СформироватьПланКейс4()
	
	Справки = СправкиКейса(4);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьПланПерепривязки(Справки);
	
	Для Каждого Справка2 Из Справки Цикл
		Если ОчередьЗапросов.НайтиСтроки(Новый Структура("Справка2", Справка2)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьВПлан(4, Справка2, "ЗапросМарок", Справка2, "Марок нет", "В очереди запросов",
			"Точечный запрос марок по справке 2 (регистр 3)",
			Новый Структура("Справка2, Кейс", Справка2, 4));
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПланПерепривязки(Справки)
	
	Имена = ИменаОбъектов();
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	
	Текст =
	"ВЫБРАТЬ
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки,
	|	Марки.#МаркаСправка2# КАК СтараяСправка
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаСтатус# = &СтатусВНаличии
	|	И НЕ Марки.#МаркаСправка2# В (&СправкиАкта)";
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("СтатусВНаличии", ЗначениеСтатуса("ВНаличии"));
	Запрос.УстановитьПараметр("СправкиАкта", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Для Каждого Справка2 Из Справки Цикл
		
		Алкопродукция = Справка2[Имена.Справка2Алкопродукция];
		Если Не ЗначениеЗаполнено(Алкопродукция) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = Результаты.Найти(Справка2, "Справка2");
		Нужно = ?(СтрокаРезультата = Неопределено, 0, СтрокаРезультата.ТребуетсяМарок);
		
		Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Добавлено = 0;
		Пока Добавлено < Нужно И Выборка.Следующий() Цикл
			ДобавитьВПлан(4, Справка2, "ПерепривязкаМарки", Выборка.Марка,
				СтрШаблон("%1: справка %2", Выборка.КодМарки, Выборка.СтараяСправка),
				СтрШаблон("справка %1", Справка2),
				"Гипотеза: марка на старой справке после обнуления точки — ПРОВЕРИТЬ перед применением",
				Новый Структура("Марка, КодМарки, СтараяСправка, НоваяСправка",
					Выборка.Марка, Выборка.КодМарки, Выборка.СтараяСправка, Справка2));
			Добавлено = Добавлено + 1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДействиеПерепривязатьМарку(П)
	
	Если Не РазрешитьПерепривязку Тогда
		ВызватьИсключение "Перепривязка марок запрещена настройкой «Разрешить перепривязку» (сначала проверить гипотезу на реальном примере).";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	
	Если МаркиВСправочнике() Тогда
		МаркаОбъект = П.Марка.ПолучитьОбъект();
		МаркаОбъект.Заблокировать();
		Если МаркаОбъект[Имена.МаркаСправка2] <> П.СтараяСправка Тогда
			ВызватьИсключение "Справка марки изменилась с момента формирования плана.";
		КонецЕсли;
		МаркаОбъект[Имена.МаркаСправка2] = П.НоваяСправка;
		МаркаОбъект.Записать();
	Иначе
		ВызватьИсключение "Перепривязка для марок в регистре сведений не реализована (УТОЧНИТЬ структуру).";
	КонецЕсли;
	
КонецПроцедуры

Процедура ДействиеПоставитьВОчередь(П)
	
	Если ОчередьЗапросов.НайтиСтроки(Новый Структура("Справка2", П.Справка2)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОчереди = ОчередьЗапросов.Добавить();
	СтрокаОчереди.Справка2 = П.Справка2;
	СтрокаОчереди.Кейс = П.Кейс;
	СтрокаОчереди.Приоритет = ?(Результаты.Найти(П.Справка2, "Справка2") <> Неопределено, 1, 10);
	СтрокаОчереди.Статус = "Ожидает";
	
	СохранитьОчередь();
	
КонецПроцедуры

// Вызывается обработчиком ожидания формы.
Процедура ОбработатьОчередь() Экспорт
	
	Настройки = НастройкиОчереди();
	Сейчас = ТекущаяДатаСеанса();
	
	// 1. Проверка отправленных.
	Для Каждого СтрокаОчереди Из ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Отправлен")) Цикл
		
		Количество = КоличествоМарокПоСправке(СтрокаОчереди.Справка2);
		
		Если Количество > 0 Тогда
			СтрокаОчереди.Статус = "Получен";
			СтрокаОчереди.ДатаОтвета = Сейчас;
			СтрокаОчереди.МарокПолучено = Количество;
			
		ИначеЕсли Сейчас - СтрокаОчереди.ДатаОтправки > Настройки.ТаймаутЧасов * 3600 Тогда
			Если СтрокаОчереди.Попыток < Настройки.МаксПопыток Тогда
				СтрокаОчереди.Статус = "Ожидает";
				СтрокаОчереди.Комментарий = "Нет ответа, повтор";
			Иначе
				СтрокаОчереди.Статус = "НетОтвета";
				СтрокаОчереди.Комментарий = "Марок нет и в ЕГАИС / нет ответа — ручное решение по регламенту";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// 2. Отправка следующей, если прошёл интервал.
	ПоследняяОтправка = '00010101';
	Для Каждого СтрокаОчереди Из ОчередьЗапросов Цикл
		ПоследняяОтправка = Макс(ПоследняяОтправка, СтрокаОчереди.ДатаОтправки);
	КонецЦикла;
	
	Если Сейчас - ПоследняяОтправка >= Настройки.ИнтервалОтправкиМин * 60 Тогда
		
		Ожидающие = ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Ожидает"));
		Если Ожидающие.Количество() > 0 Тогда
			
			Следующая = Ожидающие[0];
			Для Каждого Кандидат Из Ожидающие Цикл
				Если Кандидат.Приоритет < Следующая.Приоритет Тогда
					Следующая = Кандидат;
				КонецЕсли;
			КонецЦикла;
			
			Попытка
				ОтправитьЗапросМарок(Следующая.Справка2);
				Следующая.Статус = "Отправлен";
				Следующая.ДатаОтправки = Сейчас;
				Следующая.Попыток = Следующая.Попыток + 1;
			Исключение
				Следующая.Комментарий = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 200);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьОписанияКейса4();
	СохранитьОчередь();
	
КонецПроцедуры

Функция КоличествоМарокПоСправке(Справка2)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК Количество
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# = &Справка2"));
	Запрос.УстановитьПараметр("Справка2", Справка2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);
	
КонецФункции

