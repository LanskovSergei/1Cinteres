// =============================================================================
// Внешняя обработка «Помощник акта списания ЕГАИС» — МОДУЛЬ ОБЪЕКТА
// Версия 0.1.21 (MVP, черновик): кандидат по количеству без отдельной колонки сверки
//
// Сводный код из документов 00–06. Не проверен на реальной базе.
// Все имена объектов конфигурации — в области «АдаптерМетаданных».
// Места, требующие сверки с конфигурацией, помечены // УТОЧНИТЬ.
// =============================================================================

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем КэшОстатков;       // Соответствие: Справка2 -> Структура("Коды, Дата"); живёт в пределах одного серверного вызова
Перем КэшКоличеств;      // Соответствие: Справка2 -> Структура("Количество, Дата") из остатков регистра №1
Перем ТТНКПерепроведению; // Соответствие: ТТН -> Истина; заполняется действиями, проводится один раз в конце ПрименитьПлан
Перем ТекстПоясненияЗагрузки; // почему файл инвентаризации дал 0 кодов
Перем КэшИмен;           // Структура адаптера: собирается один раз на серверный вызов
Перем КэшТекстовЗапросов;// Соответствие: исходный текст запроса -> текст с подставленными именами
Перем КэшСтатусов;       // Соответствие: логический статус -> значение перечисления
Перем КэшЛогическихСтатусов; // Соответствие: значение перечисления -> логический статус
Перем КэшМатрицыСтатусов;// Соответствие: "СостояниеЕГАИС|СтатусВ1С" -> новый статус

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Версия() Экспорт
	Возврат "0.1.21";
КонецФункции

// Заполняет табличную часть Результаты по выбранному акту.
Процедура ВыполнитьДиагностику() Экспорт
	
	СброситьКэшиМетаданных();
	Результаты.Очистить();
	СверкаМарок.Очистить(); // статусы могли измениться — сверку строим заново
	КэшОстатков = Неопределено;
	
	Если Не ЗначениеЗаполнено(Акт) Тогда
		ВызватьИсключение "Не выбран акт списания ЕГАИС.";
	КонецЕсли;
	
	// Без этого статуса вся диагностика считает «в наличии» нулём и помечает все справки проблемными.
	Если ЗначениеСтатуса("ВНаличии") = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"В перечислении %1 не найдено значение статуса «В наличии» (ожидалось «%2»). "
			+ "Поправьте СоответствиеСтатусов() и ИменаОбъектов(), иначе диагностика будет неверной.",
			ИменаОбъектов().ПеречислениеСтатусов, СоответствиеСтатусов().ВНаличии);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаДиагностики());
	Запрос.УстановитьПараметр("Акт", Акт);
	Запрос.УстановитьПараметр("СтатусВНаличии", ЗначениеСтатуса("ВНаличии"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результаты.Добавить(), Выборка);
	КонецЦикла;
	
	ПроверитьУникальностьСправок();
	ДополнитьДиагностикуБитыеСсылки();
	ДополнитьДиагностикуКейс1();
	ДополнитьДиагностикуКейс2();
	
	Для Каждого СтрокаРезультата Из Результаты Цикл
		Классифицировать(СтрокаРезультата);
	КонецЦикла;
	
	ОбновитьОписанияКейса4();
	
КонецПроцедуры

// Формирует ПланИзменений по результатам диагностики.
Процедура СформироватьПлан() Экспорт
	
	ПланИзменений.Очистить();
	
	// Сначала сверяем диагностику с текущей 1С: закрытое в базе уходит из проблемных.
	ОбновитьПроблемныеПоДанным1С();
	
	СформироватьПланКейс1();   // кейс 1, части 1 и 2
	СформироватьПланКейс2();   // кейс 2
	СформироватьПланКейс3();   // кейс 3
	СформироватьПланКейс4();   // кейс 4
	ДобавитьПланПоКрепости();  // крепость, по всем справкам акта
	ДобавитьПланБитыхСсылок(); // «Объект не найден» — только отчёт
	СформироватьПланАкта();    // заполнение акта
	ДополнитьСверкуКейсов134(); // вкладка «Сверка» для кейсов 1, 3 и 4
	
КонецПроцедуры

// Применяет подтверждённые строки плана, каждую в своей транзакции.
Процедура ПрименитьПлан() Экспорт
	
	Выполнено = 0;
	ТТНКПерепроведению = Новый Соответствие;
	
	Для Каждого СтрокаПлана Из ПланИзменений Цикл
		
		Если Не СтрокаПлана.Подтверждено Или СтрокаПлана.Выполнено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выполнено >= ЛимитПакета Тогда
			Прервать;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			ВыполнитьДействие(СтрокаПлана);
			ЗафиксироватьТранзакцию();
			СтрокаПлана.Выполнено = Истина;
			СтрокаПлана.Результат = "OK";
			Выполнено = Выполнено + 1;
			ЗапомнитьИсправленнуюСправку(СтрокаПлана);
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			СтрокаПлана.Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		ЗаписатьВЖурнал(СтрокаПлана);
		
	КонецЦикла;
	
	ПерепровестиИзмененныеТТН();
	
КонецПроцедуры

// Действия только записывают ТТН, а проводится она один раз в конце:
// иначе документ перепроводится столько раз, сколько строк плана по нему отмечено.
Процедура ПерепровестиИзмененныеТТН()
	
	Если ТТНКПерепроведению = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ТТНКПерепроведению Цикл
		
		ТТН = КлючЗначение.Ключ;
		
		НачатьТранзакцию();
		Попытка
			ПровестиТТН(ТТН);
			ЗафиксироватьТранзакцию();
			ЗаписьЖурналаРегистрации("ПомощникАктаЕГАИС.ПроведениеТТН",
				УровеньЖурналаРегистрации.Информация, , ТТН, "ТТН проведена после правок номенклатуры");
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОтметитьОшибкуПроведения(ТТН, ТекстОшибки);
			ЗаписьЖурналаРегистрации("ПомощникАктаЕГАИС.ПроведениеТТН",
				УровеньЖурналаРегистрации.Ошибка, , ТТН, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	ТТНКПерепроведению = Новый Соответствие;
	
КонецПроцедуры

// Номенклатура записана, а провести не удалось — строки плана по этой ТТН нельзя считать выполненными.
Процедура ОтметитьОшибкуПроведения(ТТН, ТекстОшибки)
	
	Для Каждого СтрокаПлана Из ПланИзменений Цикл
		Если СтрокаПлана.Объект = ТТН И СтрокаПлана.Выполнено Тогда
			СтрокаПлана.Выполнено = Ложь;
			СтрокаПлана.Результат = "Записано, но не проведено: " + ТекстОшибки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что все объекты из адаптера существуют в конфигурации.
Функция ПроверитьАдаптер() Экспорт
	
	Ошибки = Новый Массив;
	Имена = ИменаОбъектов();
	
	// Акцизные марки
	ПроверитьОбъект(Имена.ТаблицаМарок, Ошибки);
	Если Не МаркиВСправочнике() И Не ЗначениеЗаполнено(Имена.МаркаИзмерение) Тогда
		Ошибки.Добавить("Марки хранятся в регистре сведений: задайте МаркаИзмерение — ключевое измерение со ссылкой на карточку марки, иначе менять статусы нельзя");
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("МаркаКод,МаркаСтатус,МаркаСправка2,МаркаАлкопродукция,МаркаОснование,МаркаНоменклатура,МаркаОрганизация", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаМарок, Имена[Ключ], Ошибки);
	КонецЦикла;
	
	// Справочники
	ПроверитьОбъект(Имена.ТаблицаСправок2, Ошибки);
	ПроверитьРеквизит(Имена.ТаблицаСправок2, Имена.Справка2Алкопродукция, Ошибки);
	ПроверитьОбъект(Имена.ТаблицаАлкопродукции, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АлкопродукцияВидПродукции,АлкопродукцияОбъем,АлкопродукцияКрепость,АлкопродукцияПроизводитель", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаАлкопродукции, Имена[Ключ], Ошибки);
	КонецЦикла;
	ПроверитьОбъект(Имена.ТаблицаНоменклатуры, Ошибки);
	Для Каждого Ключ Из СтрРазделить("НоменклатураВидПродукции,НоменклатураОбъем,НоменклатураКрепость,НоменклатураКод,НоменклатураАртикул", ",") Цикл
		ПроверитьРеквизит(Имена.ТаблицаНоменклатуры, Имена[Ключ], Ошибки);
	КонецЦикла;
	
	// Соответствие номенклатуры
	ПроверитьОбъект(Имена.РегистрСоответствий, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеНоменклатура, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеАлкопродукция, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеСправка2, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеИдентификаторУпаковки, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеХарактеристика, Ошибки);
	ПроверитьРеквизит(Имена.РегистрСоответствий, Имена.СоответствиеУпаковка, Ошибки);
	ПроверитьРеквизит(Имена.ТаблицаАлкопродукции, Имена.АлкопродукцияСопоставленоВИБ, Ошибки);
	
	// ТТН
	ПроверитьОбъект(Имена.ДокументТТН, Ошибки);
	ПроверитьТабличнуюЧасть(Имена.ДокументТТН, Имена.ТЧТТН, Ошибки);
	Для Каждого Ключ Из СтрРазделить("ТТНСправка2,ТТНАлкопродукция,ТТННоменклатура,ТТНКоличество", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументТТН, Имена[Ключ], Ошибки, Имена.ТЧТТН);
	КонецЦикла;
	Если Имена.ОснованиеТТН_Способ = "РеквизитТТН" Тогда
		ПроверитьРеквизит(Имена.ДокументТТН, Имена.ТТНРеквизитОснования, Ошибки);
	КонецЕсли;
	
	// Статус ТТН: без него проведение запрещено, поэтому это ошибка, а не предупреждение.
	Если ЗначениеЗаполнено(Имена.РегистрСтатусовЕГАИС) Тогда
		ПроверитьОбъект(Имена.РегистрСтатусовЕГАИС, Ошибки);
		ПроверитьРеквизит(Имена.РегистрСтатусовЕГАИС, Имена.СтатусыЕГАИСДокумент, Ошибки);
		ПроверитьРеквизит(Имена.РегистрСтатусовЕГАИС, Имена.СтатусыЕГАИССтатус, Ошибки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Имена.ТТНСтатус) Тогда
		ПроверитьРеквизит(Имена.ДокументТТН, Имена.ТТНСтатус, Ошибки);
	ИначеЕсли Не ЗначениеЗаполнено(Имена.РегистрСтатусовЕГАИС) Тогда
		Ошибки.Добавить("Не задан реквизит статуса ТТН (ТТНСтатус) — проведение ТТН будет недоступно");
	КонецЕсли;
	Если (ЗначениеЗаполнено(Имена.ТТНСтатус) Или ЗначениеЗаполнено(Имена.РегистрСтатусовЕГАИС))
		И ЗначениеСтатусаПодтвержденнойТТН() = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон(
			"Не удалось определить статус «Подтверждена»: перечисление «%1», значение «%2» — проведение ТТН будет недоступно",
			Имена.ТТНПеречислениеСтатусов, Имена.ТТНСтатусПодтверждена));
	КонецЕсли;
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		Если Метаданные.НайтиПоПолномуИмени(Описание.ПолноеИмя) = Неопределено Тогда
			Ошибки.Добавить("Не найден документ-основание ТТН (можно убрать из ДокументыОснованияТТН): " + Описание.ПолноеИмя);
		Иначе
			ПроверитьТабличнуюЧасть(Описание.ПолноеИмя, Описание.ТЧ, Ошибки);
			ПроверитьРеквизит(Описание.ПолноеИмя, Описание.Номенклатура, Ошибки, Описание.ТЧ);
			ПроверитьРеквизит(Описание.ПолноеИмя, Описание.Количество, Ошибки, Описание.ТЧ);
			Если Имена.ОснованиеТТН_Способ = "РеквизитОснования" Тогда
				ПроверитьРеквизит(Описание.ПолноеИмя, Описание.СсылкаНаТТН, Ошибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Акт списания
	ПроверитьОбъект(Имена.ДокументАкт, Ошибки);
	ПроверитьРеквизит(Имена.ДокументАкт, Имена.АктОрганизацияЕГАИС, Ошибки);
	ПроверитьТабличнуюЧасть(Имена.ДокументАкт, Имена.ТЧАктаТовары, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АктСправка2,АктКоличество,АктТоварыКлючСвязи,АктТоварыАлкопродукция", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументАкт, Имена[Ключ], Ошибки, Имена.ТЧАктаТовары);
	КонецЦикла;
	ПроверитьТабличнуюЧасть(Имена.ДокументАкт, Имена.ТЧАктаМарки, Ошибки);
	Для Каждого Ключ Из СтрРазделить("АктМаркиКлючСвязи,АктМаркиЗначение", ",") Цикл
		ПроверитьРеквизит(Имена.ДокументАкт, Имена[Ключ], Ошибки, Имена.ТЧАктаМарки);
	КонецЦикла;
	
	// Марки в чеках (необязательно)
	Если ЗначениеЗаполнено(Имена.ТаблицаМарокЧеков) Тогда
		Части = СтрРазделить(Имена.ТаблицаМарокЧеков, ".");
		Если Части.Количество() = 3 Тогда
			ПолноеИмяЧека = Части[0] + "." + Части[1];
			ПроверитьОбъект(ПолноеИмяЧека, Ошибки);
			ПроверитьТабличнуюЧасть(ПолноеИмяЧека, Части[2], Ошибки);
			ПроверитьРеквизит(ПолноеИмяЧека, Имена.ЧекМаркаКод, Ошибки, Части[2]);
		Иначе
			Ошибки.Добавить("ТаблицаМарокЧеков должна иметь вид Документ.Имя.ТабличнаяЧасть");
		КонецЕсли;
	КонецЕсли;
	
	// Полученные остатки ЕГАИС (кейс 2)
	Если Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков) = Неопределено Тогда
		Ошибки.Добавить("Не найден документ полученных остатков ЕГАИС: " + Имена.ДокументОстатков + " — кейс 2 будет без данных ЕГАИС");
	Иначе
		ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиОрганизация, Ошибки);
		ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиОперация, Ошибки);
		ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиСтатус, Ошибки);
		
		// Без отбора по операции подхватим документ регистра №2, без отбора по статусу —
		// документ с ошибкой получения. И то и другое даст неверную картину остатков.
		Если ЗначениеОперацииРегистр1() = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(
				"Не определена операция «запрос остатков в регистре №1» (%1 / %2) — остатки будут читаться без отбора по операции",
				Имена.ОстаткиПеречислениеОпераций, Имена.ОстаткиОперацияРегистр1));
		КонецЕсли;
		Если ЗначениеСтатусаОстатковПолучены() = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(
				"Не определён статус «получены остатки» (%1 / %2) — в выборку попадут документы с ошибкой получения",
				Имена.ОстаткиПеречислениеСтатусов, Имена.ОстаткиСтатусПолучены));
		КонецЕсли;
		
		// Количества регистра №1 — обязательны, по ним считается «сколько списать».
		ПроверитьТабличнуюЧасть(Имена.ДокументОстатков, Имена.ТЧОстатковКоличества, Ошибки);
		ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиКолСправка2, Ошибки, Имена.ТЧОстатковКоличества);
		ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиКолКоличество, Ошибки, Имена.ТЧОстатковКоличества);
		
		// Коды марок — необязательны: без них кейс 2 работает только по количествам.
		Если Не ЗначениеЗаполнено(Имена.ТЧОстатковМарки) Тогда
			// Кодов марок в документе остатков нет: кейс 2 сверяет только количества.
		ИначеЕсли Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков).ТабличныеЧасти.Найти(Имена.ТЧОстатковМарки) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(
				"Нет табличной части %1 у %2 — кодов марок нет, статусы по кейсу 2 сверяться не будут (необязательно)",
				Имена.ТЧОстатковМарки, Имена.ДокументОстатков));
		Иначе
			ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиСправка2, Ошибки, Имена.ТЧОстатковМарки);
			ПроверитьРеквизит(Имена.ДокументОстатков, Имена.ОстаткиКодМарки, Ошибки, Имена.ТЧОстатковМарки);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Имена.ДокументЗапросаМарок) Тогда
		Если Метаданные.НайтиПоПолномуИмени(Имена.ДокументЗапросаМарок) = Неопределено Тогда
			Ошибки.Добавить("Не найден документ запроса марок по справке 2: " + Имена.ДокументЗапросаМарок);
		Иначе
			ПроверитьРеквизит(Имена.ДокументЗапросаМарок, Имена.ЗапросОрганизацияЕГАИС, Ошибки);
			ПроверитьРеквизит(Имена.ДокументЗапросаМарок, Имена.ЗапросСправка2, Ошибки);
			ПроверитьРеквизит(Имена.ДокументЗапросаМарок, Имена.ЗапросАлкопродукция, Ошибки);
			Если ЗначениеВидаОтчетаОстаткиРегистр3() = Неопределено Тогда
				Ошибки.Добавить("Не найден вид отчёта «Остатки в регистре №3» — запрос марок по справке 2 недоступен");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Перечисление статусов и его значения
	МетаПеречисление = Метаданные.Перечисления.Найти(Имена.ПеречислениеСтатусов);
	Если МетаПеречисление = Неопределено Тогда
		Ошибки.Добавить("Не найдено перечисление статусов: " + Имена.ПеречислениеСтатусов);
	Иначе
		Для Каждого КлючЗначение Из СоответствиеСтатусов() Цикл
			Если МетаПеречисление.ЗначенияПеречисления.Найти(КлючЗначение.Значение) = Неопределено Тогда
				Пометка = ?(НеобязательныеСтатусы().Найти(КлючЗначение.Ключ) <> Неопределено, " (необязательный, будет пропущен)", "");
				Ошибки.Добавить(СтрШаблон("Нет значения статуса ""%1"" (логический статус ""%2"")%3",
					КлючЗначение.Значение, КлючЗначение.Ключ, Пометка));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

#КонецОбласти

#Область АдаптерМетаданных

// ЕДИНСТВЕННОЕ место с именами объектов конфигурации.
// Значения реквизитов номенклатуры/алкопродукции могут быть путём через точку
// (например, "ВидАлкогольнойПродукции.Код").
// Кэши живут в пределах серверного вызова; сбрасываются перед диагностикой,
// чтобы правка адаптера или изменение метаданных подхватились без перезапуска.
Процедура СброситьКэшиМетаданных() Экспорт
	
	КэшИмен = Неопределено;
	КэшТекстовЗапросов = Неопределено;
	КэшСтатусов = Неопределено;
	КэшЛогическихСтатусов = Неопределено;
	КэшМатрицыСтатусов = Неопределено;
	
КонецПроцедуры

Функция ИменаОбъектов() Экспорт
	
	// Структура собирается один раз: её читают десятки раз за вызов, в том числе в циклах.
	Если КэшИмен <> Неопределено Тогда
		Возврат КэшИмен;
	КонецЕсли;
	
	Имена = Новый Структура;
	
	// Акцизные марки ЕГАИС
	Имена.Вставить("ТаблицаМарок",       "РегистрСведений.АкцизныеМаркиЕГАИС"); // Розница 2.3, копия магазина
	Имена.Вставить("МаркаКод",           "АкцизнаяМарка.ЗначениеШтрихкода"); // УТОЧНИТЬ имя реквизита штрихкода у справочника марки
	Имена.Вставить("МаркаСтатус",        "Статус");
	Имена.Вставить("МаркаСправка2",      "Справка2");
	Имена.Вставить("МаркаАлкопродукция", "АлкогольнаяПродукция");
	Имена.Вставить("МаркаОснование",     "Основание");
	Имена.Вставить("МаркаОрганизация",   "ОрганизацияЕГАИС");
	Имена.Вставить("МаркаИзмерение",     "АкцизнаяМарка"); // ключевое измерение регистра марок (ссылка на карточку); для справочника пусто
	Имена.Вставить("МаркаНоменклатура",  "АкцизнаяМарка.Номенклатура"); // УТОЧНИТЬ: номенклатура на карточке штрихкода упаковки
	
	// Справки 2
	Имена.Вставить("ТаблицаСправок2",       "Справочник.Справки2ЕГАИС"); // сверено на копии Розница 2.3
	Имена.Вставить("Справка2Алкопродукция", "АлкогольнаяПродукция");     // УТОЧНИТЬ
	
	// Алкогольная продукция
	Имена.Вставить("ТаблицаАлкопродукции",       "Справочник.КлассификаторАлкогольнойПродукцииЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияВидПродукции",  "ВидПродукции");   // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияОбъем",         "Объем");          // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияКрепость",      "Крепость");       // УТОЧНИТЬ
	Имена.Вставить("АлкопродукцияПроизводитель", "Производитель");  // УТОЧНИТЬ
	// «Сопоставлено в ИБ» на карточке алкопродукции — оттуда специалист берёт номенклатуру.
	// Пусто — поле не читаем: в части конфигураций это не реквизит, а список из регистра.
	Имена.Вставить("АлкопродукцияСопоставленоВИБ", ""); // УТОЧНИТЬ, например "СопоставленаНоменклатура"
	
	// Номенклатура
	Имена.Вставить("ТаблицаНоменклатуры",      "Справочник.Номенклатура");       // УТОЧНИТЬ
	Имена.Вставить("НоменклатураВидПродукции", ""); // в Рознице 2.3 на номенклатуре нет
	Имена.Вставить("НоменклатураОбъем",        "ОбъемДАЛ");
	Имена.Вставить("НоменклатураКрепость",     ""); // в Рознице 2.3 на номенклатуре нет
	// Код и артикул нужны только для показа в плане: специалист сверяет их глазами.
	Имена.Вставить("НоменклатураКод",          "Код");                           // УТОЧНИТЬ, пусто — код не показываем
	Имена.Вставить("НоменклатураАртикул",      "Артикул");                       // УТОЧНИТЬ, пусто — артикул не показываем
	
	// Соответствие номенклатуры ЕГАИС
	Имена.Вставить("РегистрСоответствий",       "РегистрСведений.СоответствиеНоменклатурыЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("СоответствиеНоменклатура",  "Номенклатура");         // УТОЧНИТЬ
	Имена.Вставить("СоответствиеАлкопродукция", "АлкогольнаяПродукция"); // УТОЧНИТЬ
	Имена.Вставить("СоответствиеСправка2",      "Справка2");             // УТОЧНИТЬ, пусто — измерения нет
	// В форме записи есть «Идентификатор упаковки»; справку 2 по ответу заказчика не заполняем.
	Имена.Вставить("СоответствиеИдентификаторУпаковки", "ИдентификаторУпаковки"); // УТОЧНИТЬ, пусто — не пишем
	Имена.Вставить("СоответствиеХарактеристика",        "Характеристика");        // УТОЧНИТЬ, пусто — не пишем
	Имена.Вставить("СоответствиеУпаковка",              ""); // в этой базе реквизита нет
	
	// ТТН ЕГАИС
	Имена.Вставить("ДокументТТН",      "Документ.ТТНВходящаяЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("ТЧТТН",            "Товары");                    // УТОЧНИТЬ
	Имена.Вставить("ТТНСправка2",      "Справка2");                  // УТОЧНИТЬ
	Имена.Вставить("ТТНАлкопродукция", "АлкогольнаяПродукция");      // УТОЧНИТЬ
	Имена.Вставить("ТТННоменклатура",  "Номенклатура");              // УТОЧНИТЬ
	Имена.Вставить("ТТНКоличество",    "Количество");                // УТОЧНИТЬ
	
	// Связь ТТН с поступлением/перемещением: "РеквизитТТН" или "РеквизитОснования".
	// В форме ТТН есть реквизит «Документ-основание» со ссылкой на поступление — значит "РеквизитТТН".
	// УТОЧНИТЬ имя реквизита и переспросить заказчика (вопрос 4 по кейсу 1 остался без ответа).
	Имена.Вставить("ОснованиеТТН_Способ",  "РеквизитТТН");
	Имена.Вставить("ТТНРеквизитОснования", "ДокументОснование"); // УТОЧНИТЬ, при способе "РеквизитТТН"
	
	// В Рознице 2.3 статуса на документе нет: он в регистре СтатусыДокументовЕГАИС.
	// ТТНСтатус пустой — не читать реквизит документа.
	Имена.Вставить("РегистрСтатусовЕГАИС",    "РегистрСведений.СтатусыДокументовЕГАИС");
	Имена.Вставить("СтатусыЕГАИСДокумент",    "Документ");
	Имена.Вставить("СтатусыЕГАИССтатус",      "Статус");
	Имена.Вставить("ТТНСтатус",               "");
	Имена.Вставить("ТТНПеречислениеСтатусов", "СтатусыОбработкиТТНВходящейЕГАИС");
	Имена.Вставить("ТТНСтатусПодтверждена",   "Подтвержден");
	
	// Акт списания ЕГАИС
	Имена.Вставить("ДокументАкт",            "Документ.АктСписанияЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("АктОрганизацияЕГАИС",    "ОрганизацияЕГАИС");          // УТОЧНИТЬ
	Имена.Вставить("ТЧАктаТовары",           "Товары");                    // УТОЧНИТЬ
	Имена.Вставить("АктСправка2",            "Справка2");                  // УТОЧНИТЬ
	Имена.Вставить("АктКоличество",          "Количество");                // УТОЧНИТЬ
	Имена.Вставить("АктТоварыКлючСвязи",     "ИдентификаторСтроки");       // УТОЧНИТЬ
	Имена.Вставить("АктТоварыАлкопродукция", "АлкогольнаяПродукция");      // УТОЧНИТЬ
	Имена.Вставить("ТЧАктаМарки",            "АкцизныеМарки");             // УТОЧНИТЬ
	Имена.Вставить("АктМаркиКлючСвязи",      "ИдентификаторСтроки");       // УТОЧНИТЬ
	Имена.Вставить("АктМаркиЗначение",       "АкцизнаяМарка");             // УТОЧНИТЬ
	
	// Марки в чеках. Пусто — проверка «нет чека» отключена.
	Имена.Вставить("ТаблицаМарокЧеков", "Документ.ЧекККМ.АкцизныеМарки"); // УТОЧНИТЬ
	Имена.Вставить("ЧекМаркаКод",       "АкцизнаяМарка");                 // УТОЧНИТЬ: в ТЧ чека нет КодМарки
	
	// Запрос марок по одной справке 2: отчёт ЕГАИС «Остатки в регистре №3»
	// (Склад → Обмен с ЕГАИС → Отчёты ЕГАИС). Быстрее, чем ждать весь регистр №1.
	Имена.Вставить("ДокументЗапросаМарок",      "Документ.ОтчетЕГАИС");
	Имена.Вставить("ЗапросОрганизацияЕГАИС",    "ОрганизацияЕГАИС");
	Имена.Вставить("ЗапросСправка2",            "Справка2");
	Имена.Вставить("ЗапросАлкопродукция",       "АлкогольнаяПродукция");
	Имена.Вставить("ЗапросВидОтчета",           "ВидОтчета");
	Имена.Вставить("ЗапросПеречислениеВидов",   "ВидыОтчетовЕГАИС");
	Имена.Вставить("ЗапросВидОстаткиРегистр3",  "ОстаткиВРегистре3");
	
	// Полученные остатки ЕГАИС — журнал «Остатки ЕГАИС» (скрин заказчика от 07.10). УТОЧНИТЬ всё.
	Имена.Вставить("ДокументОстатков",   "Документ.ОстаткиЕГАИС"); // УТОЧНИТЬ
	Имена.Вставить("ОстаткиОрганизация", "ОрганизацияЕГАИС");      // УТОЧНИТЬ, пусто — без отбора
	
	// Операция документа: в журнале есть и «Запрос остатков в регистре №1», и «№2»,
	// а заказчик запрашивает всегда регистр №1. Без отбора подхватим документ регистра №2.
	Имена.Вставить("ОстаткиОперация",              "ВидДокумента");             // Розница 2.3, вместо «Операция»
	Имена.Вставить("ОстаткиПеречислениеОпераций",  "ВидыДокументовЕГАИС");
	Имена.Вставить("ОстаткиОперацияРегистр1",      "ЗапросОстатковВРегистре1");
	
	// Статус документа: «Получены остатки», «Ошибка получения данных», «Черновик».
	// Без отбора свежий документ с ошибкой перекроет вчерашний удачный, и мы решим,
	// что на балансе ЕГАИС ноль марок.
	Имена.Вставить("ОстаткиСтатус",               ""); // статус в регистре СтатусыДокументовЕГАИС, не на документе
	Имена.Вставить("ОстаткиПеречислениеСтатусов", "СтатусыОбработкиОстатковЕГАИС");
	Имена.Вставить("ОстаткиСтатусПолучены",       "ПолученыОстатки");
	
	// Остатки регистра №1: алкопродукция, справка 2 и КОЛИЧЕСТВО. Кодов марок здесь нет.
	Имена.Вставить("ТЧОстатковКоличества",    "ОстаткиПоДаннымЕГАИС"); // Розница 2.3
	Имена.Вставить("ОстаткиКолСправка2",      "Справка2");           // УТОЧНИТЬ
	Имена.Вставить("ОстаткиКолКоличество",    "Количество");         // УТОЧНИТЬ
	
	// Коды марок (регистр №3) — ответ на «Запросить марки по справкам №2».
	// УТОЧНИТЬ, приходит ли он в тот же документ или в отдельный. Пусто — покодовой сверки нет,
	// кейс 2 работает только по количествам.
	Имена.Вставить("ТЧОстатковМарки",    ""); // в ОстаткиЕГАИС кодов марок нет, только количества
	Имена.Вставить("ОстаткиСправка2",    "Справка2");              // УТОЧНИТЬ
	Имена.Вставить("ОстаткиКодМарки",    "КодМарки");              // УТОЧНИТЬ
	
	// Статусы марок
	Имена.Вставить("ПеречислениеСтатусов", "СтатусыАкцизныхМарок"); // Розница 2.3
	
	КэшИмен = Имена;
	Возврат Имена;
	
КонецФункции

// Логический статус -> имя значения перечисления.
Функция СоответствиеСтатусов() Экспорт
	
	// По ответу заказчика в работе два статуса: «В наличии» (ЕГАИС «В обороте»)
	// и «Реализована» (ЕГАИС «В архиве»). «В резерве» — необязательный: если его нет
	// в перечислении, он просто пропускается.
	Статусы = Новый Структура;
	Статусы.Вставить("ВНаличии",    "ВНаличии");    // УТОЧНИТЬ
	Статусы.Вставить("Реализована", "Реализована"); // УТОЧНИТЬ
	Статусы.Вставить("ВРезерве",    "ВРезерве");    // УТОЧНИТЬ, необязательный
	Возврат Статусы;
	
КонецФункции

Функция НеобязательныеСтатусы() Экспорт
	Возврат СтрРазделить("ВРезерве", ",");
КонецФункции

// Документы, которые могут быть основанием ТТН. УТОЧНИТЬ все имена.
Функция ДокументыОснованияТТН() Экспорт
	
	Основания = Новый Массив;
	Основания.Добавить(Новый Структура("ПолноеИмя, ТЧ, Номенклатура, Количество, СсылкаНаТТН",
		"Документ.ПоступлениеТоваров", "Товары", "Номенклатура", "Количество", "ТТНЕГАИС"));
	Основания.Добавить(Новый Структура("ПолноеИмя, ТЧ, Номенклатура, Количество, СсылкаНаТТН",
		"Документ.ПеремещениеТоваров", "Товары", "Номенклатура", "Количество", "ТТНЕГАИС"));
	Возврат Основания;
	
КонецФункции

// Значение перечисления по логическому статусу; Неопределено, если такого значения нет в конфигурации.
Функция ЗначениеСтатуса(ЛогическийСтатус) Экспорт
	
	// Поиск по метаданным на каждый вызов дорог: статусы читаются для каждой марки.
	Если КэшСтатусов = Неопределено Тогда
		КэшСтатусов = Новый Соответствие;
	КонецЕсли;
	Сохранённое = КэшСтатусов.Получить(ЛогическийСтатус);
	Если Сохранённое <> Неопределено Тогда
		Возврат ?(Сохранённое = "", Неопределено, Сохранённое);
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	ИмяЗначения = Неопределено;
	Если Не СоответствиеСтатусов().Свойство(ЛогическийСтатус, ИмяЗначения) Тогда
		КэшСтатусов.Вставить(ЛогическийСтатус, "");
		Возврат Неопределено;
	КонецЕсли;
	
	МетаПеречисление = Метаданные.Перечисления.Найти(Имена.ПеречислениеСтатусов);
	Если МетаПеречисление = Неопределено
		Или МетаПеречисление.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		КэшСтатусов.Вставить(ЛогическийСтатус, "");
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = Перечисления[Имена.ПеречислениеСтатусов][ИмяЗначения];
	КэшСтатусов.Вставить(ЛогическийСтатус, Значение);
	Возврат Значение;
	
КонецФункции

// Значение перечисления -> логический статус. Неизвестный — пустая строка.
Функция ЛогическийСтатус(ЗначениеСтатусаВ1С) Экспорт
	
	Для Каждого КлючЗначение Из СоответствиеСтатусов() Цикл
		Значение = ЗначениеСтатуса(КлючЗначение.Ключ);
		Если Значение <> Неопределено И Значение = ЗначениеСтатусаВ1С Тогда
			Возврат КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

// Чем адресовать марку: ссылкой справочника, измерением регистра или ничем.
Функция ВыражениеСсылкиМарки() Экспорт
	
	Если МаркиВСправочнике() Тогда
		Возврат "Марки.Ссылка";
	КонецЕсли;
	
	ИмяИзмерения = ИменаОбъектов().МаркаИзмерение;
	Возврат ?(ЗначениеЗаполнено(ИмяИзмерения), "Марки." + ИмяИзмерения, "НЕОПРЕДЕЛЕНО");
	
КонецФункции

Функция МенеджерРегистраМарок() Экспорт
	Возврат РегистрыСведений[СтрЗаменить(ИменаОбъектов().ТаблицаМарок, "РегистрСведений.", "")];
КонецФункции

// Набор записей регистра по одной марке: по ключевому измерению, иначе по коду.
Функция НаборЗаписейМарки(Марка, КодМарки) Экспорт
	
	Имена = ИменаОбъектов();
	Набор = МенеджерРегистраМарок().СоздатьНаборЗаписей();
	
	Если ЗначениеЗаполнено(Имена.МаркаИзмерение) И ЗначениеЗаполнено(Марка) Тогда
		Набор.Отбор[Имена.МаркаИзмерение].Установить(Марка);
	ИначеЕсли СтрНайти(Имена.МаркаКод, ".") = 0 Тогда
		Набор.Отбор[Имена.МаркаКод].Установить(КодМарки);
	Иначе
		ВызватьИсключение "Не задано ключевое измерение регистра марок (МаркаИзмерение) — изменить запись нельзя.";
	КонецЕсли;
	
	Возврат Набор;
	
КонецФункции

// Запись реквизита на карточке марки, когда в адаптере он задан путём «Измерение.Реквизит».
Процедура ЗаписатьРеквизитКарточкиМарки(Карточка, ПутьРеквизита, Значение) Экспорт
	
	Если Не ЗначениеЗаполнено(Карточка) Тогда
		ВызватьИсключение "Нет ссылки на карточку марки — проверьте МаркаИзмерение в адаптере.";
	КонецЕсли;
	
	Части = СтрРазделить(ПутьРеквизита, ".");
	ИмяРеквизита = Части[Части.ВГраница()];
	
	КарточкаОбъект = Карточка.ПолучитьОбъект();
	КарточкаОбъект.Заблокировать();
	КарточкаОбъект[ИмяРеквизита] = Значение;
	КарточкаОбъект.Записать();
	
КонецПроцедуры

Функция МаркиВСправочнике() Экспорт
	Возврат СтрНачинаетсяС(ИменаОбъектов().ТаблицаМарок, "Справочник.");
КонецФункции

// Подставляет имена из адаптера в текст запроса: #Ключ# -> значение.
Функция ПодготовитьТекстЗапроса(Знач Текст) Экспорт
	
	// Подстановка имён — это полсотни проходов СтрЗаменить по тексту запроса.
	// Одни и те же запросы готовятся многократно, поэтому результат запоминаем.
	Если СтрНайти(Текст, "#") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	
	Если КэшТекстовЗапросов = Неопределено Тогда
		КэшТекстовЗапросов = Новый Соответствие;
	КонецЕсли;
	
	Готовый = КэшТекстовЗапросов.Получить(Текст);
	Если Готовый <> Неопределено Тогда
		Возврат Готовый;
	КонецЕсли;
	
	Исходный = Текст;
	Для Каждого КлючЗначение Из ИменаОбъектов() Цикл
		Текст = СтрЗаменить(Текст, "#" + КлючЗначение.Ключ + "#", КлючЗначение.Значение);
	КонецЦикла;
	
	КэшТекстовЗапросов.Вставить(Исходный, Текст);
	Возврат Текст;
	
КонецФункции

