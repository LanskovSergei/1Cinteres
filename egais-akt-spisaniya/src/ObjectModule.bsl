	Возврат Настройки;
	
КонецФункции

// Какой статус ставить в 1С по состоянию марки в ЕГАИС.
// СостояниеЕГАИС: "НаБалансе" (ЕГАИС «В обороте»), "НеНаБалансе" (ЕГАИС «В архиве»).
Функция МатрицаСтатусов() Экспорт
	
	М = Новый ТаблицаЗначений;
	М.Колонки.Добавить("СостояниеЕГАИС");
	М.Колонки.Добавить("СтатусВ1С");
	М.Колонки.Добавить("НовыйСтатус");
	
	ДобавитьПравило(М, "НаБалансе",   "Реализована", "ВНаличии");    // ЕГАИС «В обороте»
	ДобавитьПравило(М, "НаБалансе",   "ВРезерве",    "ВНаличии");
	ДобавитьПравило(М, "НеНаБалансе", "ВНаличии",    "Реализована"); // ЕГАИС «В архиве»
	ДобавитьПравило(М, "НеНаБалансе", "ВРезерве",    "Реализована");
	
	Возврат М;
	
КонецФункции

Процедура ДобавитьПравило(М, СостояниеЕГАИС, СтатусВ1С, НовыйСтатус)
	
	Правило = М.Добавить();
	Правило.СостояниеЕГАИС = СостояниеЕГАИС;
	Правило.СтатусВ1С = СтатусВ1С;
	Правило.НовыйСтатус = НовыйСтатус;
	
КонецПроцедуры

#КонецОбласти

#Область Диагностика

Функция ТекстЗапросаДиагностики()
	
	Текст =
	"ВЫБРАТЬ
	|	СтрокиАкта.#АктСправка2# КАК Справка2,
	|	СУММА(СтрокиАкта.#АктКоличество#) КАК ТребуетсяМарок
	|ПОМЕСТИТЬ ВТСправкиАкта
	|ИЗ
	|	#ДокументАкт#.#ТЧАктаТовары# КАК СтрокиАкта
	|ГДЕ
	|	СтрокиАкта.Ссылка = &Акт
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиАкта.#АктСправка2#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция
	|ПОМЕСТИТЬ ВТСопоставленные
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСправкиАкта.Справка2 КАК Справка2,
	|	ВТСправкиАкта.ТребуетсяМарок КАК ТребуетсяМарок,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК ВсегоМарок,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаСтатус# = &СтатусВНаличии
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВНаличии,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаАлкопродукция# = ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезАлкопродукции,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|					И Сопоставленные.Алкопродукция ЕСТЬ NULL
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезСоответствия
	|ИЗ
	|	ВТСправкиАкта КАК ВТСправкиАкта
	|		ЛЕВОЕ СОЕДИНЕНИЕ #ТаблицаМарок# КАК Марки
	|		ПО (Марки.#МаркаСправка2# = ВТСправкиАкта.Справка2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСопоставленные КАК Сопоставленные
	|		ПО (Сопоставленные.Алкопродукция = Марки.#МаркаАлкопродукция#)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСправкиАкта.Справка2,
	|	ВТСправкиАкта.ТребуетсяМарок";
	
	Возврат ПодготовитьТекстЗапроса(Текст);
	
КонецФункции

// Порядок проверок: нет марок → номенклатура → соответствие → статусы.
Процедура Классифицировать(СтрокаРезультата)
	
	Если СтрокаРезультата.БитыеСсылки > 0 Тогда
		// «<Объект не найден>»: автоматически не исправляем — нужно провести на сервере.
		СтрокаРезультата.Кейс = 0;
		СтрокаРезультата.Статус = "Ручное решение";
		СтрокаРезультата.Описание = СтрШаблон("Марок с битой ссылкой на алкопродукцию или номенклатуру: %1. Провести на сервере и синхронизировать на точку.",
			СтрокаРезультата.БитыеСсылки);
		
	ИначеЕсли СтрокаРезультата.ВсегоМарок = 0 Тогда
		СтрокаРезультата.Кейс = 4;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = "По справке нет ни одной марки в 1С. Обычно после обнуления точки и второго запроса остатков.";
		
	ИначеЕсли СтрокаРезультата.БезАлкопродукции > 0
		Или СтрокаРезультата.БезНоменклатуры > 0
		Или СтрокаРезультата.НеверныхНоменклатур > 0 Тогда
		СтрокаРезультата.Кейс = 1;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон(
			"Марок без алкопродукции — %1, без номенклатуры — %2, с неверной номенклатурой — %3.",
			СтрокаРезультата.БезАлкопродукции, СтрокаРезультата.БезНоменклатуры,
			СтрокаРезультата.НеверныхНоменклатур);
		
	ИначеЕсли СтрокаРезультата.БезСоответствия > 0 Тогда
		СтрокаРезультата.Кейс = 3;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон("Нет соответствия номенклатуры для %1 марок.", СтрокаРезультата.БезСоответствия);
		
	ИначеЕсли СтрокаРезультата.ДанныеЕГАИС = "ТолькоКоличество"
		И (СтрокаРезультата.ВНаличии <> СтрокаРезультата.ЕГАИСКоличество
			Или СтрокаРезультата.ТребуетсяМарок > СтрокаРезультата.ЕГАИСКоличество) Тогда
		// Есть количество из регистра №1, но нет кодов марок: видно расхождение, а какая
		// именно марка «не та» — нет. Нужны марки по справке 2 (регистр №3).
		СтрокаРезультата.Кейс = 2;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон(
			"По ЕГАИС на балансе %1, в 1С «в наличии» %2. Кодов марок нет — запросите марки по справке 2 из документа остатков.",
			СтрокаРезультата.ЕГАИСКоличество, СтрокаРезультата.ВНаличии);
		
	ИначеЕсли СтрокаРезультата.ВНаличии < СтрокаРезультата.ТребуетсяМарок
		Или СтрокаРезультата.НеВЕГАИС > 0
		Или СтрокаРезультата.ВЕГАИСНеВНаличии > 0
		Или СтрокаРезультата.ЕГАИСКоличество > 0
			И СтрокаРезультата.ТребуетсяМарок > СтрокаРезультата.ЕГАИСКоличество Тогда
		// «Даже в зелёных бывают проблемы»: статусы расходятся с ЕГАИС при совпадающем количестве.
		СтрокаРезультата.Кейс = 2;
		СтрокаРезультата.Статус = "Проблема";
		СтрокаРезультата.Описание = СтрШаблон("В наличии %1 из %2. «В наличии», но нет на балансе ЕГАИС: %3. На балансе ЕГАИС, но другой статус: %4. Остатки ЕГАИС: %5.",
			СтрокаРезультата.ВНаличии, СтрокаРезультата.ТребуетсяМарок,
			СтрокаРезультата.НеВЕГАИС, СтрокаРезультата.ВЕГАИСНеВНаличии, СтрокаРезультата.ДанныеЕГАИС);
		
	ИначеЕсли СтрокаРезультата.ДанныеЕГАИС <> "Есть" Тогда
		// Количество сходится, но покодовой сверки не было — «зелёная» справка без гарантии:
		// внутри может быть марка с неверным статусом, и ЕГАИС вернёт «ШК не найден».
		СтрокаРезультата.Кейс = 0;
		СтрокаРезультата.Статус = "Предупреждение";
		СтрокаРезультата.Описание = СтрШаблон(
			"Количество сходится, но марки по кодам не сверены (данные ЕГАИС: %1) — возможна ошибка «ШК не найден».",
			СтрокаРезультата.ДанныеЕГАИС);
		
	Иначе
		СтрокаРезультата.Кейс = 0;
		СтрокаРезультата.Статус = "Готово";
		СтрокаРезультата.Описание = "";
	КонецЕсли;
	
КонецПроцедуры

Функция СправкиКейса(Кейс) Экспорт
	
	Справки = Новый Массив;
	Для Каждого СтрокаРезультата Из Результаты.НайтиСтроки(Новый Структура("Кейс", Кейс)) Цикл
		Справки.Добавить(СтрокаРезультата.Справка2);
	КонецЦикла;
	Возврат Справки;
	
КонецФункции

#КонецОбласти

#Область БитыеСсылкиИКонтроли

// «<Объект не найден> (223:...)»: ссылка есть, а объекта в базе нет.
// По словам заказчика: в основании марки это не страшно, а вот битая алкопродукция
// или номенклатура лечится только на сервере с синхронизацией на точку.
Процедура ДополнитьДиагностикуБитыеСсылки()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК Количество
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|		ЛЕВОЕ СОЕДИНЕНИЕ #ТаблицаАлкопродукции# КАК АП
	|		ПО (АП.Ссылка = Марки.#МаркаАлкопродукция#)
	|		ЛЕВОЕ СОЕДИНЕНИЕ #ТаблицаНоменклатуры# КАК Н
	|		ПО (Н.Ссылка = Марки.#МаркаНоменклатура#)
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|	И (Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|				И АП.Ссылка ЕСТЬ NULL
	|			ИЛИ Марки.#МаркаНоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|				И Н.Ссылка ЕСТЬ NULL)
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаСправка2#"));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультата = Результаты.Найти(Выборка.Справка2, "Справка2");
		Если СтрокаРезультата <> Неопределено Тогда
			СтрокаРезультата.БитыеСсылки = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПланБитыхСсылок()
	
	Для Каждого СтрокаРезультата Из Результаты.НайтиСтроки(Новый Структура("Статус", "Ручное решение")) Цикл
		ДобавитьВПлан(0, СтрокаРезультата.Справка2, "Информация", СтрокаРезультата.Справка2,
			СтрШаблон("Марок с битой ссылкой: %1", СтрокаРезультата.БитыеСсылки), "",
			"«Объект не найден» в алкопродукции или номенклатуре — провести на сервере и синхронизировать на точку");
	КонецЦикла;
	
КонецПроцедуры

// Справка 2 уникальна в базе точки, но в главной базе одна справка может быть у разных точек.
// Тогда наши выборки по справке смешают марки разных магазинов — останавливаемся.
Процедура ПроверитьУникальностьСправок()
	
	Имена = ИменаОбъектов();
	Если Не ЗначениеЗаполнено(Имена.МаркаОрганизация) Или Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Марки.#МаркаОрганизация#) КАК Организаций
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаСправка2#
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Марки.#МаркаОрганизация#) > 1"));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон(
			"По справке %1 в базе есть марки нескольких организаций ЕГАИС. "
			+ "Обработка рассчитана на базу одной точки, где справка уникальна. "
			+ "Запустите её в базе магазина или добавьте отбор по организации.", Выборка.Справка2);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПланИПрименение

Процедура ДобавитьВПлан(Кейс, Справка2, ТипДействия, Объект, Было, Стало, Основание, ПараметрыДействия = Неопределено) Экспорт
	
	СтрокаПлана = ПланИзменений.Добавить();
	СтрокаПлана.Кейс = Кейс;
	СтрокаПлана.Справка2 = Справка2;
	СтрокаПлана.ТипДействия = ТипДействия;
	СтрокаПлана.Объект = Объект;
	СтрокаПлана.Было = Было;
	СтрокаПлана.Стало = Стало;
	СтрокаПлана.Основание = Основание;
	СтрокаПлана.Подтверждено = Ложь;
	
	Если ПараметрыДействия <> Неопределено Тогда
		СтрокаПлана.ПараметрыСтрокой = ЗначениеВСтрокуВнутр(ПараметрыДействия);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДействие(СтрокаПлана)
	
	ПараметрыДействия = Неопределено;
	Если ЗначениеЗаполнено(СтрокаПлана.ПараметрыСтрокой) Тогда
		ПараметрыДействия = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
	КонецЕсли;
	
	ТипДействия = СтрокаПлана.ТипДействия;
	
	Если ТипДействия = "ПерепроведениеДокумента" Тогда
		ДействиеПерепровестиДокумент(СтрокаПлана.Объект, ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗаполнениеНоменклатуры" Тогда
		ДействиеЗаполнитьНоменклатуруТТН(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ИзменениеКрепости" Тогда
		ДействиеИзменитьКрепость(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "СменаСтатуса" Тогда
		ДействиеСменитьСтатус(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "СозданиеСоответствия" Тогда
		ДействиеСоздатьСоответствие(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗапросМарок" Тогда
		ДействиеПоставитьВОчередь(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ПерепривязкаМарки" Тогда
		ДействиеПерепривязатьМарку(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "ЗаполнениеСтрокиАкта" Тогда
		ДействиеЗаполнитьСтрокуАкта(ПараметрыДействия);
		
	ИначеЕсли ТипДействия = "Информация" Тогда
		ВызватьИсключение "Информационная строка: применять нечего, нужна ручная проверка.";
		
	Иначе
		ВызватьИсключение "Неизвестный тип действия: " + ТипДействия;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапомнитьИсправленнуюСправку(СтрокаПлана)
	
	Если СтрокаПлана.ТипДействия = "ЗаполнениеСтрокиАкта" Или СтрокаПлана.ТипДействия = "ЗапросМарок" Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПлана.Справка2)
		И ИсправленныеСправки.Найти(СтрокаПлана.Справка2, "Справка2") = Неопределено Тогда
		ИсправленныеСправки.Добавить().Справка2 = СтрокаПлана.Справка2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВЖурнал(СтрокаПлана)
	
	Уровень = ?(СтрокаПлана.Выполнено, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	
	Комментарий = СтрШаблон("Кейс %1. Справка 2: %2. Было: %3. Стало: %4. Основание: %5. Результат: %6",
		СтрокаПлана.Кейс, СтрокаПлана.Справка2, СтрокаПлана.Было, СтрокаПлана.Стало,
		СтрокаПлана.Основание, СтрокаПлана.Результат);
	
	ЗаписьЖурналаРегистрации("ПомощникАктаЕГАИС." + СтрокаПлана.ТипДействия, Уровень, ,
		СтрокаПлана.Объект, Комментарий);
	
КонецПроцедуры

#КонецОбласти

#Область Кейс1_НоменклатураНаМарке

// Номенклатура хранится в самой акцизной марке (ответ заказчика по кейсу 1),
// поэтому проверяем марку, а не строку ТТН: основание марки меняется на чек или акт списания,
// и по основанию такие марки в диагностику не попадали.
Процедура ДополнитьДиагностикуКейс1()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Текст =
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаНоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезНоменклатуры,
	|	СУММА(ВЫБОР
	|			КОГДА Марки.#МаркаНоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|					И Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|					И (Марки.#МаркаНоменклатура#.#НоменклатураВидПродукции# <> Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции#
	|						ИЛИ &ПроверятьОбъем
	|							И Марки.#МаркаНоменклатура#.#НоменклатураОбъем# <> Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем#)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НеверныхНоменклатур
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаСправка2#";
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	Запрос.УстановитьПараметр("ПроверятьОбъем", НастройкаПроверятьОбъем());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультата = Результаты.Найти(Выборка.Справка2, "Справка2");
		Если СтрокаРезультата <> Неопределено Тогда
			СтрокаРезультата.БезНоменклатуры = Выборка.БезНоменклатуры;
			СтрокаРезультата.НеверныхНоменклатур = Выборка.НеверныхНоменклатур;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПланКейс1()
	
	Справки = СправкиКейса(1);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Шаг A: каждую ТТН справки — один раз.
	ТаблицаТТН = ТТНПоСправкам(Справки);
	ЕстьСтатус = ТаблицаТТН.Колонки.Найти("Статус") <> Неопределено;
	СтатусПодтверждена = ЗначениеСтатусаПодтвержденнойТТН();
	ТТНБезАвтоправок = Новый Соответствие;
	
	Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
		
		// Проводить разрешено только подтверждённую ТТН: у остальных проведение
		// может отправить в ЕГАИС акт подтверждения или расхождения.
		Если ЕстьСтатус И СтатусПодтверждена <> Неопределено И СтрокаТТН.Статус <> СтатусПодтверждена Тогда
			ТТНБезАвтоправок.Вставить(СтрокаТТН.ТТН, Истина);
			ДобавитьВПлан(1, СтрокаТТН.Справка2, "Информация", СтрокаТТН.ТТН,
				СтрШаблон("Статус ТТН: %1", СтрокаТТН.Статус), "",
				"ТТН не подтверждена — проведение запрещено, исправьте номенклатуру в ТТН вручную");
			Продолжить;
		КонецЕсли;
		
		ДобавитьВПлан(1, СтрокаТТН.Справка2, "ПерепроведениеДокумента", СтрокаТТН.ТТН,
			"Номенклатура не дозаполнена / ТТН не перепроведена",
			"Дозаполнена и проведена",
			"Аналог «Провести и закрыть» в форме ТТН",
			Новый Структура("Дозаполнить", Истина));
		
	КонецЦикла;
	
	// Шаг B: подстановка из другой строки той же ТТН.
	ДобавитьПланПодстановкиИзТТН(Справки, ТТНБезАвтоправок);
	
	// Шаг C: поиск в документе-основании ТТН.
	ДобавитьПланПоОснованиюТТН(Справки, ТТНБезАвтоправок);
	
КонецПроцедуры

// ТТН ищем по справке 2 в строках ТТН, а не по основанию марки: основание — это
// последнее место фиксации марки (ТТН → чек → акт списания), поэтому для уже проданных
// или списанных марок ТТН по основанию не находится.
// Колонки: ТТН, Справка2, Статус (если реквизит статуса задан в адаптере).
Функция ТТНПоСправкам(Справки)
	
	Имена = ИменаОбъектов();
	ЕстьСтатус = ЗначениеЗаполнено(Имена.ТТНСтатус);
	
	Текст =
	"ВЫБРАТЬ
	|	СтрокиТТН.Ссылка КАК ТТН,
	|	МИНИМУМ(СтрокиТТН.#ТТНСправка2#) КАК Справка2
	|	&ВыборСтатуса
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиТТН.Ссылка
	|	&ГруппировкаСтатуса";
	
	Текст = СтрЗаменить(Текст, "&ВыборСтатуса",
		?(ЕстьСтатус, ", СтрокиТТН.Ссылка.#ТТНСтатус# КАК Статус", ""));
	Текст = СтрЗаменить(Текст, "&ГруппировкаСтатуса",
		?(ЕстьСтатус, ", СтрокиТТН.Ссылка.#ТТНСтатус#", ""));
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// ТТНБезАвтоправок — ТТН, которые нельзя править автоматически (не подтверждены в ЕГАИС).
// По ним шаг A уже добавил строку «Информация», поэтому здесь просто пропускаем.
Процедура ДобавитьПланПодстановкиИзТТН(Справки, ТТНБезАвтоправок)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пустые.Ссылка КАК ТТН,
	|	Пустые.НомерСтроки КАК НомерСтроки,
	|	Пустые.#ТТНСправка2# КАК Справка2,
	|	Заполненные.#ТТННоменклатура# КАК Номенклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК Пустые
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ДокументТТН#.#ТЧТТН# КАК Заполненные
	|		ПО (Пустые.Ссылка = Заполненные.Ссылка)
	|			И (Пустые.#ТТНАлкопродукция# = Заполненные.#ТТНАлкопродукция#)
	|			И (Заполненные.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка))
	|ГДЕ
	|	Пустые.#ТТНСправка2# В (&Справки)
	|	И Пустые.#ТТННоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	// Только однозначные случаи: для строки ТТН найдена ровно одна номенклатура.
	Счетчик = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = КлючСтрокиТТН(СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки);
		Счетчик.Вставить(Ключ, ?(Счетчик.Получить(Ключ) = Неопределено, 1, Счетчик.Получить(Ключ) + 1));
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если ТТНБезАвтоправок.Получить(СтрокаТаблицы.ТТН) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючСтрокиТТН(СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки);
		Количество = Счетчик.Получить(Ключ);
		
		Если Количество > 1 Тогда
			ДобавитьВПлан(1, СтрокаТаблицы.Справка2, "Информация", СтрокаТаблицы.ТТН, "", "",
				СтрШаблон("Строка %1: в ТТН несколько разных номенклатур для этой алкопродукции — выбрать вручную",
					СтрокаТаблицы.НомерСтроки));
			Счетчик.Вставить(Ключ, 0);
			Продолжить;
		ИначеЕсли Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьВПлан(1, СтрокаТаблицы.Справка2, "ЗаполнениеНоменклатуры", СтрокаТаблицы.ТТН,
			СтрШаблон("Строка %1: номенклатура не указана", СтрокаТаблицы.НомерСтроки),
			СтрШаблон("%1", СтрокаТаблицы.Номенклатура),
			"Взято из другой строки этой же ТТН с той же алкопродукцией",
			Новый Структура("ТТН, НомерСтроки, Номенклатура, Заменить",
				СтрокаТаблицы.ТТН, СтрокаТаблицы.НомерСтроки, СтрокаТаблицы.Номенклатура, Ложь));
		
	КонецЦикла;
	
КонецПроцедуры

Функция КлючСтрокиТТН(ТТН, НомерСтроки)
	Возврат Строка(ТТН.УникальныйИдентификатор()) + "|" + Формат(НомерСтроки, "ЧГ=0");
КонецФункции

Процедура ПроверитьРазрешениеПроведенияТТН()
	
	Если Не РазрешитьПроведениеТТН Тогда
		ВызватьИсключение "Проведение ТТН запрещено настройкой «Разрешить проведение ТТН».";
	КонецЕсли;
	
КонецПроцедуры

// Значение реквизита-состояния по адаптеру: если перечисление не задано, реквизит считаем
// строковым и возвращаем имя значения; иначе берём значение перечисления.
// Неопределено — ключи не заполнены или такого значения в конфигурации нет.
Функция ЗначениеПоАдаптеру(ИмяРеквизита, ИмяПеречисления, ИмяЗначения) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Или Не ЗначениеЗаполнено(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяПеречисления) Тогда
		Возврат ИмяЗначения;
	КонецЕсли;
	
	МетаПеречисление = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаПеречисление = Неопределено
		Или МетаПеречисление.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	
КонецФункции

// Значение статуса «Подтверждена» или Неопределено, если его не удалось определить.
Функция ЗначениеСтатусаПодтвержденнойТТН() Экспорт
	
	Имена = ИменаОбъектов();
	Возврат ЗначениеПоАдаптеру(Имена.ТТНСтатус, Имена.ТТНПеречислениеСтатусов, Имена.ТТНСтатусПодтверждена);
	
КонецФункции

// Проводить можно только подтверждённую в ЕГАИС ТТН. Для остальных проведение
// может отправить акт подтверждения или расхождения — это запрещено.
Процедура ПроверитьСтатусТТНПередПроведением(ТТНОбъект)
	
	Имена = ИменаОбъектов();
	Ожидаемый = ЗначениеСтатусаПодтвержденнойТТН();
	
	Если Ожидаемый = Неопределено Тогда
		ВызватьИсключение "Не определён статус «Подтверждена» для ТТН (ИменаОбъектов: ТТНСтатус, "
			+ "ТТНПеречислениеСтатусов, ТТНСтатусПодтверждена). Без этой проверки проведение запрещено: "
			+ "у неподтверждённой ТТН проведение может отправить акт в ЕГАИС.";
	КонецЕсли;
	
	Если ТТНОбъект[Имена.ТТНСтатус] <> Ожидаемый Тогда
		ВызватьИсключение СтрШаблон(
			"ТТН в статусе «%1», а не «Подтверждена»: проведение запрещено, оно может отправить акт в ЕГАИС. "
			+ "Исправьте номенклатуру в ТТН вручную.", ТТНОбъект[Имена.ТТНСтатус]);
	КонецЕсли;
	
КонецПроцедуры

// Истина, если ТТН можно править и проводить автоматически.
Функция ТТНПодтверждена(ТТН) Экспорт
	
	Ожидаемый = ЗначениеСтатусаПодтвержденнойТТН();
	Если Ожидаемый = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОбщегоНазначения_ЗначениеРеквизита(ТТН, ИменаОбъектов().ТТНСтатус) = Ожидаемый;
	
КонецФункции

Функция ОбщегоНазначения_ЗначениеРеквизита(Ссылка, ИмяРеквизита)
	
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ
	|	Т.%1 КАК Значение
	|ИЗ
	|	%2 КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка", ИмяРеквизита, Ссылка.Метаданные().ПолноеИмя()));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Значение, Неопределено);
	
КонецФункции

// Запись документа без смены состояния проведения: проведённый остаётся проведённым.
Процедура ЗаписатьБезСменыПроведения(ДокументОбъект)
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура ЗапланироватьПроведениеТТН(ТТН)
	
	Если ТТНКПерепроведению = Неопределено Тогда
		ТТНКПерепроведению = Новый Соответствие;
	КонецЕсли;
	ТТНКПерепроведению.Вставить(ТТН, Истина);
	
КонецПроцедуры

Процедура ПровестиТТН(ТТН)
	
	ПроверитьРазрешениеПроведенияТТН();
	
	ТТНОбъект = ТТН.ПолучитьОбъект();
	ТТНОбъект.Заблокировать();
	ПроверитьСтатусТТНПередПроведением(ТТНОбъект);
	ТТНОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ДействиеПерепровестиДокумент(ДокументСсылка, ПараметрыДействия = Неопределено)
	
	ЭтоТТН = ДокументСсылка.Метаданные().ПолноеИмя() = ИменаОбъектов().ДокументТТН;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.Заблокировать();
	
	Если ЭтоТТН Тогда
		ПроверитьРазрешениеПроведенияТТН();
		ПроверитьСтатусТТНПередПроведением(ДокументОбъект);
	КонецЕсли;
	
	Если ПараметрыДействия <> Неопределено
		И ПараметрыДействия.Свойство("Дозаполнить")
		И ПараметрыДействия.Дозаполнить Тогда
		ДозаполнитьНоменклатуруТТН(ДокументОбъект);
	КонецЕсли;
	
	Если ЭтоТТН Тогда
		// Проведение — один раз в конце пакета, см. ПерепровестиИзмененныеТТН.
		ЗаписатьБезСменыПроведения(ДокументОбъект);
		ЗапланироватьПроведениеТТН(ДокументСсылка);
	ИначеЕсли ДокументОбъект.Проведен Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ЗаписатьБезСменыПроведения(ДокументОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Параметры: ТТН, НомерСтроки, Номенклатура, Заменить.
Процедура ДействиеЗаполнитьНоменклатуруТТН(П)
	
	ПроверитьРазрешениеПроведенияТТН();
	
	Если Не ЗначениеЗаполнено(П.Номенклатура) Тогда
		ВызватьИсключение "Номенклатура не выбрана.";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	ТТНОбъект = П.ТТН.ПолучитьОбъект();
	ТТНОбъект.Заблокировать();
	ПроверитьСтатусТТНПередПроведением(ТТНОбъект);
	
	СтрокаТЧ = ТТНОбъект[Имена.ТЧТТН].Найти(П.НомерСтроки, "НомерСтроки");
	Если СтрокаТЧ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В ТТН %1 нет строки %2.", П.ТТН, П.НомерСтроки);
	КонецЕсли;
	
	ТекущаяНоменклатура = СтрокаТЧ[Имена.ТТННоменклатура];
	
	Если ТекущаяНоменклатура = П.Номенклатура Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяНоменклатура) И Не П.Заменить Тогда
		ВызватьИсключение СтрШаблон("Строка %1 уже заполнена номенклатурой «%2». Проверьте вручную.",
			П.НомерСтроки, ТекущаяНоменклатура);
	КонецЕсли;
	
	СтрокаТЧ[Имена.ТТННоменклатура] = П.Номенклатура;
	ЗаписатьБезСменыПроведения(ТТНОбъект);
	ЗапланироватьПроведениеТТН(П.ТТН);
	
КонецПроцедуры

// ВАРИАНТ 1 (предпочтительный): подставить вызов типовой процедуры, которую вызывает
// форма ТТН при открытии (ПриСозданииНаСервере / ПриЧтенииНаСервере). УТОЧНИТЬ.
// ВАРИАНТ 2 (ниже): собственное дозаполнение по регистру соответствий.
Процедура ДозаполнитьНоменклатуруТТН(ТТНОбъект)
	
	Имена = ИменаОбъектов();
	ТЧ = ТТНОбъект[Имена.ТЧТТН];
	
	Алкопродукции = Новый Массив;
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТННоменклатура])
			И ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТНАлкопродукция]) Тогда
			Алкопродукции.Добавить(СтрокаТЧ[Имена.ТТНАлкопродукция]);
		КонецЕсли;
	КонецЦикла;
	
	Если Алкопродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Карта = ОднозначныеСоответствия(Алкопродукции);
	
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ[Имена.ТТННоменклатура]) Тогда
			Номенклатура = Карта.Получить(СтрокаТЧ[Имена.ТТНАлкопродукция]);
			Если Номенклатура <> Неопределено Тогда
				СтрокаТЧ[Имена.ТТННоменклатура] = Номенклатура;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Алкопродукция -> Номенклатура только там, где номенклатура ровно одна.
Функция ОднозначныеСоответствия(Алкопродукции) Экспорт
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция,
	|	МАКСИМУМ(Соотв.#СоответствиеНоменклатура#) КАК Номенклатура
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция# В (&Алкопродукции)
	|
	|СГРУППИРОВАТЬ ПО
	|	Соотв.#СоответствиеАлкопродукция#
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Соотв.#СоответствиеНоменклатура#) = 1"));
	Запрос.УстановитьПараметр("Алкопродукции", Алкопродукции);
	
	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(Выборка.Алкопродукция, Выборка.Номенклатура);
	КонецЦикла;
	Возврат Карта;
	
КонецФункции

#КонецОбласти

#Область Кейс1_ОснованиеТТН

Функция НайтиОснованиеТТН(ТТН) Экспорт
	
	Имена = ИменаОбъектов();
	
	Если Имена.ОснованиеТТН_Способ = "РеквизитТТН" Тогда
		Основание = ТТН[Имена.ТТНРеквизитОснования];
		Если ЗначениеЗаполнено(Основание) И ОписаниеДокументаОснования(Основание) <> Неопределено Тогда
			Возврат Основание;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		
		Если Метаданные.НайтиПоПолномуИмени(Описание.ПолноеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Д.Ссылка КАК Ссылка
			|ИЗ
			|	%1 КАК Д
			|ГДЕ
			|	Д.%2 = &ТТН
			|	И НЕ Д.ПометкаУдаления", Описание.ПолноеИмя, Описание.СсылкаНаТТН));
		Запрос.УстановитьПараметр("ТТН", ТТН);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОписаниеДокументаОснования(Основание)
	
	ПолноеИмя = Основание.Метаданные().ПолноеИмя();
	Для Каждого Описание Из ДокументыОснованияТТН() Цикл
		Если Описание.ПолноеИмя = ПолноеИмя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

// ТТНБезАвтоправок — см. ДобавитьПланПодстановкиИзТТН.
Процедура ДобавитьПланПоОснованиюТТН(Справки, ТТНБезАвтоправок)
	
	Для Каждого СтрокаТТН Из ПроблемныеСтрокиТТН(Справки) Цикл
		
		Если ТТНБезАвтоправок.Получить(СтрокаТТН.ТТН) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Основание = НайтиОснованиеТТН(СтрокаТТН.ТТН);
		Если Основание = Неопределено Тогда
			ДобавитьВПлан(1, СтрокаТТН.Справка2, "Информация", СтрокаТТН.ТТН, "", "",
				СтрШаблон("Строка %1: не найден документ-основание ТТН — нужна ручная проверка", СтрокаТТН.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		Кандидаты = КандидатыИзОснования(Основание, СтрокаТТН);
		
		Если Кандидаты.Количество() = 0 Тогда
			ДобавитьВПлан(1, СтрокаТТН.Справка2, "Информация", СтрокаТТН.ТТН, "", "",
				СтрШаблон("Строка %1: в документе %2 нет подходящей номенклатуры", СтрокаТТН.НомерСтроки, Основание));
			Продолжить;
		КонецЕсли;
		
		Лучший = Кандидаты[0];
		Отрыв = ?(Кандидаты.Количество() > 1, Лучший.Оценка - Кандидаты[1].Оценка, Лучший.Оценка);
		
		Если Лучший.Оценка >= 40 И Отрыв >= 20 Тогда
			Пояснение = СтрШаблон("Рекомендуется: найдено в %1 (оценка %2)", Основание, Лучший.Оценка);
		Иначе
			Пояснение = СтрШаблон("Неоднозначно: лучший кандидат из %1 (оценка %2, вариантов %3). Проверьте или выберите вручную",
				Основание, Лучший.Оценка, Кандидаты.Количество());
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТТН.ТекущаяНоменклатура) Тогда
			Было = СтрШаблон("Строка %1: %2", СтрокаТТН.НомерСтроки, СтрокаТТН.ТекущаяНоменклатура);
		Иначе
			Было = СтрШаблон("Строка %1: номенклатура не указана", СтрокаТТН.НомерСтроки);
		КонецЕсли;
		
		ДобавитьВПлан(1, СтрокаТТН.Справка2, "ЗаполнениеНоменклатуры", СтрокаТТН.ТТН,
			Было, ПредставлениеКандидата(Лучший), Пояснение,
			Новый Структура("ТТН, НомерСтроки, Номенклатура, Заменить",
				СтрокаТТН.ТТН, СтрокаТТН.НомерСтроки, Лучший.Номенклатура,
				ЗначениеЗаполнено(СтрокаТТН.ТекущаяНоменклатура)));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроблемныеСтрокиТТН(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	СтрокиТТН.Ссылка КАК ТТН,
	|	СтрокиТТН.НомерСтроки КАК НомерСтроки,
	|	СтрокиТТН.#ТТНСправка2# КАК Справка2,
	|	СтрокиТТН.#ТТНАлкопродукция# КАК Алкопродукция,
	|	СтрокиТТН.#ТТНАлкопродукция#.Наименование КАК НаименованиеАлкопродукции,
	|	СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияВидПродукции# КАК Вид,
	|	СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияОбъем# КАК Объем,
	|	СтрокиТТН.#ТТНКоличество# КАК Количество,
	|	СтрокиТТН.#ТТННоменклатура# КАК ТекущаяНоменклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И (СтрокиТТН.#ТТННоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|			ИЛИ СтрокиТТН.#ТТННоменклатура#.#НоменклатураВидПродукции# <> СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияВидПродукции#)"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// ТаблицаЗначений кандидатов (Номенклатура, Наименование, Код, Артикул, Оценка) по убыванию оценки.
// ДанныеСтроки — строка/структура: Алкопродукция, НаименованиеАлкопродукции, Вид, Объем, Количество.
Функция КандидатыИзОснования(Основание, ДанныеСтроки) Экспорт
	
	Описание = ОписаниеДокументаОснования(Основание);
	Имена = ИменаОбъектов();
	
	Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.%3 КАК Номенклатура,
	|	Т.%3.Наименование КАК Наименование,
	|	Т.%3.#НоменклатураВидПродукции# КАК Вид,
	|	Т.%3.#НоменклатураОбъем# КАК Объем,
	|	СУММА(Т.%4) КАК Количество
	|	&ВыборКода
	|	&ВыборАртикула
	|ИЗ
	|	%1.%2 КАК Т
	|ГДЕ
	|	Т.Ссылка = &Основание
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.%3,
	|	Т.%3.Наименование,
	|	Т.%3.#НоменклатураВидПродукции#,
	|	Т.%3.#НоменклатураОбъем#
	|	&ГруппировкаКода
	|	&ГруппировкаАртикула",
		Описание.ПолноеИмя, Описание.ТЧ, Описание.Номенклатура, Описание.Количество);
	
	Текст = ПодставитьНеобязательноеПоле(Текст, "Код", Имена.НоменклатураКод, Описание.Номенклатура);
	Текст = ПодставитьНеобязательноеПоле(Текст, "Артикул", Имена.НоменклатураАртикул, Описание.Номенклатура);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Основание", Основание);
	Строки = Запрос.Выполнить().Выгрузить();
	
	Сопоставленные = НоменклатурыАлкопродукции(ДанныеСтроки.Алкопродукция);
	
	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Номенклатура");
	Кандидаты.Колонки.Добавить("Наименование");
	Кандидаты.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	Кандидаты.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	Кандидаты.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	
	Для Каждого Кандидат Из Строки Цикл
		Оценка = ОценкаКандидата(Кандидат, ДанныеСтроки, Сопоставленные);
		Если Оценка < 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Кандидат);
		НоваяСтрока.Оценка = Оценка;
	КонецЦикла;
	
	Кандидаты.Сортировать("Оценка Убыв");
	Возврат Кандидаты;
	
КонецФункции

// Подставляет в запрос необязательное поле номенклатуры: если имя реквизита в адаптере
// не задано, из запроса убираются и выборка, и группировка по нему.
Функция ПодставитьНеобязательноеПоле(Знач Текст, Псевдоним, ИмяРеквизита, ПутьНоменклатуры)
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Выражение = СтрШаблон("Т.%1.%2", ПутьНоменклатуры, ИмяРеквизита);
		Выбор = ", " + Выражение + " КАК " + Псевдоним;
		Группировка = ", " + Выражение;
	Иначе
		Выбор = "";
		Группировка = "";
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "&Выбор" + Псевдоним, Выбор);
	Текст = СтрЗаменить(Текст, "&Группировка" + Псевдоним, Группировка);
	
	Возврат Текст;
	
КонецФункции

// В ручном процессе сотрудник копирует код номенклатуры из поступления,
// поэтому в плане показываем код и артикул, а не только наименование.
Функция ПредставлениеКандидата(Кандидат) Экспорт
	
	Представление = СтрШаблон("%1", Кандидат.Номенклатура);
	
	Реквизиты = Новый Массив;
	Если ЗначениеЗаполнено(Кандидат.Код) Тогда
		Реквизиты.Добавить("код " + Кандидат.Код);
	КонецЕсли;
	Если ЗначениеЗаполнено(Кандидат.Артикул) Тогда
		Реквизиты.Добавить("артикул " + Кандидат.Артикул);
	КонецЕсли;
	
	Если Реквизиты.Количество() > 0 Тогда
		Представление = Представление + " (" + СтрСоединить(Реквизиты, ", ") + ")";
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// То же, что ПредставлениеКандидата, но по ссылке: в ручном процессе вставляют код номенклатуры.
Функция ПредставлениеНоменклатурыДляПлана(Номенклатура) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	Кандидат = Новый Структура("Номенклатура, Код, Артикул", Номенклатура, "", "");
	Реквизиты = РеквизитыНоменклатурДляПлана(ОбщегоНазначенияКлиентСервер_ЗначениеВМассиве(Номенклатура)).Получить(Номенклатура);
	Если Реквизиты <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Кандидат, Реквизиты);
	КонецЕсли;
	
	Возврат ПредставлениеКандидата(Кандидат);
	
КонецФункции

Функция ОбщегоНазначенияКлиентСервер_ЗначениеВМассиве(Значение)
	
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
	
КонецФункции

// Соответствие: Номенклатура -> Структура("Код, Артикул").
Функция РеквизитыНоменклатурДляПлана(Номенклатуры) Экспорт
	
	Результат = Новый Соответствие;
	Если Номенклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура
	|	&ВыборКода
	|	&ВыборАртикула
	|ИЗ
	|	#ТаблицаНоменклатуры# КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Номенклатуры)";
	
	Текст = СтрЗаменить(Текст, "&ВыборКода",
		?(ЗначениеЗаполнено(Имена.НоменклатураКод), ", Н.#НоменклатураКод# КАК Код", ", """" КАК Код"));
	Текст = СтрЗаменить(Текст, "&ВыборАртикула",
		?(ЗначениеЗаполнено(Имена.НоменклатураАртикул), ", Н.#НоменклатураАртикул# КАК Артикул", ", """" КАК Артикул"));
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Номенклатуры", Номенклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("Код, Артикул", Выборка.Код, Выборка.Артикул));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОценкаКандидата(Кандидат, ДанныеСтроки, Сопоставленные)
	
	Если ЗначениеЗаполнено(Кандидат.Вид) И ЗначениеЗаполнено(ДанныеСтроки.Вид) И Кандидат.Вид <> ДанныеСтроки.Вид Тогда
		Возврат -1;
	КонецЕсли;
	Если НастройкаПроверятьОбъем() И ЗначениеЗаполнено(Кандидат.Объем) И Кандидат.Объем <> ДанныеСтроки.Объем Тогда
		Возврат -1;
	КонецЕсли;
	
	Оценка = 0;
	Если Сопоставленные.Получить(Кандидат.Номенклатура) <> Неопределено Тогда
		Оценка = Оценка + 100;
	КонецЕсли;
	Если Кандидат.Количество = ДанныеСтроки.Количество Тогда
		Оценка = Оценка + 30;
	КонецЕсли;
	Оценка = Оценка + Окр(30 * ПохожестьНаименований(Кандидат.Наименование, ДанныеСтроки.НаименованиеАлкопродукции));
	
	Возврат Оценка;
	
КонецФункции

// Номенклатуры, сопоставленные с алкопродукцией: Соответствие Номенклатура -> Истина.
Функция НоменклатурыАлкопродукции(Алкопродукция) Экспорт
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеНоменклатура# КАК Номенклатура
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция# = &Алкопродукция"));
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Истина);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// 0…1: доля общих значимых слов.
Функция ПохожестьНаименований(Знач А, Знач Б) Экспорт
	
	СловаА = ЗначимыеСлова(А);
	СловаБ = ЗначимыеСлова(Б);
	
	Если СловаА.Количество() = 0 Или СловаБ.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Общих = 0;
	Для Каждого Слово Из СловаА Цикл
		Если СловаБ.Найти(Слово) <> Неопределено Тогда
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Общих / Макс(СловаА.Количество(), СловаБ.Количество());
	
КонецФункции

Функция ЗначимыеСлова(Знач Текст)
	
	Текст = НРег(Текст);
	Разделители = """«»'.,;:()-/\";
	Для Н = 1 По СтрДлина(Разделители) Цикл
		Текст = СтрЗаменить(Текст, Сред(Разделители, Н, 1), " ");
	КонецЦикла;
	
	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Если СтрДлина(Слово) >= 3 И Слова.Найти(Слово) = Неопределено Тогда
			Слова.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;
	
КонецФункции

#КонецОбласти

#Область Кейс1_Крепость

Процедура ДобавитьПланПоКрепости()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	СтрокиТТН.#ТТННоменклатура# КАК Номенклатура,
	|	МИНИМУМ(СтрокиТТН.#ТТНСправка2#) КАК Справка2,
	|	МАКСИМУМ(СтрокиТТН.#ТТННоменклатура#.#НоменклатураКрепость#) КАК КрепостьНоменклатуры,
	|	МИНИМУМ(СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#) КАК КрепостьЕГАИСМин,
	|	МАКСИМУМ(СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#) КАК КрепостьЕГАИСМакс
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И СтрокиТТН.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|	И СтрокиТТН.#ТТННоменклатура#.#НоменклатураКрепость# <> СтрокиТТН.#ТТНАлкопродукция#.#АлкопродукцияКрепость#
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиТТН.#ТТННоменклатура#"));
	Запрос.УстановитьПараметр("Справки", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КрепостьЕГАИСМин <> Выборка.КрепостьЕГАИСМакс Тогда
			ДобавитьВПлан(1, Выборка.Справка2, "Информация", Выборка.Номенклатура, "", "",
				СтрШаблон("Номенклатура сопоставлена с продукцией разной крепости (%1–%2%%). Нужна отдельная номенклатура",
					Выборка.КрепостьЕГАИСМин, Выборка.КрепостьЕГАИСМакс));
			Продолжить;
		КонецЕсли;
		
		ДобавитьВПлан(1, Выборка.Справка2, "ИзменениеКрепости", Выборка.Номенклатура,
			СтрШаблон("Крепость %1%%", Выборка.КрепостьНоменклатуры),
			СтрШаблон("Крепость %1%%", Выборка.КрепостьЕГАИСМин),
			"Крепость номенклатуры не совпадает с алкопродукцией ЕГАИС",
			Новый Структура("Номенклатура, СтараяКрепость, НоваяКрепость",
				Выборка.Номенклатура, Выборка.КрепостьНоменклатуры, Выборка.КрепостьЕГАИСМин));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДействиеИзменитьКрепость(П)
	
	Если Не РазрешитьИзменениеНоменклатуры Тогда
		ВызватьИсключение "Изменение номенклатуры запрещено настройкой «Разрешить изменение номенклатуры».";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	НоменклатураОбъект = П.Номенклатура.ПолучитьОбъект();
	НоменклатураОбъект.Заблокировать();
	
	// Если НоменклатураКрепость — путь через точку, доработать под конфигурацию. УТОЧНИТЬ.
	Если НоменклатураОбъект[Имена.НоменклатураКрепость] <> П.СтараяКрепость Тогда
		ВызватьИсключение "Крепость уже изменилась с момента формирования плана. Сформируйте план заново.";
	КонецЕсли;
	
	НоменклатураОбъект[Имена.НоменклатураКрепость] = П.НоваяКрепость;
	НоменклатураОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область Кейс2_СтатусыМарок

// Кейс 2: статусы марок в 1С не совпадают с ЕГАИС.
// Правила по ответам заказчика (21–22.09):
// — в ЕГАИС два состояния: «В обороте» (→ «В наличии») и «В архиве» (→ «Реализована»);
// — статус меняется свободно, сам не откатывается (меняется только продажей / списанием);
// — сверяем ВСЕ справки акта, не только красные;
// — источник правды — последние полученные остатки ЕГАИС (полный запрос по точке);
// — остатки быстро устаревают (марки продаются), но акт по ним актуален долго:
//   если марка двигалась в 1С ПОСЛЕ даты остатков (основание марки новее) — верим 1С;
// — к списанию: марки на балансе ЕГАИС минус отсканированные при инвентаризации (кейс 5);
// — марки «есть в ЕГАИС, нет в 1С» — запрос марок по справке 2 (кейс 4);
// — подтверждений нет.

#Область Кейс2_Диагностика

// Заполняет в Результаты: ДанныеЕГАИС, НеВЕГАИС, ВЕГАИСНеВНаличии.
Процедура ДополнитьДиагностикуКейс2()
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаркиПоСправкам = МаркиСправокАкта(Результаты.ВыгрузитьКолонку("Справка2"));
	Количества = КоличестваОстатковЕГАИС();
	
	Для Каждого СтрокаРезультата Из Результаты Цикл
		
		// Остатки регистра №1 дают только количество по справке, без кодов марок.
		ДанныеКоличества = Количества.Получить(СтрокаРезультата.Справка2);
		Если ДанныеКоличества <> Неопределено Тогда
			СтрокаРезультата.ЕГАИСКоличество = ДанныеКоличества.Количество;
		КонецЕсли;
		
		ОтветЕГАИС = ОстаткиЕГАИСПоСправке(СтрокаРезультата.Справка2);
		Если ОтветЕГАИС = Неопределено Тогда
			// Коды марок приходят отдельно — «Запросить марки по справкам №2» из документа остатков.
			СтрокаРезультата.ДанныеЕГАИС = ?(ДанныеКоличества = Неопределено, "Нет", "ТолькоКоличество");
			Продолжить;
		КонецЕсли;
		СтрокаРезультата.ДанныеЕГАИС = ?(ОстаткиАктуальны(ОтветЕГАИС), "Есть", "Устарели");
		
		НаБалансе = МножествоКодов(ОтветЕГАИС.Коды);
		Марки = МаркиПоСправкам.Получить(СтрокаРезультата.Справка2);
		Если Марки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ДанныеМарки Из Марки Цикл
			
			Если ДанныеМарки.ДатаОснования > ОтветЕГАИС.Дата Тогда
				Продолжить; // марка двигалась после получения остатков — верим 1С
			КонецЕсли;
			
			ЕстьВЕГАИС = НаБалансе.Получить(ДанныеМарки.КодМарки) <> Неопределено;
			Если ДанныеМарки.СтатусВ1С = "ВНаличии" И Не ЕстьВЕГАИС Тогда
				СтрокаРезультата.НеВЕГАИС = СтрокаРезультата.НеВЕГАИС + 1;
			ИначеЕсли ДанныеМарки.СтатусВ1С <> "ВНаличии" И ЕстьВЕГАИС Тогда
				СтрокаРезультата.ВЕГАИСНеВНаличии = СтрокаРезультата.ВЕГАИСНеВНаличии + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Соответствие: Справка2 -> ТаблицаЗначений (Марка, КодМарки, СтатусВ1С, ДатаОснования).
Функция МаркиСправокАкта(Справки)
	
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	Текст =
	"ВЫБРАТЬ
	|	Марки.#МаркаСправка2# КАК Справка2,
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки,
	|	Марки.#МаркаСтатус# КАК Статус,
	|	ЕСТЬNULL(Марки.#МаркаОснование#.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)";
	// УТОЧНИТЬ: основание марки — всегда документ (ТТН, чек, акт)? Иначе поле Дата недоступно.
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	КартаСтатусов = КартаЛогическихСтатусов();
	Результат = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Таблица = Результат.Получить(Выборка.Справка2);
		Если Таблица = Неопределено Тогда
			Таблица = Новый ТаблицаЗначений;
			Таблица.Колонки.Добавить("Марка");
			Таблица.Колонки.Добавить("КодМарки");
			Таблица.Колонки.Добавить("СтатусВ1С");
			Таблица.Колонки.Добавить("ДатаОснования");
			Результат.Вставить(Выборка.Справка2, Таблица);
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Марка = Выборка.Марка;
		НоваяСтрока.КодМарки = Выборка.КодМарки;
		НоваяСтрока.ДатаОснования = Выборка.ДатаОснования;
		СтатусВ1С = КартаСтатусов.Получить(Выборка.Статус);
		НоваяСтрока.СтатусВ1С = ?(СтатусВ1С = Неопределено, "", СтатусВ1С);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Значение перечисления -> логический статус. Статусы, которых нет в конфигурации, пропускаются.
Функция КартаЛогическихСтатусов()
	
	Карта = Новый Соответствие;
	Для Каждого КлючЗначение Из СоответствиеСтатусов() Цикл
		Значение = ЗначениеСтатуса(КлючЗначение.Ключ);
		Если Значение <> Неопределено Тогда
			Карта.Вставить(Значение, КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;
	
КонецФункции

Функция МножествоКодов(Коды)
	
	Множество = Новый Соответствие;
	Для Каждого Код Из Коды Цикл
		Множество.Вставить(Код, Истина);
	КонецЦикла;
	Возврат Множество;
	
КонецФункции

#КонецОбласти

#Область Кейс2_ОстаткиЕГАИС

// Марки на балансе ЕГАИС по справке из последних полученных остатков.
// Структура("Коды, Дата") или Неопределено, если остатков нет.
Функция ОстаткиЕГАИСПоСправке(Справка2) Экспорт
	
	Если КэшОстатков = Неопределено Тогда
		КэшОстатков = ЗагрузитьОстаткиЕГАИС(Результаты.ВыгрузитьКолонку("Справка2"));
	КонецЕсли;
	
	Ответ = КэшОстатков.Получить(Справка2);
	Если Ответ = Неопределено И КэшОстатков.Получить("_Дата") <> Неопределено И НастройкаОстаткиПолныйСнимок() Тогда
		// Остатки — полный снимок по точке: справки в нём нет — значит, на балансе ни одной марки.
		Ответ = Новый Структура("Коды, Дата", Новый Массив, КэшОстатков.Получить("_Дата"));
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

// Читает коды марок на балансе по каждой справке (регистр №3 — ответ на запрос марок).
// Соответствие: Справка2 -> Структура("Коды, Дата"); ключ "_Дата" — дата самого свежего документа.
// В остатках регистра №1 кодов марок нет, поэтому отсутствие табличной части — норма:
// кейс 2 тогда работает только по количествам (см. ЗагрузитьКоличестваОстатков).
// УТОЧНИТЬ, в какой документ приходит ответ на «Запросить марки по справкам №2».
Функция ЗагрузитьОстаткиЕГАИС(Справки)
	
	Результат = Новый Соответствие;
	Имена = ИменаОбъектов();
	
	Если Не ЗначениеЗаполнено(Имена.ДокументОстатков)
		Или Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков) = Неопределено
		Или Справки.Количество() = 0 Тогда
		Возврат Результат; // источник не настроен — кейс 2 без данных ЕГАИС
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Имена.ТЧОстатковМарки)
		Или Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков).ТабличныеЧасти.Найти(Имена.ТЧОстатковМарки) = Неопределено Тогда
		Возврат Результат; // кодов марок в документе нет — работаем только по количествам
	КонецЕсли;
	
	Текст =
	"ВЫБРАТЬ
	|	Т.#ОстаткиСправка2# КАК Справка2,
	|	МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТПоследние
	|ИЗ
	|	#ДокументОстатков#.#ТЧОстатковМарки# КАК Т
	|ГДЕ
	|	Т.#ОстаткиСправка2# В (&Справки)
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	&УсловияОтбора
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.#ОстаткиСправка2#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.#ОстаткиСправка2# КАК Справка2,
	|	Т.#ОстаткиКодМарки# КАК КодМарки,
	|	П.Дата КАК Дата
	|ИЗ
	|	#ДокументОстатков#.#ТЧОстатковМарки# КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследние КАК П
	|		ПО (Т.#ОстаткиСправка2# = П.Справка2)
	|			И (Т.Ссылка.Дата = П.Дата)";
	Текст = СтрЗаменить(Текст, "&УсловияОтбора", УсловияОтбораОстатков());
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Справки);
	УстановитьПараметрыОтбораОстатков(Запрос);
	
	МаксимальнаяДата = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Ответ = Результат.Получить(Выборка.Справка2);
		Если Ответ = Неопределено Тогда
			Ответ = Новый Структура("Коды, Дата", Новый Массив, Выборка.Дата);
			Результат.Вставить(Выборка.Справка2, Ответ);
		КонецЕсли;
		Ответ.Коды.Добавить(Выборка.КодМарки);
		
		Если МаксимальнаяДата = Неопределено Или Выборка.Дата > МаксимальнаяДата Тогда
			МаксимальнаяДата = Выборка.Дата;
		КонецЕсли;
		
	КонецЦикла;
	
	Если МаксимальнаяДата <> Неопределено Тогда
		Результат.Вставить("_Дата", МаксимальнаяДата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Отбор документов остатков: организация акта, операция «запрос остатков в регистре №1»
// и статус «получены остатки». Без операции подхватим документ регистра №2, без статуса —
// документ с ошибкой получения, в котором данных нет.
Функция УсловияОтбораОстатков()
	
	Имена = ИменаОбъектов();
	Условия = "";
	
	Если ФильтрОрганизацииОстатков() Тогда
		Условия = Условия + Символы.ПС + "	И Т.Ссылка.#ОстаткиОрганизация# = &Организация";
	КонецЕсли;
	Если ЗначениеОперацииРегистр1() <> Неопределено Тогда
		Условия = Условия + Символы.ПС + "	И Т.Ссылка.#ОстаткиОперация# = &ОперацияРегистр1";
	КонецЕсли;
	Если ЗначениеСтатусаОстатковПолучены() <> Неопределено Тогда
		Условия = Условия + Символы.ПС + "	И Т.Ссылка.#ОстаткиСтатус# = &СтатусПолучены";
	КонецЕсли;
	
	Возврат Условия;
	
КонецФункции

Процедура УстановитьПараметрыОтбораОстатков(Запрос)
	
	Если ФильтрОрганизацииОстатков() Тогда
		Запрос.УстановитьПараметр("Организация", Акт[ИменаОбъектов().АктОрганизацияЕГАИС]);
	КонецЕсли;
	Если ЗначениеОперацииРегистр1() <> Неопределено Тогда
		Запрос.УстановитьПараметр("ОперацияРегистр1", ЗначениеОперацииРегистр1());
	КонецЕсли;
	Если ЗначениеСтатусаОстатковПолучены() <> Неопределено Тогда
		Запрос.УстановитьПараметр("СтатусПолучены", ЗначениеСтатусаОстатковПолучены());
	КонецЕсли;
	
КонецПроцедуры

Функция ФильтрОрганизацииОстатков()
	Возврат ЗначениеЗаполнено(ИменаОбъектов().ОстаткиОрганизация) И ЗначениеЗаполнено(Акт);
КонецФункции

Функция ЗначениеОперацииРегистр1() Экспорт
	Имена = ИменаОбъектов();
	Возврат ЗначениеПоАдаптеру(Имена.ОстаткиОперация, Имена.ОстаткиПеречислениеОпераций, Имена.ОстаткиОперацияРегистр1);
КонецФункции

Функция ЗначениеСтатусаОстатковПолучены() Экспорт
	Имена = ИменаОбъектов();
	Возврат ЗначениеПоАдаптеру(Имена.ОстаткиСтатус, Имена.ОстаткиПеречислениеСтатусов, Имена.ОстаткиСтатусПолучены);
КонецФункции

// Количества марок на балансе по справкам из остатков регистра №1.
// В этой табличной части кодов марок нет — только алкопродукция, справка 2 и количество.
// Соответствие: Справка2 -> Структура("Количество, Дата").
Функция КоличестваОстатковЕГАИС() Экспорт
	
	Если КэшКоличеств = Неопределено Тогда
		КэшКоличеств = ЗагрузитьКоличестваОстатков(Результаты.ВыгрузитьКолонку("Справка2"));
	КонецЕсли;
	Возврат КэшКоличеств;
	
КонецФункции

Функция ЗагрузитьКоличестваОстатков(Справки)
	
	Результат = Новый Соответствие;
	Имена = ИменаОбъектов();
	
	МетаДокумент = Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков);
	Если МетаДокумент = Неопределено
		Или Не ЗначениеЗаполнено(Имена.ТЧОстатковКоличества)
		Или МетаДокумент.ТабличныеЧасти.Найти(Имена.ТЧОстатковКоличества) = Неопределено
		Или Справки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Текст =
	"ВЫБРАТЬ
	|	Т.#ОстаткиКолСправка2# КАК Справка2,
	|	МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТПоследние
	|ИЗ
	|	#ДокументОстатков#.#ТЧОстатковКоличества# КАК Т
	|ГДЕ
	|	Т.#ОстаткиКолСправка2# В (&Справки)
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	&УсловияОтбора
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.#ОстаткиКолСправка2#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.#ОстаткиКолСправка2# КАК Справка2,
	|	СУММА(Т.#ОстаткиКолКоличество#) КАК Количество,
	|	П.Дата КАК Дата
	|ИЗ
	|	#ДокументОстатков#.#ТЧОстатковКоличества# КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследние КАК П
	|		ПО (Т.#ОстаткиКолСправка2# = П.Справка2)
	|			И (Т.Ссылка.Дата = П.Дата)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.#ОстаткиКолСправка2#,
	|	П.Дата";
	Текст = СтрЗаменить(Текст, "&УсловияОтбора", УсловияОтбораОстатков());
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справки", Справки);
	УстановитьПараметрыОтбораОстатков(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Справка2, Новый Структура("Количество, Дата", Выборка.Количество, Выборка.Дата));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Последний проведённый/полученный документ остатков регистра №1 по организации акта.
// Из него запускают «Запросить марки» — отдельного запроса по справке нет.
Функция НайтиПоследнийДокументОстатков() Экспорт
	
	Имена = ИменаОбъектов();
	МетаДокумент = Метаданные.НайтиПоПолномуИмени(Имена.ДокументОстатков);
	Если МетаДокумент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Условия = "НЕ Т.ПометкаУдаления";
	Если ФильтрОрганизацииОстатков() Тогда
		Условия = Условия + Символы.ПС + "	И Т.#ОстаткиОрганизация# = &Организация";
	КонецЕсли;
	Если ЗначениеОперацииРегистр1() <> Неопределено Тогда
		Условия = Условия + Символы.ПС + "	И Т.#ОстаткиОперация# = &ОперацияРегистр1";
	КонецЕсли;
	Если ЗначениеСтатусаОстатковПолучены() <> Неопределено Тогда
		Условия = Условия + Символы.ПС + "	И Т.#ОстаткиСтатус# = &СтатусПолучены";
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	#ДокументОстатков# КАК Т
	|ГДЕ
	|	" + Условия + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата УБЫВ"));
	УстановитьПараметрыОтбораОстатков(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

Функция ОстаткиАктуальны(ОтветЕГАИС)
	
	Срок = НастройкаСрокАктуальностиОстатковЧасов();
	Если Срок = 0 Тогда
		Возврат Истина; // без ограничения: от старых остатков защищает проверка даты основания марки
	КонецЕсли;
	Возврат ТекущаяДатаСеанса() - ОтветЕГАИС.Дата <= Срок * 3600;
	
КонецФункции

#КонецОбласти

#Область Кейс2_Сверка

// Заполняет СверкуМарок по справкам. Состояние ЕГАИС — автоматически из полученных остатков.
Процедура ЗаполнитьСверкуМарок(Справки) Экспорт
	
	СверкаМарок.Очистить();
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	ПроверятьЧеки = ЗначениеЗаполнено(Имена.ТаблицаМарокЧеков);
	Чеки = ?(ПроверятьЧеки, КодыМарокВЧеках(Справки), Новый Соответствие);
	Отсканированные = КодыИнвентаризации();
	МаркиПоСправкам = МаркиСправокАкта(Справки);
	
	Для Каждого Справка2 Из Справки Цикл
		
		ОтветЕГАИС = ОстаткиЕГАИСПоСправке(Справка2);
		НаБалансе = ?(ОтветЕГАИС = Неопределено, Неопределено, МножествоКодов(ОтветЕГАИС.Коды));
		КодыВ1С = Новый Соответствие;
		
		Марки = МаркиПоСправкам.Получить(Справка2);
		Если Марки <> Неопределено Тогда
			Для Каждого ДанныеМарки Из Марки Цикл
				
				КодыВ1С.Вставить(ДанныеМарки.КодМарки, Истина);
				
				СтрокаСверки = СверкаМарок.Добавить();
				СтрокаСверки.Справка2 = Справка2;
				СтрокаСверки.Марка = ДанныеМарки.Марка;
				СтрокаСверки.КодМарки = ДанныеМарки.КодМарки;
				СтрокаСверки.СтатусВ1С = ДанныеМарки.СтатусВ1С;
				СтрокаСверки.ДатаДвижения = ДанныеМарки.ДатаОснования;
				СтрокаСверки.ЕстьЧек = Чеки.Получить(ДанныеМарки.КодМарки) <> Неопределено;
				СтрокаСверки.ВИнвентаризации = Отсканированные.Получить(НормализоватьКодМарки(ДанныеМарки.КодМарки)) <> Неопределено;
				
				Если НаБалансе <> Неопределено Тогда
					СтрокаСверки.СостояниеЕГАИС = ?(НаБалансе.Получить(ДанныеМарки.КодМарки) <> Неопределено, "НаБалансе", "НеНаБалансе");
					СтрокаСверки.ДатаОстатков = ОтветЕГАИС.Дата;
					СтрокаСверки.Источник = "Остатки ЕГАИС";
				КонецЕсли;
				
				Если СтрокаСверки.СтатусВ1С = "" Тогда
					СтрокаСверки.Подсказка = "Неизвестный статус — добавить в СоответствиеСтатусов()";
				ИначеЕсли НаБалансе <> Неопределено И СтрокаСверки.ДатаДвижения > ОтветЕГАИС.Дата Тогда
					СтрокаСверки.Подсказка = "Марка двигалась после получения остатков — верим 1С";
				ИначеЕсли ПроверятьЧеки И СтрокаСверки.СтатусВ1С = "Реализована" И Не СтрокаСверки.ЕстьЧек Тогда
					СтрокаСверки.Подсказка = "«Реализована», но проведённого чека с маркой нет";
				ИначеЕсли СтрокаСверки.СтатусВ1С = "ВРезерве" Тогда
					СтрокаСверки.Подсказка = "«В резерве» — всегда по ЕГАИС";
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		// Марки на балансе ЕГАИС, которых нет в 1С (потеря при выгрузке базы или очень старые марки).
		Если ОтветЕГАИС <> Неопределено Тогда
			Для Каждого Код Из ОтветЕГАИС.Коды Цикл
				Если КодыВ1С.Получить(Код) = Неопределено Тогда
					СтрокаСверки = СверкаМарок.Добавить();
					СтрокаСверки.Справка2 = Справка2;
					СтрокаСверки.КодМарки = Код;
					СтрокаСверки.СтатусВ1С = "НетВ1С";
					СтрокаСверки.СостояниеЕГАИС = "НаБалансе";
					СтрокаСверки.ДатаОстатков = ОтветЕГАИС.Дата;
					СтрокаСверки.Источник = "Остатки ЕГАИС";
					СтрокаСверки.ВИнвентаризации = Отсканированные.Получить(НормализоватьКодМарки(Код)) <> Неопределено;
					СтрокаСверки.Подсказка = "Есть на балансе ЕГАИС, нет в 1С — запрос марок по справке 2 (кейс 4)";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	СверкаМарок.Сортировать("Справка2, Подсказка Убыв, КодМарки");
	
КонецПроцедуры

// Коды марок из проведённых чеков. Соответствие КодМарки -> Истина.
Функция КодыМарокВЧеках(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЧМ.#ЧекМаркаКод# КАК Код
	|ИЗ
	|	#ТаблицаМарокЧеков# КАК ЧМ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ТаблицаМарок# КАК Марки
	|		ПО (Марки.#МаркаКод# = ЧМ.#ЧекМаркаКод#)
	|ГДЕ
	|	ЧМ.Ссылка.Проведен
	|	И Марки.#МаркаСправка2# В (&Справки)"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Код, Истина);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Кнопка «Обновить из остатков ЕГАИС»: дозаполняет СостояниеЕГАИС, где оно пустое.
Процедура ЗаполнитьСверкуИзОтветаРегистра3() Экспорт
	
	Для Каждого СтрокаСверки Из СверкаМарок Цикл
		Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
			Продолжить;
		КонецЕсли;
		ОтветЕГАИС = ОстаткиЕГАИСПоСправке(СтрокаСверки.Справка2);
		Если ОтветЕГАИС = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСверки.СостояниеЕГАИС = ?(ОтветЕГАИС.Коды.Найти(СтрокаСверки.КодМарки) <> Неопределено, "НаБалансе", "НеНаБалансе");
		СтрокаСверки.ДатаОстатков = ОтветЕГАИС.Дата;
		СтрокаСверки.Источник = "Остатки ЕГАИС";
	КонецЦикла;
	
КонецПроцедуры

// Состояние марки по тексту с check1: "НаБалансе", "НеНаБалансе" или "" (не распознано).
// На check1 видно «Статус продукции» и «Последнее движение», причём по ответу заказчика
// «Списание чеком» и «Списание актом» для 1С одно и то же — бутылка реализована,
// а «На остатках по чеку возврата» и «На остатках по акту подтверждения» — не реализована.
// Можно вставить и весь блок ответа целиком: ищем знакомые куски текста.
Функция СостояниеПоПоследнемуДвижению(Знач Текст) Экспорт
	
	Текст = НРег(СокрЛП(Текст));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	// Явный статус продукции надёжнее движения — если он есть в тексте, верим ему.
	Если СтрНайти(Текст, "в архиве") > 0 Тогда
		Возврат "НеНаБалансе";
	ИначеЕсли СтрНайти(Текст, "в обороте") > 0 Тогда
		Возврат "НаБалансе";
	ИначеЕсли СтрНайти(Текст, "списан") > 0 Тогда
		Возврат "НеНаБалансе"; // списание чеком или актом
	ИначеЕсли СтрНайти(Текст, "на остатках") > 0 Тогда
		Возврат "НаБалансе";  // чек возврата или акт подтверждения
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Пересчитывает состояние ЕГАИС по введённому вручную последнему движению (check1).
// Возвращает текст подсказки для строки сверки.
Функция ПрименитьПоследнееДвижение(СтрокаСверки) Экспорт
	
	Состояние = СостояниеПоПоследнемуДвижению(СтрокаСверки.ПоследнееДвижение);
	
	Если Не ЗначениеЗаполнено(Состояние) Тогда
		Возврат "Движение не распознано — выберите состояние ЕГАИС вручную";
	КонецЕсли;
	
	СтрокаСверки.СостояниеЕГАИС = Состояние;
	СтрокаСверки.ДатаОстатков = ТекущаяДатаСеанса();
	СтрокаСверки.Источник = "check1 (движение)";
	
	Возврат СтрШаблон("check1: %1", ПредставлениеСостоянияЕГАИС(Состояние));
	
КонецФункции

#КонецОбласти

#Область Кейс2_УТМ

// Резервный источник: проверка марки в кеше УТМ 4 (если у точек УТМ 4).
Процедура ПроверитьСверкуПоУТМ() Экспорт
	
	Для Каждого СтрокаСверки Из СверкаМарок Цикл
		
		Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОшибки = "";
		Состояние = ЗапросСостоянияМаркиУТМ(СтрокаСверки.КодМарки, ТекстОшибки);
		
		Если ЗначениеЗаполнено(Состояние) Тогда
			СтрокаСверки.СостояниеЕГАИС = Состояние;
			СтрокаСверки.ДатаОстатков = ТекущаяДатаСеанса();
			СтрокаСверки.Источник = "Кеш УТМ";
		Иначе
			СтрокаСверки.Подсказка = Лев("УТМ: " + ТекстОшибки, 200);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// "НаБалансе", "НеНаБалансе" или "" (с текстом ошибки). В безопасном режиме HTTP может быть запрещён.
Функция ЗапросСостоянияМаркиУТМ(КодМарки, ТекстОшибки)
	
	Настройки = НастройкиУТМ();
	
	Если Не ЗначениеЗаполнено(Настройки.ПутьПроверкиМарки) Тогда
		ТекстОшибки = "не задан путь проверки марки (НастройкиУТМ, УТОЧНИТЬ)";
		Возврат "";
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(Настройки.Адрес, Настройки.Порт, , , , Настройки.Таймаут);
		Адрес = СтрЗаменить(Настройки.ПутьПроверкиМарки, "{mark}",
			КодироватьСтроку(КодМарки, СпособКодированияСтроки.КодировкаURL));
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Адрес));
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = "HTTP " + Ответ.КодСостояния;
		Возврат "";
	КонецЕсли;
	
	Возврат РазобратьОтветПроверкиМарки(Ответ.ПолучитьТелоКакСтроку(), ТекстОшибки);
	
КонецФункции

// УТОЧНИТЬ: формат ответа УТМ 4.
Функция РазобратьОтветПроверкиМарки(ТелоОтвета, ТекстОшибки)
	
	ТекстОшибки = "разбор ответа УТМ не реализован (УТОЧНИТЬ формат)";
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область Кейс2_План

Процедура СформироватьПланКейс2()
	
	Справки = СправкиКейса(2);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Сверку перезаполняем, только если она пуста: ручные состояния (УТМ / check1) не теряем.
	Если СверкаМарок.Количество() = 0 Тогда
		ЗаполнитьСверкуМарок(Справки);
	КонецЕсли;
	
	Матрица = МатрицаСтатусов();
	
	Для Каждого Справка2 Из Справки Цикл
		
		СтрокаРезультата = Результаты.Найти(Справка2, "Справка2");
		
		Если СтрокаРезультата.ДанныеЕГАИС = "Нет" И Не ЕстьРучныеСостояния(Справка2) Тогда
			ДобавитьВПлан(2, Справка2, "Информация", Справка2, "", "",
				"Нет полученных остатков по этой справке — запросите остатки из регистра №1 и повторите диагностику");
			Продолжить;
		КонецЕсли;
		
		Автоматически = СтрокаРезультата.ДанныеЕГАИС = "Есть";
		Если СтрокаРезультата.ДанныеЕГАИС = "Устарели" Тогда
			ДобавитьВПлан(2, Справка2, "Информация", Справка2, "", "",
				"Остатки ЕГАИС старше заданного срока — изменения предложены, но не применяются автоматически");
		КонецЕсли;
		
		КСписанию = 0;
		НаБалансеВсего = 0;
		Отсканировано = 0;
		ОтсканированоВсего = 0;
		НужноЗапроситьМарки = Ложь;
		
		Для Каждого СтрокаСверки Из СверкаМарок.НайтиСтроки(Новый Структура("Справка2", Справка2)) Цикл
			
			Если СтрокаСверки.ВИнвентаризации Тогда
				ОтсканированоВсего = ОтсканированоВсего + 1;
			КонецЕсли;
			
			Если СтрокаСверки.СостояниеЕГАИС = "НаБалансе" Тогда
				НаБалансеВсего = НаБалансеВсего + 1;
				Если СтрокаСверки.ВИнвентаризации Тогда
					Отсканировано = Отсканировано + 1;
				Иначе
					КСписанию = КСписанию + 1;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаСверки.СтатусВ1С = "НетВ1С" Тогда
				НужноЗапроситьМарки = Истина;
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
				Продолжить;
			КонецЕсли;
			
			// Марка двигалась в 1С после получения остатков (продана, списана, пришла) — верим 1С.
			Если ЗначениеЗаполнено(СтрокаСверки.ДатаОстатков) И СтрокаСверки.ДатаДвижения > СтрокаСверки.ДатаОстатков Тогда
				Продолжить;
			КонецЕсли;
			
			Правила = Матрица.НайтиСтроки(Новый Структура("СостояниеЕГАИС, СтатусВ1С",
				СтрокаСверки.СостояниеЕГАИС, СтрокаСверки.СтатусВ1С));
			Если Правила.Количество() = 0 Или Не ЗначениеЗаполнено(Правила[0].НовыйСтатус) Тогда
				Продолжить; // статус уже соответствует ЕГАИС
			КонецЕсли;
			
			Отметить = Автоматически Или СтрокаСверки.Источник = "Кеш УТМ"
				Или СтрНачинаетсяС(СтрокаСверки.Источник, "check1");
			
			ДобавитьПланСменыСтатуса(СтрокаСверки, Правила[0].НовыйСтатус,
				СтрШаблон("ЕГАИС: %1 (%2 от %3)", ПредставлениеСостоянияЕГАИС(СтрокаСверки.СостояниеЕГАИС),
					СтрокаСверки.Источник, Формат(СтрокаСверки.ДатаОстатков, "ДФ='dd.MM.yyyy HH:mm'")), Отметить);
			
		КонецЦикла;
		
		// Коды марок не получены: в остатках регистра №1 только количество по справке.
		// Запрос марок по справке 2 запускается из документа полученных остатков. УТОЧНИТЬ.
		Если СтрокаРезультата.ДанныеЕГАИС = "ТолькоКоличество" И Не ЕстьРучныеСостояния(Справка2) Тогда
			ДобавитьВПлан(2, Справка2, "Информация", Справка2,
				СтрШаблон("В 1С «в наличии»: %1", СтрокаРезультата.ВНаличии),
				СтрШаблон("По ЕГАИС на балансе: %1", СтрокаРезультата.ЕГАИСКоличество),
				"Кодов марок нет — запросите марки по этой справке 2 из документа полученных остатков, иначе статусы сверить не с чем");
		КонецЕсли;
		
		// Марки есть в ЕГАИС, но нет в 1С. Если после запроса марок они так и не появились —
		// это чужая или очень старая марка, её «не найдёте» (ответ заказчика 6).
		Если НужноЗапроситьМарки Тогда
			ДобавитьВПлан(2, Справка2, "Информация", Справка2,
				"Часть марок есть в ЕГАИС, но нет в 1С", "",
				"Запросите остатки и марки заново. Если марки не появятся — разбор вручную по регламенту");
		КонецЕсли;
		
		// Контроль количества (ответ заказчика 2): к списанию = на балансе ЕГАИС минус отсканированные.
		// Если не сканировали — списываем всё, что ЕГАИС числит на балансе.
		// Когда кодов нет, баланс берём числом из регистра №1.
		Если СтрокаРезультата.ДанныеЕГАИС = "ТолькоКоличество" Тогда
			НаБалансеВсего = СтрокаРезультата.ЕГАИСКоличество;
			Отсканировано = ОтсканированоВсего;
			КСписанию = Макс(НаБалансеВсего - Отсканировано, 0);
		КонецЕсли;
		
		Если СтрокаРезультата.ДанныеЕГАИС <> "Нет" И КСписанию <> СтрокаРезультата.ТребуетсяМарок Тогда
			ДобавитьВПлан(2, Справка2, "Информация", Справка2,
				СтрШаблон("В акте: %1", СтрокаРезультата.ТребуетсяМарок),
				СтрШаблон("По ЕГАИС к списанию: %1", КСписанию),
				СтрШаблон("На балансе ЕГАИС %1, отсканировано при инвентаризации %2, к списанию %3 — "
					+ "количество в строке акта не совпадает, поправьте строку до отправки",
					НаБалансеВсего, Отсканировано, КСписанию));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеСостоянияЕГАИС(Состояние) Экспорт
	Если Состояние = "НаБалансе" Тогда
		Возврат "В обороте";
	ИначеЕсли Состояние = "НеНаБалансе" Тогда
		Возврат "В архиве";
	КонецЕсли;
	Возврат Состояние;
КонецФункции

Функция ЕстьРучныеСостояния(Справка2)
	
	Для Каждого СтрокаСверки Из СверкаМарок.НайтиСтроки(Новый Структура("Справка2", Справка2)) Цикл
		Если ЗначениеЗаполнено(СтрокаСверки.СостояниеЕГАИС) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьПланСменыСтатуса(СтрокаСверки, НовыйСтатус, Основание, Отметить)
	
	ДобавитьВПлан(2, СтрокаСверки.Справка2, "СменаСтатуса", СтрокаСверки.Марка,
		СтрШаблон("%1: %2", СтрокаСверки.КодМарки, СтрокаСверки.СтатусВ1С),
		НовыйСтатус, Основание,
		Новый Структура("Марка, КодМарки, СтарыйСтатус, НовыйСтатус",
			СтрокаСверки.Марка, СтрокаСверки.КодМарки, СтрокаСверки.СтатусВ1С, НовыйСтатус));
	
	ПланИзменений[ПланИзменений.Количество() - 1].Подтверждено = Отметить;
	
КонецПроцедуры

#КонецОбласти

#Область Кейс2_Действие

// Параметры: Марка, КодМарки, СтарыйСтатус, НовыйСтатус (логические).
Процедура ДействиеСменитьСтатус(П)
	
	Если Не РазрешитьСменуСтатусов Тогда
		ВызватьИсключение "Смена статусов запрещена настройкой «Разрешить смену статусов».";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	НовоеЗначение = ЗначениеСтатуса(П.НовыйСтатус);
	Если НовоеЗначение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Статуса «%1» нет в конфигурации (см. СоответствиеСтатусов).", П.НовыйСтатус);
	КонецЕсли;
	
	Если МаркиВСправочнике() Тогда
		
		МаркаОбъект = П.Марка.ПолучитьОбъект();
		МаркаОбъект.Заблокировать();
		ПроверитьСтарыйСтатус(МаркаОбъект[Имена.МаркаСтатус], П);
		МаркаОбъект[Имена.МаркаСтатус] = НовоеЗначение;
		МаркаОбъект.Записать();
		
	Иначе
		
		// Регистр сведений: отбор по коду марки. УТОЧНИТЬ состав измерений.
		ИмяРегистра = СтрЗаменить(Имена.ТаблицаМарок, "РегистрСведений.", "");
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор[Имена.МаркаКод].Установить(П.КодМарки);
		Набор.Прочитать();
		
		Если Набор.Количество() <> 1 Тогда
			ВызватьИсключение СтрШаблон("Для марки %1 найдено записей: %2 (ожидалась 1).", П.КодМарки, Набор.Количество());
		КонецЕсли;
		
		ПроверитьСтарыйСтатус(Набор[0][Имена.МаркаСтатус], П);
		Набор[0][Имена.МаркаСтатус] = НовоеЗначение;
		Набор.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтарыйСтатус(ТекущееЗначение, П)
	
	Если ЛогическийСтатус(ТекущееЗначение) <> П.СтарыйСтатус Тогда
		ВызватьИсключение "Статус марки изменился с момента формирования плана. Сформируйте план заново.";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Кейс5_Инвентаризация

// Кейс 5: марки, отсканированные при инвентаризации, физически в магазине — не списываем.
// Файл .1ct сохраняют после инвентаризации (к базе отношения не имеет).
// Формат файла — УТОЧНИТЬ по образцу; пока разбор — черновик.

// Соответствие КодМарки -> Истина из табличной части ОтсканированныеМарки.
Функция КодыИнвентаризации() Экспорт
	
	Коды = Новый Соответствие;
	Для Каждого СтрокаМарки Из ОтсканированныеМарки Цикл
		Нормализованный = НормализоватьКодМарки(СтрокаМарки.КодМарки);
		Если ЗначениеЗаполнено(Нормализованный) Тогда
			Коды.Вставить(Нормализованный, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;
	
КонецФункции

// Истина, если марка есть в файле инвентаризации (физически в магазине — не списываем).
Функция МаркаВИнвентаризации(КодМарки) Экспорт
	Возврат КодыИнвентаризации().Получить(НормализоватьКодМарки(КодМарки)) <> Неопределено;
КонецФункции

// Код из файла и из 1С могут отличаться разделителями GS1 и пробелами.
Функция НормализоватьКодМарки(Знач Код) Экспорт
	
	Код = СокрЛП(Строка(Код));
	Код = СтрЗаменить(Код, Символ(29), ""); // FNC1 / GS
	Код = СтрЗаменить(Код, Символы.НПП, "");
	Код = СтрЗаменить(Код, " ", "");
	Возврат Код;
	
КонецФункции

// Загружает коды марок из файла инвентаризации. Возвращает количество загруженных кодов.
Функция ЗагрузитьФайлИнвентаризации(ДвоичныеДанные, ИмяФайла) Экспорт
	
	Текст = ТекстИзДвоичныхДанных(ДвоичныеДанные);
	Коды = КодыМарокИзТекста(Текст);
	
	ОтсканированныеМарки.Очистить();
	Для Каждого Код Из Коды Цикл
		ОтсканированныеМарки.Добавить().КодМарки = НормализоватьКодМарки(Код);
	КонецЦикла;
	ФайлИнвентаризации = ИмяФайла;
	СохранитьИнвентаризацию();
	
	Возврат Коды.Количество();
	
КонецФункции

// UTF-8, при признаках «кракозябр» — windows-1251.
Функция ТекстИзДвоичныхДанных(ДвоичныеДанные)
	
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Если СтрНайти(Текст, Символ(65533)) > 0 Тогда
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "windows-1251");
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

// ЧЕРНОВИК до получения образца .1ct: выбираем из текста фрагменты, похожие на коды марок.
// Старые марки (PDF417) — 68 символов, новые (DataMatrix) — около 150.
// УТОЧНИТЬ: разделители, формат строк, совпадает ли код с кодом марки в 1С (МаркаКод).
Функция КодыМарокИзТекста(Знач Текст) Экспорт
	
	Для Каждого Разделитель Из СтрРазделить(Символы.ВК + "|" + Символы.Таб + "|;|,|""", "|") Цикл
		Текст = СтрЗаменить(Текст, Разделитель, Символы.ПС);
	КонецЦикла;
	
	Коды = Новый Массив;
	Уникальные = Новый Соответствие;
	
	Для Каждого Фрагмент Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		
		Код = СокрЛП(Фрагмент);
		// На скрине таблица «Акцизные марки»: последняя колонка — сам код.
		Если СтрНайти(Код, Символы.Таб) > 0 Тогда
			Части = СтрРазделить(Код, Символы.Таб, Ложь);
			Код = СокрЛП(Части[Части.ВГраница()]);
		КонецЕсли;
		Код = НормализоватьКодМарки(Код);
		
		Если ЭтоКодАкцизнойМарки(Код) И Уникальные.Получить(Код) = Неопределено Тогда
			Уникальные.Вставить(Код, Истина);
			Коды.Добавить(Код);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Коды;
	
КонецФункции

Функция ЭтоКодАкцизнойМарки(Код)
	
	Длина = СтрДлина(Код);
	Если Длина < 68 Тогда
		Возврат Ложь;
	КонецЕсли;
	// На скрине коды начинаются с 19 (PDF417) или 32 (DataMatrix).
	Возврат Истина;
	
КонецФункции

Процедура СохранитьИнвентаризацию() Экспорт
	
	ХранилищеОбщихНастроек.Сохранить("ПомощникАктаЕГАИС", "ОтсканированныеМарки", ОтсканированныеМарки.Выгрузить());
	ХранилищеОбщихНастроек.Сохранить("ПомощникАктаЕГАИС", "ФайлИнвентаризации", ФайлИнвентаризации);
	
КонецПроцедуры

Процедура ЗагрузитьИнвентаризацию() Экспорт
	
	Сохраненная = ХранилищеОбщихНастроек.Загрузить("ПомощникАктаЕГАИС", "ОтсканированныеМарки");
	Если ТипЗнч(Сохраненная) = Тип("ТаблицаЗначений") Тогда
		ОтсканированныеМарки.Загрузить(Сохраненная);
	КонецЕсли;
	ИмяФайла = ХранилищеОбщихНастроек.Загрузить("ПомощникАктаЕГАИС", "ФайлИнвентаризации");
	Если ТипЗнч(ИмяФайла) = Тип("Строка") Тогда
		ФайлИнвентаризации = ИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьИнвентаризацию() Экспорт
	
	ОтсканированныеМарки.Очистить();
	ФайлИнвентаризации = "";
	СохранитьИнвентаризацию();
	
КонецПроцедуры

#КонецОбласти


#Область Кейс3_СоответствиеНоменклатуры

// Кейс 3: у алкопродукции нет ни одного соответствия номенклатуры.
// Правила по ответам заказчика (21.09):
// — соответствие общее: алкопродукция → номенклатура, справка 2 не участвует;
// — номенклатуру только выбираем из существующих, новую не создаём;
// — одна алкопродукция может иметь несколько номенклатур — это допустимо;
// — источник номенклатуры у специалиста — акцизная марка (у марки есть номенклатура);
// — создавать соответствия могут только администраторы;
// — подтверждений нет: однозначные случаи применяются автоматически,
//   неоднозначные уходят в «Требует ручного решения».

Процедура СформироватьПланКейс3()
	
	Справки = СправкиКейса(3);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаАП Из НесопоставленныеАлкопродукции(Справки) Цикл
		
		Решение = РешениеПоКандидатам(КандидатыДляСоответствия(СтрокаАП));
		ПараметрыДействия = Новый Структура("Алкопродукция, Номенклатура, Справки",
			СтрокаАП.Алкопродукция, Решение.Номенклатура, Справки);
		
		Если Решение.Надежно Тогда
			ДобавитьВПлан(3, СтрокаАП.Справка2, "СозданиеСоответствия", СтрокаАП.Алкопродукция,
				"Соответствия нет", ПредставлениеНоменклатурыДляПлана(Решение.Номенклатура),
				СтрШаблон("Автоматически: %1 (оценка %2)", Решение.Источник, Решение.Оценка),
				ПараметрыДействия);
			ПланИзменений[ПланИзменений.Количество() - 1].Подтверждено = Истина;
		Иначе
			// Не отмечаем. Администратор выбирает номенклатуру кнопкой «Выбрать номенклатуру»
			// и вставляет её, как в ручном процессе вставляет код.
			ДобавитьВПлан(3, СтрокаАП.Справка2, "СозданиеСоответствия", СтрокаАП.Алкопродукция,
				"Соответствия нет", "Требует ручного решения", Решение.Пояснение,
				ПараметрыДействия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НесопоставленныеАлкопродукции(Справки)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеАлкопродукция# КАК Алкопродукция
	|ПОМЕСТИТЬ ВТСопоставленные
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Марки.#МаркаАлкопродукция# КАК Алкопродукция,
	|	Марки.#МаркаАлкопродукция#.Наименование КАК НаименованиеАлкопродукции,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции# КАК Вид,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем# КАК Объем,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияКрепость# КАК Крепость,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияПроизводитель# КАК Производитель,
	|	МИНИМУМ(Марки.#МаркаСправка2#) КАК Справка2
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСопоставленные КАК Сопоставленные
	|		ПО (Сопоставленные.Алкопродукция = Марки.#МаркаАлкопродукция#)
	|ГДЕ
	|	Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаАлкопродукция# <> ЗНАЧЕНИЕ(#ТаблицаАлкопродукции#.ПустаяСсылка)
	|	И Сопоставленные.Алкопродукция ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаАлкопродукция#,
	|	Марки.#МаркаАлкопродукция#.Наименование,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияВидПродукции#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияОбъем#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияКрепость#,
	|	Марки.#МаркаАлкопродукция#.#АлкопродукцияПроизводитель#"));
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// ТаблицаЗначений: Номенклатура, Оценка, Источник — по убыванию оценки, без дублей.
Функция КандидатыДляСоответствия(СтрокаАП)
	
	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Номенклатура");
	Кандидаты.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	Кандидаты.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	Кандидаты.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	
	// 0. «Сопоставлено в ИБ» на карточке алкопродукции — то, что специалист копирует в регистр.
	ДобавитьКандидатаИзКарточкиАлкопродукции(Кандидаты, СтрокаАП.Алкопродукция);
	
	// 1. Номенклатура в акцизных марках этой алкопродукции — так делает специалист.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Марки.#МаркаНоменклатура# КАК Номенклатура,
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК Марок
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаНоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Марки.#МаркаНоменклатура#"));
	Запрос.УстановитьПараметр("Алкопродукция", СтрокаАП.Алкопродукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 90,
			СтрШаблон("номенклатура в акцизных марках (%1 шт.)", Выборка.Марок));
	КонецЦикла;
	
	// 2. Строки ТТН с этой алкопродукцией и заполненной номенклатурой.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиТТН.#ТТННоменклатура# КАК Номенклатура
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНАлкопродукция# = &Алкопродукция
	|	И СтрокиТТН.#ТТННоменклатура# <> ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)"));
	Запрос.УстановитьПараметр("Алкопродукция", СтрокаАП.Алкопродукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 80, "строка ТТН с этой алкопродукцией");
	КонецЦикла;
	
	// 3. «Родственная» алкопродукция (вид, объём, крепость, производитель) с похожим наименованием.
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Соотв.#СоответствиеНоменклатура# КАК Номенклатура,
	|	Соотв.#СоответствиеАлкопродукция#.Наименование КАК Наименование
	|ИЗ
	|	#РегистрСоответствий# КАК Соотв
	|ГДЕ
	|	Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияВидПродукции# = &Вид
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияОбъем# = &Объем
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияКрепость# = &Крепость
	|	И Соотв.#СоответствиеАлкопродукция#.#АлкопродукцияПроизводитель# = &Производитель"));
	Запрос.УстановитьПараметр("Вид", СтрокаАП.Вид);
	Запрос.УстановитьПараметр("Объем", СтрокаАП.Объем);
	Запрос.УстановитьПараметр("Крепость", СтрокаАП.Крепость);
	Запрос.УстановитьПараметр("Производитель", СтрокаАП.Производитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПохожестьНаименований(Выборка.Наименование, СтрокаАП.НаименованиеАлкопродукции) >= 0.6 Тогда
			ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, 60, "родственная алкопродукция");
		КонецЕсли;
	КонецЦикла;
	
	// 4. Поиск по наименованию в справочнике номенклатуры.
	ДобавитьКандидатовПоНаименованию(Кандидаты, СтрокаАП);
	
	ОтфильтроватьКандидатовПоВиду(Кандидаты, СтрокаАП);
	ЗаполнитьКодИАртикулКандидатов(Кандидаты);
	Кандидаты.Сортировать("Оценка Убыв");
	
	Возврат Кандидаты;
	
КонецФункции

// Надёжно: лучший кандидат ≥ 60 баллов и отрыв от второго ≥ 20.
Функция РешениеПоКандидатам(Кандидаты)
	
	Решение = Новый Структура("Надежно, Номенклатура, Оценка, Источник, Пояснение", Ложь, Неопределено, 0, "", "");
	
	Если Кандидаты.Количество() = 0 Тогда
		Решение.Пояснение = "Подходящей номенклатуры не найдено — выбрать вручную (новую номенклатуру создают на сервере)";
		Возврат Решение;
	КонецЕсли;
	
	Лучший = Кандидаты[0];
	Отрыв = ?(Кандидаты.Количество() > 1, Лучший.Оценка - Кандидаты[1].Оценка, Лучший.Оценка);
	
	Решение.Номенклатура = Лучший.Номенклатура;
	Решение.Оценка = Лучший.Оценка;
	Решение.Источник = Лучший.Источник;
	Решение.Надежно = Лучший.Оценка >= 60 И Отрыв >= 20;
	
	Если Не Решение.Надежно Тогда
		Варианты = Новый Массив;
		Для Индекс = 0 По Мин(2, Кандидаты.Количество() - 1) Цикл
			Варианты.Добавить(СтрШаблон("%1 (%2, %3)", ПредставлениеКандидата(Кандидаты[Индекс]),
				Кандидаты[Индекс].Оценка, Кандидаты[Индекс].Источник));
		КонецЦикла;
		Решение.Номенклатура = Неопределено; // не угадываем
		Решение.Пояснение = "Неоднозначно, варианты: " + СтрСоединить(Варианты, "; ");
	КонецЕсли;
	
	Возврат Решение;
	
КонецФункции

Процедура ДобавитьКандидата(Кандидаты, Номенклатура, Оценка, Источник)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Существующий = Кандидаты.Найти(Номенклатура, "Номенклатура");
	Если Существующий = Неопределено Тогда
		НовыйКандидат = Кандидаты.Добавить();
		НовыйКандидат.Номенклатура = Номенклатура;
		НовыйКандидат.Оценка = Оценка;
		НовыйКандидат.Источник = Источник;
	ИначеЕсли Оценка > Существующий.Оценка Тогда
		Существующий.Оценка = Оценка;
		Существующий.Источник = Источник;
	КонецЕсли;
	
КонецПроцедуры

// Поле «Сопоставлено в ИБ» на карточке алкопродукции (скрин кейса 3, шаг 2).
Процедура ДобавитьКандидатаИзКарточкиАлкопродукции(Кандидаты, Алкопродукция)
	
	ИмяРеквизита = ИменаОбъектов().АлкопродукцияСопоставленоВИБ;
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКандидата(Кандидаты, ОбщегоНазначения_ЗначениеРеквизита(Алкопродукция, ИмяРеквизита),
		95, "сопоставлено в ИБ на карточке алкопродукции");
	
КонецПроцедуры

Процедура ЗаполнитьКодИАртикулКандидатов(Кандидаты)
	
	Реквизиты = РеквизитыНоменклатурДляПлана(Кандидаты.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Значения = Реквизиты.Получить(Кандидат.Номенклатура);
		Если Значения <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Кандидат, Значения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКандидатовПоНаименованию(Кандидаты, СтрокаАП)
	
	Ключ = "";
	Для Каждого Слово Из ЗначимыеСлова(СтрокаАП.НаименованиеАлкопродукции) Цикл
		Если СтрДлина(Слово) > СтрДлина(Ключ) Тогда
			Ключ = Слово;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Наименование КАК Наименование
	|ИЗ
	|	#ТаблицаНоменклатуры# КАК Н
	|ГДЕ
	|	Н.Наименование ПОДОБНО &Шаблон
	|	И НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа")); // УТОЧНИТЬ: убрать условие, если справочник без групп
	Запрос.УстановитьПараметр("Шаблон", "%" + Ключ + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Оценка = Окр(40 * ПохожестьНаименований(Выборка.Наименование, СтрокаАП.НаименованиеАлкопродукции));
		Если Оценка > 0 Тогда
			ДобавитьКандидата(Кандидаты, Выборка.Номенклатура, Оценка, "поиск по наименованию");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтфильтроватьКандидатовПоВиду(Кандидаты, СтрокаАП)
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н.#НоменклатураВидПродукции# КАК Вид,
	|	Н.#НоменклатураОбъем# КАК Объем
	|ИЗ
	|	#ТаблицаНоменклатуры# КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Номенклатуры)"));
	Запрос.УстановитьПараметр("Номенклатуры", Кандидаты.ВыгрузитьКолонку("Номенклатура"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Отбросить = ЗначениеЗаполнено(Выборка.Вид) И ЗначениеЗаполнено(СтрокаАП.Вид) И Выборка.Вид <> СтрокаАП.Вид;
		Если Не Отбросить И НастройкаПроверятьОбъем() Тогда
			Отбросить = ЗначениеЗаполнено(Выборка.Объем) И Выборка.Объем <> СтрокаАП.Объем;
		КонецЕсли;
		
		Если Отбросить Тогда
			Кандидаты.Удалить(Кандидаты.Найти(Выборка.Номенклатура, "Номенклатура"));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры: Алкопродукция, Номенклатура, Справки (массив справок кейса 3 акта).
Процедура ДействиеСоздатьСоответствие(П)
	
	Если Не ЭтоАдминистратор() Тогда
		ВызватьИсключение "Создавать соответствия номенклатуры могут только администраторы.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(П.Номенклатура) Тогда
		ВызватьИсключение "Номенклатура не выбрана — требуется ручное решение (кнопка «Выбрать номенклатуру»).";
	КонецЕсли;
	
	// 1. Соответствие общее: алкопродукция → номенклатура, справку 2 не заполняем
	// (ответ заказчика). В форме записи ещё бывают период, характеристика, упаковка
	// и идентификатор упаковки — пишем только то, что есть в адаптере и в метаданных.
	Если НоменклатурыАлкопродукции(П.Алкопродукция).Получить(П.Номенклатура) = Неопределено Тогда
		ЗаписатьСоответствиеНоменклатуры(П.Алкопродукция, П.Номенклатура);
	КонецЕсли;
	
	// 2. Номенклатура в марках этой АП, где она пустая.
	ЗаполнитьНоменклатуруМарок(П.Алкопродукция, П.Номенклатура, П.Справки);
	
	// 3. При необходимости — перепровести ТТН с дозаполнением.
	Если НастройкаПослеСоответствия() = "ЗаполнитьМаркиИПерепровестиТТН" Тогда
		Для Каждого ТТН Из ТТНПоСправкамИАлкопродукции(П.Справки, П.Алкопродукция) Цикл
			// Неподтверждённую ТТН не трогаем, но и всё действие из-за неё не валим:
			// соответствие и номенклатура в марках уже записаны и полезны сами по себе.
			Если Не ТТНПодтверждена(ТТН) Тогда
				ЗаписьЖурналаРегистрации("ПомощникАктаЕГАИС.ПроведениеТТН",
					УровеньЖурналаРегистрации.Предупреждение, , ТТН,
					"ТТН пропущена: статус не «Подтверждена», проведение могло бы отправить акт в ЕГАИС");
				Продолжить;
			КонецЕсли;
			ДействиеПерепровестиДокумент(ТТН, Новый Структура("Дозаполнить", Истина));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Запись в регистр «Соответствие номенклатуры ЕГАИС» так, как специалист делает через «Создать».
Процедура ЗаписатьСоответствиеНоменклатуры(Алкопродукция, Номенклатура)
	
	Имена = ИменаОбъектов();
	ИмяРегистра = СтрЗаменить(Имена.РегистрСоответствий, "РегистрСведений.", "");
	МетаРегистр = Метаданные.РегистрыСведений[ИмяРегистра];
	
	Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	Запись[Имена.СоответствиеАлкопродукция] = Алкопродукция;
	Запись[Имена.СоответствиеНоменклатура] = Номенклатура;
	
	Если МетаРегистр.Периодичность <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Запись.Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	УстановитьНеобязательноеПолеЗаписи(Запись, МетаРегистр, Имена.СоответствиеИдентификаторУпаковки, "");
	УстановитьНеобязательноеПолеЗаписи(Запись, МетаРегистр, Имена.СоответствиеХарактеристика, Неопределено);
	УстановитьНеобязательноеПолеЗаписи(Запись, МетаРегистр, Имена.СоответствиеУпаковка, Неопределено);
	
	Запись.Записать(Истина);
	
КонецПроцедуры

Процедура УстановитьНеобязательноеПолеЗаписи(Запись, МетаРегистр, ИмяПоля, Значение)
	
	Если Не ЗначениеЗаполнено(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПоле = МетаРегистр.Измерения.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Ресурсы.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Реквизиты.Найти(ИмяПоля) <> Неопределено;
	Если Не ЕстьПоле Тогда
		Возврат;
	КонецЕсли;
	
	Запись[ИмяПоля] = Значение;
	
КонецПроцедуры

// Заполняет номенклатуру в марках справок акта, где она пустая.
// Непустую чужую номенклатуру не трогаем — это кейс 1 (неверная номенклатура).
Процедура ЗаполнитьНоменклатуруМарок(Алкопродукция, Номенклатура, Справки)
	
	Имена = ИменаОбъектов();
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	
	Текст =
	"ВЫБРАТЬ
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаСправка2# В (&Справки)
	|	И Марки.#МаркаНоменклатура# = ЗНАЧЕНИЕ(#ТаблицаНоменклатуры#.ПустаяСсылка)";
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	Запрос.УстановитьПараметр("Справки", Справки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если МаркиВСправочнике() Тогда
			МаркаОбъект = Выборка.Марка.ПолучитьОбъект();
			МаркаОбъект.Заблокировать();
			МаркаОбъект[Имена.МаркаНоменклатура] = Номенклатура;
			МаркаОбъект.Записать();
		Иначе
			ИмяРегистра = СтрЗаменить(Имена.ТаблицаМарок, "РегистрСведений.", "");
			Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Набор.Отбор[Имена.МаркаКод].Установить(Выборка.КодМарки);
			Набор.Прочитать();
			Для Каждого ЗаписьНабора Из Набор Цикл
				ЗаписьНабора[Имена.МаркаНоменклатура] = Номенклатура;
			КонецЦикла;
			Набор.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// ТТН ищем по справке 2 в строках ТТН, а не по основанию марки:
// основание марки меняется (ТТН → чек → акт списания).
Функция ТТНПоСправкамИАлкопродукции(Справки, Алкопродукция)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиТТН.Ссылка КАК ТТН
	|ИЗ
	|	#ДокументТТН#.#ТЧТТН# КАК СтрокиТТН
	|ГДЕ
	|	СтрокиТТН.#ТТНСправка2# В (&Справки)
	|	И СтрокиТТН.#ТТНАлкопродукция# = &Алкопродукция"));
	Запрос.УстановитьПараметр("Справки", Справки);
	Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТТН");
	
КонецФункции

// "ЗаполнитьМарки" — только соответствие и номенклатура в марках (по умолчанию);
// "ЗаполнитьМаркиИПерепровестиТТН" — дополнительно перепровести ТТН с дозаполнением.
// УТОЧНИТЬ на копии базы, чего достаточно, чтобы марки перестали быть красными в акте.
Функция НастройкаПослеСоответствия() Экспорт
	Возврат "ЗаполнитьМарки";
КонецФункции

// Администратор: роль полных прав. УТОЧНИТЬ имена ролей в конфигурации.
Функция ЭтоАдминистратор() Экспорт
	
	Для Каждого ИмяРоли Из СтрРазделить("ПолныеПрава,АдминистраторСистемы", ",") Цикл
		Если Метаданные.Роли.Найти(ИмяРоли) <> Неопределено И РольДоступна(ИмяРоли) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

#КонецОбласти


#Область Кейс4_НетМарок

Процедура СформироватьПланКейс4()
	
	Справки = СправкиКейса(4);
	Если Справки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьПланПерепривязки(Справки);
	
	КЗапросу = Новый Массив;
	
	Для Каждого Справка2 Из Справки Цикл
		
		Если ОчередьЗапросов.НайтиСтроки(Новый Структура("Справка2", Справка2)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = Результаты.Найти(Справка2, "Справка2");
		ДанныеЕГАИС = ?(СтрокаРезультата = Неопределено, "", СтрокаРезультата.ДанныеЕГАИС);
		КоличествоЕГАИС = ?(СтрокаРезультата = Неопределено, 0, СтрокаРезультата.ЕГАИСКоличество);
		
		// Без документа остатков запрашивать марки неоткуда: команда живёт в «Остатки ЕГАИС».
		Если ДанныеЕГАИС = "Нет" Тогда
			ДобавитьВПлан(4, Справка2, "Информация", Справка2, "Марок нет", "",
				"Сначала получите остатки регистра №1, затем в документе остатков — «Запросить марки»");
			Продолжить;
		КонецЕсли;
		
		// В остатках 0 — на балансе ЕГАИС пусто, запрос марок ничего не пришлёт
		// (часто после обнуления точки).
		Если (ДанныеЕГАИС = "Есть" Или ДанныеЕГАИС = "ТолькоКоличество") И КоличествоЕГАИС = 0 Тогда
			ДобавитьВПлан(4, Справка2, "Информация", Справка2, "Марок нет", "В остатках ЕГАИС: 0",
				"На балансе ЕГАИС по справке пусто — запрос марок ничего не даст. Часто после обнуления точки");
			Продолжить;
		КонецЕсли;
		
		КЗапросу.Добавить(Справка2);
		
	КонецЦикла;
	
	Если КЗапросу.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПрогнозМин = КЗапросу.Количество() * НастройкиОчереди().ИнтервалОтправкиМин;
	Пояснение = СтрШаблон(
		"Один запрос из документа остатков: справки выбрать нельзя. ЕГАИС присылает ~1 справку / %1 мин. Прогноз ≈ %2 мин",
		НастройкиОчереди().ИнтервалОтправкиМин, ПрогнозМин);
	
	Для Каждого Справка2 Из КЗапросу Цикл
		ДобавитьВПлан(4, Справка2, "ЗапросМарок", Справка2, "Марок нет", "В очереди запросов",
			Пояснение, Новый Структура("Справка2, Кейс", Справка2, 4));
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПланПерепривязки(Справки)
	
	Имена = ИменаОбъектов();
	ПолеСсылки = ?(МаркиВСправочнике(), "Марки.Ссылка", "НЕОПРЕДЕЛЕНО");
	
	Текст =
	"ВЫБРАТЬ
	|	&ПолеСсылки КАК Марка,
	|	Марки.#МаркаКод# КАК КодМарки,
	|	Марки.#МаркаСправка2# КАК СтараяСправка
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаАлкопродукция# = &Алкопродукция
	|	И Марки.#МаркаСтатус# = &СтатусВНаличии
	|	И НЕ Марки.#МаркаСправка2# В (&СправкиАкта)";
	Текст = СтрЗаменить(Текст, "&ПолеСсылки", ПолеСсылки);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("СтатусВНаличии", ЗначениеСтатуса("ВНаличии"));
	Запрос.УстановитьПараметр("СправкиАкта", Результаты.ВыгрузитьКолонку("Справка2"));
	
	Для Каждого Справка2 Из Справки Цикл
		
		Алкопродукция = Справка2[Имена.Справка2Алкопродукция];
		Если Не ЗначениеЗаполнено(Алкопродукция) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = Результаты.Найти(Справка2, "Справка2");
		Нужно = ?(СтрокаРезультата = Неопределено, 0, СтрокаРезультата.ТребуетсяМарок);
		
		Запрос.УстановитьПараметр("Алкопродукция", Алкопродукция);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Добавлено = 0;
		Пока Добавлено < Нужно И Выборка.Следующий() Цикл
			ДобавитьВПлан(4, Справка2, "ПерепривязкаМарки", Выборка.Марка,
				СтрШаблон("%1: справка %2", Выборка.КодМарки, Выборка.СтараяСправка),
				СтрШаблон("справка %1", Справка2),
				"Гипотеза: марка на старой справке после обнуления точки — ПРОВЕРИТЬ перед применением",
				Новый Структура("Марка, КодМарки, СтараяСправка, НоваяСправка",
					Выборка.Марка, Выборка.КодМарки, Выборка.СтараяСправка, Справка2));
			Добавлено = Добавлено + 1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДействиеПерепривязатьМарку(П)
	
	Если Не РазрешитьПерепривязку Тогда
		ВызватьИсключение "Перепривязка марок запрещена настройкой «Разрешить перепривязку» (сначала проверить гипотезу на реальном примере).";
	КонецЕсли;
	
	Имена = ИменаОбъектов();
	
	Если МаркиВСправочнике() Тогда
		МаркаОбъект = П.Марка.ПолучитьОбъект();
		МаркаОбъект.Заблокировать();
		Если МаркаОбъект[Имена.МаркаСправка2] <> П.СтараяСправка Тогда
			ВызватьИсключение "Справка марки изменилась с момента формирования плана.";
		КонецЕсли;
		МаркаОбъект[Имена.МаркаСправка2] = П.НоваяСправка;
		МаркаОбъект.Записать();
	Иначе
		ВызватьИсключение "Перепривязка для марок в регистре сведений не реализована (УТОЧНИТЬ структуру).";
	КонецЕсли;
	
КонецПроцедуры

Процедура ДействиеПоставитьВОчередь(П)
	
	Если ОчередьЗапросов.НайтиСтроки(Новый Структура("Справка2", П.Справка2)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОчереди = ОчередьЗапросов.Добавить();
	СтрокаОчереди.Справка2 = П.Справка2;
	СтрокаОчереди.Кейс = П.Кейс;
	СтрокаОчереди.Приоритет = ?(Результаты.Найти(П.Справка2, "Справка2") <> Неопределено, 1, 10);
	СтрокаОчереди.Статус = "Ожидает";
	
	СохранитьОчередь();
	
КонецПроцедуры

// Вызывается обработчиком ожидания формы.
Процедура ОбработатьОчередь() Экспорт
	
	Настройки = НастройкиОчереди();
	Сейчас = ТекущаяДатаСеанса();
	
	// 1. Проверка отправленных.
	Для Каждого СтрокаОчереди Из ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Отправлен")) Цикл
		
		Количество = КоличествоМарокПоСправке(СтрокаОчереди.Справка2);
		
		Если Количество > 0 Тогда
			СтрокаОчереди.Статус = "Получен";
			СтрокаОчереди.ДатаОтвета = Сейчас;
			СтрокаОчереди.МарокПолучено = Количество;
			
		ИначеЕсли Сейчас - СтрокаОчереди.ДатаОтправки > Настройки.ТаймаутЧасов * 3600 Тогда
			// Повторно весь документ остатков не шлём: это снова запросит все справки
			// и растянет ожидание. Нет марок за таймаут = нет их и на сервере.
			СтрокаОчереди.Статус = "НетОтвета";
			СтрокаОчереди.Комментарий = "Марок нет и в ЕГАИС / нет ответа — ручное решение по регламенту";
		КонецЕсли;
		
	КонецЦикла;
	
	// 2. Одна отправка на всю пачку: в документе остатков справки выбрать нельзя
	// (скрин кейса 4), ЕГАИС сам присылает по одной ~раз в полчаса.
	Ожидающие = ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Ожидает"));
	УжеОтправленные = ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Отправлен"));
	
	Если Ожидающие.Количество() > 0 И УжеОтправленные.Количество() = 0 Тогда
		
		Попытка
			ОтправитьЗапросМарокИзОстатков();
			Для Каждого СтрокаОчереди Из Ожидающие Цикл
				СтрокаОчереди.Статус = "Отправлен";
				СтрокаОчереди.ДатаОтправки = Сейчас;
				СтрокаОчереди.Попыток = СтрокаОчереди.Попыток + 1;
				СтрокаОчереди.Комментарий = "Запрос из документа остатков, ждём марки в 1С";
			КонецЦикла;
		Исключение
			ТекстОшибки = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 200);
			Для Каждого СтрокаОчереди Из Ожидающие Цикл
				СтрокаОчереди.Комментарий = ТекстОшибки;
			КонецЦикла;
		КонецПопытки;
		
	КонецЕсли;
	
	ОбновитьОписанияКейса4();
	СохранитьОчередь();
	
КонецПроцедуры

Функция КоличествоМарокПоСправке(Справка2)
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Марки.#МаркаКод#) КАК Количество
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# = &Справка2"));
	Запрос.УстановитьПараметр("Справка2", Справка2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);
	
КонецФункции

// Запрос марок — команда документа «Остатки ЕГАИС», не отдельный запрос по справке.
// Справки выбрать нельзя: ЕГАИС сам присылает по одной ~раз в 30 минут.
// УТОЧНИТЬ имя типовой процедуры команды «Запросить марки по справкам №2».
Процедура ОтправитьЗапросМарокИзОстатков()
	
	Если Не РазрешитьОтправкуЗапросов Тогда
		ВызватьИсключение "Отправка запросов в УТМ запрещена настройкой «Разрешить отправку запросов».";
	КонецЕсли;
	
	ДокументОстатков = НайтиПоследнийДокументОстатков();
	Если Не ЗначениеЗаполнено(ДокументОстатков) Тогда
		ВызватьИсключение "Нет полученных остатков регистра №1 — сначала запросите остатки, потом марки.";
	КонецЕсли;
	
	// УДАЛИТЬ после подстановки типового вызова ниже.
	ВызватьИсключение СтрШаблон(
		"Отправка «Запросить марки» не реализована: подставить типовую команду документа остатков %1 (УТОЧНИТЬ).",
		ДокументОстатков);
	
	// ДокументОбъект = ДокументОстатков.ПолучитьОбъект();
	// <типовая процедура команды «Запросить марки по справкам №2»>(ДокументОбъект);
	
КонецПроцедуры

Процедура ОбновитьОписанияКейса4()
	
	Для Каждого СтрокаОчереди Из ОчередьЗапросов Цикл
		СтрокаРезультата = Результаты.Найти(СтрокаОчереди.Справка2, "Справка2");
		Если СтрокаРезультата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаОчереди.Статус = "НетОтвета" Тогда
			СтрокаРезультата.Описание = СтрокаОчереди.Комментарий;
		ИначеЕсли СтрокаОчереди.Статус = "Отправлен" Или СтрокаОчереди.Статус = "Ожидает" Тогда
			СтрокаРезультата.Описание = "Марки запрошены в ЕГАИС: " + СтрокаОчереди.Статус;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрогнозОжиданияМин() Экспорт
	
	Осталось = ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Ожидает")).Количество()
		+ ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Отправлен")).Количество();
	Возврат Осталось * НастройкиОчереди().ИнтервалОтправкиМин;
	
КонецФункции

Процедура СохранитьОчередь() Экспорт
	ХранилищеОбщихНастроек.Сохранить("ПомощникАктаЕГАИС", "ОчередьЗапросов", ОчередьЗапросов.Выгрузить());
КонецПроцедуры

Процедура ЗагрузитьОчередь() Экспорт
	
	Сохраненная = ХранилищеОбщихНастроек.Загрузить("ПомощникАктаЕГАИС", "ОчередьЗапросов");
	Если ТипЗнч(Сохраненная) = Тип("ТаблицаЗначений") Тогда
		ОчередьЗапросов.Загрузить(Сохраненная);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьПолученныеИзОчереди() Экспорт
	
	Для Каждого СтрокаОчереди Из ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Получен")) Цикл
		ОчередьЗапросов.Удалить(СтрокаОчереди);
	КонецЦикла;
	СохранитьОчередь();
	
КонецПроцедуры

#КонецОбласти

#Область АктСписания

Процедура СформироватьПланАкта()
	
	Для Каждого СтрокаРезультата Из Результаты Цикл
		
		Если СтрокаРезультата.Статус <> "Готово" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПерезаполнятьТолькоИсправленные
			И ИсправленныеСправки.Найти(СтрокаРезультата.Справка2, "Справка2") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МаркиКСписанию = МаркиСправкиКСписанию(СтрокаРезультата.Справка2);
		НеСписываем = СтрокаРезультата.ВНаличии - МаркиКСписанию.Количество();
		Если МаркиКСписанию.Количество() = 0 И НеСписываем > 0 Тогда
			ДобавитьВПлан(0, СтрокаРезультата.Справка2, "Информация", Акт,
				СтрШаблон("В наличии %1", СтрокаРезультата.ВНаличии), "Списывать нечего",
				"Все марки справки есть в файле инвентаризации — физически в магазине, в акт не кладём");
			Продолжить;
		КонецЕсли;
		Пояснение = "Пересборка строки справки в акте";
		Если НеСписываем > 0 Тогда
			Пояснение = СтрШаблон("К списанию %1, в магазине по инвентаризации %2 — их в акт не кладём",
				МаркиКСписанию.Количество(), НеСписываем);
		КонецЕсли;
		
		ДобавитьВПлан(0, СтрокаРезультата.Справка2, "ЗаполнениеСтрокиАкта", Акт,
			"Строки справки в акте", СтрШаблон("1 строка, %1 марок", МаркиКСписанию.Количество()),
			Пояснение, Новый Структура("Справка2", СтрокаРезультата.Справка2));
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры: Справка2. Идемпотентно: удаляет строки справки и собирает заново.
Процедура ДействиеЗаполнитьСтрокуАкта(П)
	
	Имена = ИменаОбъектов();
	
	АктОбъект = Акт.ПолучитьОбъект();
	АктОбъект.Заблокировать();
	
	Если АктОбъект.Проведен Тогда
		ВызватьИсключение "Акт проведён. Отмените проведение вручную и повторите.";
	КонецЕсли;
	
	Товары = АктОбъект[Имена.ТЧАктаТовары];
	МаркиАкта = АктОбъект[Имена.ТЧАктаМарки];
	
	СтрокиСправки = Товары.НайтиСтроки(Новый Структура(Имена.АктСправка2, П.Справка2));
	Если СтрокиСправки.Количество() = 0 Тогда
		ВызватьИсключение "Справки нет в акте.";
	КонецЕсли;
	
	// Шаблон строки — по первой строке справки.
	Шаблон = Новый Структура;
	Для Каждого Колонка Из Товары.ВыгрузитьКолонки().Колонки Цикл
		Если Колонка.Имя <> "НомерСтроки" Тогда
			Шаблон.Вставить(Колонка.Имя, СтрокиСправки[0][Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	КлючиСправки = Новый Массив;
	КоличествоВАкте = 0;
	Для Каждого СтрокаТовара Из СтрокиСправки Цикл
		КлючиСправки.Добавить(СтрокаТовара[Имена.АктТоварыКлючСвязи]);
		КоличествоВАкте = КоличествоВАкте + СтрокаТовара[Имена.АктКоличество];
		Товары.Удалить(СтрокаТовара);
	КонецЦикла;
	
	// Удаление марок справки — обход с конца.
	Индекс = МаркиАкта.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если КлючиСправки.Найти(МаркиАкта[Индекс][Имена.АктМаркиКлючСвязи]) <> Неопределено Тогда
			МаркиАкта.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Марки = МаркиСправкиКСписанию(П.Справка2);
	Если Марки.Количество() = 0 Тогда
		ВызватьИсключение "По справке нечего списывать: все марки «в наличии» есть в файле инвентаризации (физически в магазине).";
	КонецЕсли;
	
	НовыйКлюч = НовыйКлючСвязи(Товары, Имена.АктТоварыКлючСвязи);
	
	НоваяСтрока = Товары.Добавить();
	Для Каждого КлючЗначение Из Шаблон Цикл
		НоваяСтрока[КлючЗначение.Ключ] = КлючЗначение.Значение;
	КонецЦикла;
	НоваяСтрока[Имена.АктТоварыКлючСвязи] = НовыйКлюч;
	НоваяСтрока[Имена.АктКоличество] = Марки.Количество();
	
	Для Каждого Марка Из Марки Цикл
		СтрокаМарки = МаркиАкта.Добавить();
		СтрокаМарки[Имена.АктМаркиКлючСвязи] = НовыйКлюч;
		СтрокаМарки[Имена.АктМаркиЗначение] = Марка;
	КонецЦикла;
	
	Ошибки = ОшибкиАкта(АктОбъект, П.Справка2);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Акт не прошёл проверку: " + СтрСоединить(Ошибки, "; ");
	КонецЕсли;
	
	АктОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

// Марки справки со статусом «В наличии», которых нет в файле инвентаризации.
Функция МаркиСправкиКСписанию(Справка2) Экспорт
	
	ПолеЗначения = ?(НастройкаЗначениеМаркиВАкте() = "Ссылка" И МаркиВСправочнике(),
		"Марки.Ссылка", "Марки.#МаркаКод#");
	
	Текст =
	"ВЫБРАТЬ
	|	&ПолеЗначения КАК Значение,
	|	Марки.#МаркаКод# КАК КодМарки
	|ИЗ
	|	#ТаблицаМарок# КАК Марки
	|ГДЕ
	|	Марки.#МаркаСправка2# = &Справка2
	|	И Марки.#МаркаСтатус# = &СтатусВНаличии";
	Текст = СтрЗаменить(Текст, "&ПолеЗначения", ПолеЗначения);
	
	Запрос = Новый Запрос(ПодготовитьТекстЗапроса(Текст));
	Запрос.УстановитьПараметр("Справка2", Справка2);
	Запрос.УстановитьПараметр("СтатусВНаличии", ЗначениеСтатуса("ВНаличии"));
	
	Отсканированные = КодыИнвентаризации();
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Отсканированные.Получить(НормализоватьКодМарки(Выборка.КодМарки)) = Неопределено Тогда
			Результат.Добавить(Выборка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйКлючСвязи(Товары, ИмяКлюча)
	
	ТипКлюча = НастройкаТипКлючаСвязи();
	
	Если ТипКлюча = "УникальныйИдентификатор" Тогда
		Возврат Новый УникальныйИдентификатор;
	ИначеЕсли ТипКлюча = "Строка" Тогда
		Возврат Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Максимум = 0;
	Для Каждого СтрокаТовара Из Товары Цикл
		Максимум = Макс(Максимум, СтрокаТовара[ИмяКлюча]);
	КонецЦикла;
	Возврат Максимум + 1;
	
КонецФункции

// Массив текстов ошибок. Пустой — акт в порядке.
Функция ОшибкиАкта(АктОбъект, ФильтрСправки = Неопределено) Экспорт
	
	Имена = ИменаОбъектов();
	Товары = АктОбъект[Имена.ТЧАктаТовары];
	МаркиАкта = АктОбъект[Имена.ТЧАктаМарки];
	Ошибки = Новый Массив;
	
	СтрокПоСправке = Новый Соответствие;
	КлючиТоваров = Новый Соответствие;
	Для Каждого СтрокаТовара Из Товары Цикл
		СправкаСтроки = СтрокаТовара[Имена.АктСправка2];
		Если ФильтрСправки <> Неопределено И СправкаСтроки <> ФильтрСправки Тогда
			Продолжить;
		КонецЕсли;
		СтрокПоСправке.Вставить(СправкаСтроки, ?(СтрокПоСправке.Получить(СправкаСтроки) = Неопределено, 1, СтрокПоСправке.Получить(СправкаСтроки) + 1));
		КлючиТоваров.Вставить(СтрокаТовара[Имена.АктТоварыКлючСвязи], СтрокаТовара);
	КонецЦикла;
	Для Каждого КлючЗначение Из СтрокПоСправке Цикл
		Если КлючЗначение.Значение > 1 Тогда
			Ошибки.Добавить(СтрШаблон("Справка %1: строк в акте %2 (должна быть 1)", КлючЗначение.Ключ, КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	МарокПоКлючу = Новый Соответствие;
	ВсеМарки = Новый Соответствие;
	Для Каждого СтрокаМарки Из МаркиАкта Цикл
		
		Ключ = СтрокаМарки[Имена.АктМаркиКлючСвязи];
		Значение = СтрокаМарки[Имена.АктМаркиЗначение];
		
		Если ФильтрСправки <> Неопределено И КлючиТоваров.Получить(Ключ) = Неопределено Тогда
			Продолжить; // чужая справка — её не проверяем в этом вызове
		КонецЕсли;
		
		Если КлючиТоваров.Получить(Ключ) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("Марка %1 не привязана ни к одной строке товара", Значение));
		КонецЕсли;
		
		Если ВсеМарки.Получить(Значение) <> Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("Марка %1 в акте дважды", Значение));
		КонецЕсли;
		ВсеМарки.Вставить(Значение, Истина);
		
		МарокПоКлючу.Вставить(Ключ, ?(МарокПоКлючу.Получить(Ключ) = Неопределено, 1, МарокПоКлючу.Получить(Ключ) + 1));
		
	КонецЦикла;
	
	// УТОЧНИТЬ: предполагается количество в строке акта в штуках.
	Для Каждого КлючЗначение Из КлючиТоваров Цикл
		СтрокаТовара = КлючЗначение.Значение;
		Марок = ?(МарокПоКлючу.Получить(КлючЗначение.Ключ) = Неопределено, 0, МарокПоКлючу.Получить(КлючЗначение.Ключ));
		Если Марок <> СтрокаТовара[Имена.АктКоличество] Тогда
			Ошибки.Добавить(СтрШаблон("Справка %1: количество %2, марок %3",
				СтрокаТовара[Имена.АктСправка2], СтрокаТовара[Имена.АктКоличество], Марок));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Функция ПроверитьАкт() Экспорт
	Возврат ОшибкиАкта(Акт.ПолучитьОбъект());
КонецФункции

#КонецОбласти

#Область ПроверкаМетаданных

Процедура ПроверитьОбъект(ПолноеИмя, Ошибки)
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат;
	КонецЕсли;
	Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		Ошибки.Добавить("Не найден объект: " + ПолноеИмя);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьТабличнуюЧасть(ПолноеИмя, ИмяТЧ, Ошибки)
	
	Мета = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Мета.ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон("Нет табличной части %1 у %2", ИмяТЧ, ПолноеИмя));
	КонецЕсли;
	
КонецПроцедуры

// Для путей через точку ("Вид.Код") проверяется только первый сегмент.
Процедура ПроверитьРеквизит(ПолноеИмя, Знач ИмяРеквизита, Ошибки, ИмяТЧ = "")
	
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	ИмяРеквизита = СтрРазделить(ИмяРеквизита, ".")[0];
	
	Мета = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТЧ) Тогда
		МетаТЧ = Мета.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Найден = МетаТЧ.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Или ИмяРеквизита = "НомерСтроки";
		Где = ПолноеИмя + "." + ИмяТЧ;
	Иначе
		Найден = ЕстьПолеУОбъекта(Мета, ИмяРеквизита);
		Где = ПолноеИмя;
	КонецЕсли;
	
	Если Не Найден Тогда
		Ошибки.Добавить(СтрШаблон("Нет реквизита %1 у %2", ИмяРеквизита, Где));
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьПолеУОбъекта(Мета, Имя)
	
	Если Мета.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтандартныйРеквизит Из Мета.СтандартныеРеквизиты Цикл
		Если СтандартныйРеквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		Если Мета.Измерения.Найти(Имя) <> Неопределено
			Или Мета.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		// не регистр
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецЕсли
