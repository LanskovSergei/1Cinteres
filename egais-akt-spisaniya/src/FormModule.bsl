#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ЛимитПакета = 50;
	Объект.ПерезаполнятьТолькоИсправленные = Истина;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗагрузитьОчередь();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	НастроитьОформлениеРезультатов();
	ОбновитьПрогноз(ОбработкаОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОбработатьОчередьОбработчик", 60);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьАдаптер(Команда)
	
	Ошибки = ПроверитьАдаптерНаСервере();
	
	Если Ошибки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Адаптер в порядке: все объекты и реквизиты найдены.");
	Иначе
		ПоказатьПредупреждение(, "Найдены расхождения (" + Ошибки.Количество() + "):"
			+ Символы.ПС + СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Акт) Тогда
		ПоказатьПредупреждение(, "Выберите акт списания.");
		Возврат;
	КонецЕсли;
	
	ДиагностикаНаСервере();
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаДиагностика;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПлан(Команда)
	
	Если Объект.Результаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала выполните диагностику.");
		Возврат;
	КонецЕсли;
	
	СформироватьПланНаСервере();
	
	Если Объект.ПланИзменений.Количество() = 0 И Объект.СверкаМарок.Количество() > 0 Тогда
		// Кейс 2: сверка заполнена, нужно получить состояния ЕГАИС.
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаСверка;
		ПоказатьПредупреждение(, "Заполнена сверка марок. Получите состояния ЕГАИС (УТМ / регистр 3 / check1) и снова нажмите «Сформировать план».");
	Иначе
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПлан;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПодтвержденные(Команда)
	
	Отмечено = Объект.ПланИзменений.НайтиСтроки(Новый Структура("Подтверждено, Выполнено", Истина, Ложь)).Количество();
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных строк плана.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПрименитьПодтвержденныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		СтрШаблон("Применить отмеченные изменения (%1)? Они будут записаны в базу и в журнал регистрации.", Отмечено),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПодтвержденныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьНаСервере();
	ДиагностикаНаСервере(); // после исправлений могут всплыть другие кейсы
	
	Ошибок = 0;
	Для Каждого СтрокаПлана Из Объект.ПланИзменений Цикл
		Если СтрокаПлана.Подтверждено И Не СтрокаПлана.Выполнено Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Ошибок > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон("Не применено строк: %1. Причины — в колонке «Результат».", Ошибок));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъект(Команда)
	
	ТекущиеДанные = Элементы.ПланИзменений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьНоменклатуру(Команда)
	
	ТекущиеДанные = Элементы.ПланИзменений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ТипДействия <> "ЗаполнениеНоменклатуры"
		И ТекущиеДанные.ТипДействия <> "СозданиеСоответствия" Тогда
		ПоказатьПредупреждение(, "Выбор номенклатуры доступен только для строк заполнения номенклатуры и создания соответствия.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьНоменклатуруЗавершение", ЭтотОбъект, ТекущиеДанные.ПолучитьИдентификатор());
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", // УТОЧНИТЬ имя справочника
		Новый Структура("РежимВыбора", Истина), ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьНоменклатуруЗавершение(Результат, Идентификатор) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьНоменклатуруВСтрокеПлана(Идентификатор, Результат);
	
КонецПроцедуры

// --- Сверка марок (кейс 2) ---

&НаКлиенте
Процедура ПроверитьПоУТМ(Команда)
	ПроверитьПоУТМНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВзятьОтветРегистра3(Команда)
	ВзятьОтветРегистра3НаСервере();
КонецПроцедуры

// Код марки виден в таблице — пользователь копирует его, вводит капчу на сайте
// и выбирает результат в колонке «Состояние ЕГАИС».
&НаКлиенте
Процедура ОткрытьCheck1(Команда)
	ПерейтиПоНавигационнойСсылке("https://check1.fsrar.ru");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСверку(Команда)
	Объект.СверкаМарок.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура СверкаМарокСостояниеЕГАИСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СверкаМарок.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Источник = "check1 (вручную)";
	КонецЕсли;
	
КонецПроцедуры

// --- Очередь запросов (кейс 4) ---

&НаКлиенте
Процедура ОбработатьСейчас(Команда)
	ОбработатьОчередьОбработчик();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПолученные(Команда)
	ОчиститьПолученныеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОчередьОбработчик() Экспорт
	
	Если Объект.ОчередьЗапросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БылоПолучено = Объект.ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Получен")).Количество();
	ОбработатьОчередьНаСервере();
	СталоПолучено = Объект.ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Получен")).Количество();
	
	// Пришли марки — повторная диагностика: могут всплыть кейсы 1–3.
	Если СталоПолучено > БылоПолучено И ЗначениеЗаполнено(Объект.Акт) Тогда
		ДиагностикаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

// --- Акт ---

&НаКлиенте
Процедура ПроверитьАктКоманда(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Акт) Тогда
		ПоказатьПредупреждение(, "Выберите акт списания.");
		Возврат;
	КонецЕсли;
	
	Ошибки = ПроверитьАктНаСервере();
	Если Ошибки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Акт в порядке.");
	Иначе
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАкт(Команда)
	
	Если ЗначениеЗаполнено(Объект.Акт) Тогда
		ПоказатьЗначение(, Объект.Акт);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеВызовы

&НаСервере
Функция ПроверитьАдаптерНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ПроверитьАдаптер();
КонецФункции

&НаСервере
Процедура ДиагностикаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыполнитьДиагностику();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПланНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СформироватьПлан();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПрименитьПлан();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНоменклатуруВСтрокеПлана(Идентификатор, Номенклатура)
	
	СтрокаПлана = Объект.ПланИзменений.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаПлана = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	П = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
	П.Вставить("Номенклатура", Номенклатура);
	
	СтрокаПлана.ПараметрыСтрокой = ЗначениеВСтрокуВнутр(П);
	СтрокаПлана.Стало = СтрШаблон("%1", Номенклатура);
	СтрокаПлана.Основание = "Выбрано вручную";
	СтрокаПлана.Подтверждено = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПоУТМНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПроверитьСверкуПоУТМ();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ВзятьОтветРегистра3НаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьСверкуИзОтветаРегистра3();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОчередьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ОбработатьОчередь();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ОбновитьПрогноз(ОбработкаОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПолученныеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.УдалитьПолученныеИзОчереди();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ОбновитьПрогноз(ОбработкаОбъект);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьАктНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ПроверитьАкт();
КонецФункции

&НаСервере
Процедура ОбновитьПрогноз(ОбработкаОбъект)
	
	Минут = ОбработкаОбъект.ПрогнозОжиданияМин();
	Если Минут = 0 Тогда
		Элементы.НадписьПрогноз.Заголовок = "Очередь пуста";
	Иначе
		Элементы.НадписьПрогноз.Заголовок = СтрШаблон("Ожидание ответов ЕГАИС ≈ %1 мин", Минут);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Значение)
	
	Для Каждого СтрокаПлана Из Объект.ПланИзменений Цикл
		Если Не СтрокаПлана.Выполнено И СтрокаПлана.ТипДействия <> "Информация" Тогда
			СтрокаПлана.Подтверждено = Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеРезультатов()
	
	ДобавитьОформлениеКейса(0, WebЦвета.БледноЗеленый);
	ДобавитьОформлениеКейса(1, WebЦвета.СветлоКоралловый);
	ДобавитьОформлениеКейса(2, WebЦвета.СветлоЖелтый);
	ДобавитьОформлениеКейса(3, WebЦвета.СветлоГолубой);
	ДобавитьОформлениеКейса(4, WebЦвета.РозовоКоричневый);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеКейса(Кейс, Цвет)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Результаты.Кейс");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Кейс;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.Результаты.Имя);
	
КонецПроцедуры

#КонецОбласти
