	Возврат ДиагностикаСвежая <> Истина;
	
КонецФункции

&НаКлиенте
Функция СтрокаПланаПроходитФильтр(СтрокаПлана)
	
	Если Не ЗначениеЗаполнено(ФильтрТипаДействияПлана) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрокаПлана.ТипДействия = ФильтрТипаДействияПлана;
	
КонецФункции

&НаСервере
Процедура ОбновитьПанельФильтраПланаНаСервере(Знач ЗначениеФильтра)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.УстановитьФильтрТипаДействияПлана(ЗначениеФильтра);
	ОбновитьПанельФильтраПлана(ОбработкаОбъект);
	
КонецПроцедуры

&НаСервере
Функция СледующийТипДействияНаСервере(ТекущийФильтр)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	НовыйФильтр = ОбработкаОбъект.СледующийТипДействияПлана(ТекущийФильтр);
	ОбработкаОбъект.УстановитьФильтрТипаДействияПлана(НовыйФильтр);
	ОбновитьПанельФильтраПлана(ОбработкаОбъект);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	Возврат НовыйФильтр;
	
КонецФункции

&НаСервере
Процедура ОбновитьПанельФильтраПлана(ОбработкаОбъект)
	
	ЗначениеФильтра = ОбработкаОбъект.ФильтрТипаДействияПлана();
	
	ПолеФильтра = Элементы.Найти("ФильтрТипаДействияПлана");
	Если ПолеФильтра <> Неопределено Тогда
		
		СписокТипов = ОбработкаОбъект.СписокТиповДействийПлана();
		ПолеФильтра.СписокВыбора.Очистить();
		Для Каждого ЭлементСписка Из СписокТипов Цикл
			ПолеФильтра.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ЗначениеФильтра)
			И СписокТипов.НайтиПоЗначению(ЗначениеФильтра) = Неопределено Тогда
			ЗначениеФильтра = "";
			ОбработкаОбъект.УстановитьФильтрТипаДействияПлана("");
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаПлана = Элементы.Найти("ПланИзменений");
	Если ТаблицаПлана <> Неопределено Тогда
		Если ЗначениеЗаполнено(ЗначениеФильтра) Тогда
			ТаблицаПлана.ОтборСтрок = Новый ФиксированнаяСтруктура("ТипДействия", ЗначениеФильтра);
		Иначе
			ТаблицаПлана.ОтборСтрок = Новый ФиксированнаяСтруктура;
		КонецЕсли;
	КонецЕсли;
	
	Надпись = Элементы.Найти("НадписьФильтрПлана");
	Если Надпись <> Неопределено Тогда
		Надпись.Заголовок = СводкаФильтраПлана(ОбработкаОбъект, ЗначениеФильтра);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Функция ЗначениеФильтраПланаИзЭлемента(Элемент)
	
	Если Элемент = Неопределено Тогда
		Возврат ФильтрТипаДействияПлана;
	КонецЕсли;
	
	Попытка
		Возврат Элемент.Значение;
	Исключение
		Возврат ФильтрТипаДействияПлана;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеФильтраНаФорме(ЗначениеФильтра)
	
	ПолеФильтра = Элементы.Найти("ФильтрТипаДействияПлана");
	Если ПолеФильтра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПолеФильтра.Значение = ЗначениеФильтра;
	Исключение
		// Поле без привязки к данным — значение только в переменной модуля формы.
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеКонтекстаТочки(ОбработкаОбъект)
	
	Текст = ОбработкаОбъект.ПредставлениеКонтекстаТочки();
	Надпись = Элементы.Найти("НадписьКонтекстТочки");
	Если Надпись <> Неопределено Тогда
		Надпись.Заголовок = Текст;
	КонецЕсли;
	Заголовок = "Помощник акта ЕГАИС — " + ОбработкаОбъект.ИмяИнформационнойБазы()
		+ " (v" + ОбработкаОбъект.Версия() + ")";
	
КонецПроцедуры

&НаСервере
Процедура АктПриИзмененииНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПерезагрузитьСохраненноеСостояние();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ОбновитьОтображениеКонтекстаТочки(ОбработкаОбъект);
	
КонецПроцедуры

&НаСервере
Функция СводкаФильтраПлана(ОбработкаОбъект, ЗначениеФильтра)
	
	Всего = ОбработкаОбъект.ПланИзменений.Количество();
	ВФильтре = 0;
	КОтметке = 0;
	Отмечено = 0;
	
	Для Каждого СтрокаПлана Из ОбработкаОбъект.ПланИзменений Цикл
		
		Если ЗначениеЗаполнено(ЗначениеФильтра)
			И СтрокаПлана.ТипДействия <> ЗначениеФильтра Тогда
			Продолжить;
		КонецЕсли;
		
		ВФильтре = ВФильтре + 1;
		Если СтрокаПлана.ТипДействия = "Информация" Тогда
			Продолжить;
		КонецЕсли;
		Если ОбработкаОбъект.БулевоИстина(СтрокаПлана.Выполнено) Тогда
			Продолжить;
		КонецЕсли;
		КОтметке = КОтметке + 1;
		Если ОбработкаОбъект.БулевоИстина(СтрокаПлана.Подтверждено) Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ЗначениеФильтра) Тогда
		Возврат СтрШаблон("В плане %1 строк, к применению %2, отмечено %3.",
			Всего, КОтметке, Отмечено);
	КонецЕсли;
	
	Возврат СтрШаблон("%1: показано %2 из %3, к применению %4, отмечено %5.",
		ОбработкаОбъект.ПредставлениеТипаДействия(ЗначениеФильтра),
		ВФильтре, Всего, КОтметке, Отмечено);
	
КонецФункции

&НаСервере
Процедура НастроитьОформлениеПлана()
	
	ТаблицаПлана = Элементы.Найти("ПланИзменений");
	Если ТаблицаПлана = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПланИзменений.Выполнено");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ТаблицаПлана.Имя);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеРезультатов()
	
	ДобавитьОформлениеКейса(0, WebЦвета.БледноЗеленый);
	ДобавитьОформлениеКейса(1, WebЦвета.СветлоКоралловый);
	ДобавитьОформлениеКейса(2, WebЦвета.СветлоЖелтый);
	ДобавитьОформлениеКейса(3, WebЦвета.НебесноГолубой);
	ДобавитьОформлениеКейса(4, WebЦвета.РозовоКоричневый);
	ДобавитьОформлениеСтатуса("Ручное решение", WebЦвета.Серебряный);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСтатуса(Статус, Цвет)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Результаты.Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.Результаты.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеКейса(Кейс, Цвет)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Результаты.Кейс");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Кейс;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.Результаты.Имя);
	
КонецПроцедуры

#КонецОбласти
