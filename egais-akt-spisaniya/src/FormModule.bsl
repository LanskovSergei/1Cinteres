// =============================================================================
// Внешняя обработка «Помощник акта списания ЕГАИС» — МОДУЛЬ ОСНОВНОЙ ФОРМЫ
// Версия 0.1.33 (MVP, черновик)
//
// Фильтр плана хранится в переменной модуля (см. ниже), чтобы форма открывалась без реквизита в .epf.
// Опционально: реквизит объекта или формы «ФильтрТипаДействияПлана» — тогда поле можно привязать к данным.
// Элемент НадписьКонтекстТочки (необязательно): подсказка «база + организация ЕГАИС» для параллельной работы точек.
//
// Имена элементов формы и команд — см. СТРУКТУРА_ОБРАБОТКИ.md.
// =============================================================================

&НаКлиенте
Перем ДиагностикаСвежая; // после «Диагностика» план не перечитывает 1С повторно

&НаКлиенте
Перем ФильтрТипаДействияПлана; // пусто — все типы; не требует реквизита в метаданных обработки

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ЛимитПакета = 50;
	Объект.ПерезаполнятьТолькоИсправленные = Истина;
	// Заказчик подтвердил: статусы меняются свободно, подтверждения не нужны.
	// Перед включением на рабочей базе — проверить на копии, что статус не откатывается.
	Объект.РазрешитьСменуСтатусов = Истина;
	// Заказчик подтвердил: перепроведение подтверждённой ТТН в ЕГАИС ничего не отправляет.
	// Неподтверждённые ТТН обработка не проводит — см. ПроверитьСтатусТТНПередПроведением.
	Объект.РазрешитьПроведениеТТН = Истина;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗагрузитьОчередь();
	ОбработкаОбъект.ЗагрузитьИнвентаризацию();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	НастроитьОформлениеРезультатов();
	НастроитьОформлениеПлана();
	ОбновитьПрогноз(ОбработкаОбъект);
	ПодключитьОткрытиеКарточки();
	ОбработкаОбъект.УстановитьФильтрТипаДействияПлана("");
	ОбновитьПанельФильтраПлана(ОбработкаОбъект);
	ОбновитьОтображениеКонтекстаТочки(ОбработкаОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура АктПриИзменении(Элемент)
	
	АктПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ФильтрТипаДействияПлана = "";
	ДиагностикаСвежая = Ложь;
	ПодключитьОбработчикОжидания("ОбработатьОчередьОбработчик", 60);
	
	// По просьбе клиента: при открытии сразу показываем вкладку инвентаризации
	Если Элементы.Найти("СтраницаИнвентаризация") <> Неопределено И Элементы.Найти("СтраницыФормы") <> Неопределено Тогда
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаИнвентаризация;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьАдаптер(Команда)
	
	Ошибки = ПроверитьАдаптерНаСервере();
	
	Если Ошибки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Адаптер в порядке: все объекты и реквизиты найдены.");
	Иначе
		ПоказатьПредупреждение(, "Найдены расхождения (" + Ошибки.Количество() + "):"
			+ Символы.ПС + СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Акт) Тогда
		ПоказатьПредупреждение(, "Выберите акт списания.");
		Возврат;
	КонецЕсли;
	
	ДиагностикаИПланНаСервере();
	ДиагностикаСвежая = Истина;
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаДиагностика;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПлан(Команда)
	
	Если Объект.Результаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала выполните диагностику.");
		Возврат;
	КонецЕсли;
	
	// После «Диагностика» (флаг «данные свежие») — без повторного чтения 1С и без перезаполнения сверки ЕГАИС.
	СформироватьПланНаСервере(НужноОбновитьДанные1СПередПланом());
	ДиагностикаСвежая = Ложь;
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПлан;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПодтвержденные(Команда)
	
	Отмечено = Объект.ПланИзменений.НайтиСтроки(Новый Структура("Подтверждено, Выполнено", Истина, Ложь)).Количество();
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных строк плана.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПрименитьПодтвержденныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		СтрШаблон("Применить отмеченные изменения (%1)? Они будут записаны в базу и в журнал регистрации.", Отмечено),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПодтвержденныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИтогПрименения = ПрименитьНаСервере();
	ОповеститьОбИзмененииДокументов(ИтогПрименения);
	ДиагностикаИПланНаСервере(); // после исправлений — диагностика и план заново
	ДиагностикаСвежая = Истина;
	
	Ошибок = 0;
	Для Каждого СтрокаПлана Из Объект.ПланИзменений Цикл
		Если СтрокаПлана.Подтверждено И Не СтрокаПлана.Выполнено Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Ошибок > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон("Не применено строк: %1. Причины — в колонке «Результат».", Ошибок));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СледующийТипДействия(Команда)
	
	ФильтрТипаДействияПлана = СледующийТипДействияНаСервере(ФильтрТипаДействияПлана);
	УстановитьЗначениеФильтраНаФорме(ФильтрТипаДействияПлана);
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрТипаДействияПланаПриИзменении(Элемент)
	
	ФильтрТипаДействияПлана = ЗначениеФильтраПланаИзЭлемента(Элемент);
	ОбновитьПанельФильтраПланаНаСервере(ФильтрТипаДействияПлана);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаТаблицы = Объект.Результаты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьКарточкиНоменклатуры(КарточкиНоменклатурыНаСервере(СтрокаТаблицы.Справка2, Неопределено), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИзмененийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьКарточкиНоменклатуры(КарточкиСтрокиПланаНаСервере(ВыбраннаяСтрока), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураСтрокиВыбор(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКарточкиНоменклатуры(Карточки, Элемент)
	
	Если Карточки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "По этой справке в марках нет номенклатуры.");
		Возврат;
	КонецЕсли;
	
	Если Карточки.Количество() = 1 Тогда
		ПоказатьЗначение(, Карточки[0].Номенклатура);
		Возврат;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Для Каждого Карточка Из Карточки Цикл
		Если ЗначениеЗаполнено(Карточка.Артикул) Тогда
			Представление = Карточка.Артикул + " — " + Карточка.Наименование;
		Иначе
			Представление = Карточка.Наименование;
		КонецЕсли;
		Список.Добавить(Карточка.Номенклатура, Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("НоменклатураСтрокиВыбор", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);
	
КонецПроцедуры

&НаСервере
Функция КарточкиНоменклатурыНаСервере(Справка2, НоменклатураИзПлана)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.КарточкиНоменклатуры(Справка2, НоменклатураИзПлана);
	
КонецФункции

&НаСервере
Функция КарточкиСтрокиПланаНаСервере(Идентификатор)
	
	СтрокаПлана = Объект.ПланИзменений.НайтиПоИдентификатору(Идентификатор);
	Номенклатура = Неопределено;
	Если ЗначениеЗаполнено(СтрокаПлана.ПараметрыСтрокой) Тогда
		ПараметрыДействия = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
		Если ТипЗнч(ПараметрыДействия) = Тип("Структура") И ПараметрыДействия.Свойство("Номенклатура") Тогда
			Номенклатура = ПараметрыДействия.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(СтрокаПлана.Объект) Тогда
		Номенклатура = СтрокаПлана.Объект;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.КарточкиНоменклатуры(СтрокаПлана.Справка2, Номенклатура);
	
КонецФункции

&НаСервере
Процедура ПодключитьОткрытиеКарточки()
	
	ТаблицаРезультатов = Элементы.Найти("Результаты");
	Если ТаблицаРезультатов <> Неопределено Тогда
		ТаблицаРезультатов.УстановитьДействие("Выбор", "РезультатыВыбор");
	КонецЕсли;
	
	ТаблицаПлана = Элементы.Найти("ПланИзменений");
	Если ТаблицаПлана <> Неопределено Тогда
		ТаблицаПлана.УстановитьДействие("Выбор", "ПланИзмененийВыбор");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъект(Команда)
	
	ТекущиеДанные = Элементы.ПланИзменений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьНоменклатуру(Команда)
	
	ТекущиеДанные = СтрокаПланаДляВыбораНоменклатуры();
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Встаньте на строку плана или на строку сверки с этой справкой.");
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ТипДействия = "СозданиеСоответствия" Тогда
		Если ТекущиеДанные.Выполнено Тогда
			ПоказатьПредупреждение(, "Соответствие по этой строке уже добавлено.");
			Возврат;
		КонецЕсли;
		ПредложитьСоответствиеИзМарок(ТекущиеДанные);
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ТипДействия <> "ЗаполнениеНоменклатуры" Тогда
		ПоказатьПредупреждение(, "Выбор номенклатуры доступен только для строк заполнения номенклатуры и создания соответствия.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьНоменклатуруЗавершение", ЭтотОбъект, ТекущиеДанные.ПолучитьИдентификатор());
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", // УТОЧНИТЬ имя справочника
		Новый Структура("РежимВыбора", Истина), ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// План — текущая строка. Сверка — строка «СозданиеСоответствия» той же справки.
&НаКлиенте
Функция СтрокаПланаДляВыбораНоменклатуры()
	
	Если Элементы.Найти("СтраницаСверка") <> Неопределено
		И Элементы.Найти("СтраницыФормы") <> Неопределено
		И Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаСверка Тогда
		
		ДанныеСверки = Элементы.СверкаМарок.ТекущиеДанные;
		Если ДанныеСверки = Неопределено Или Не ЗначениеЗаполнено(ДанныеСверки.Справка2) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Найденные = Объект.ПланИзменений.НайтиСтроки(
			Новый Структура("Справка2, ТипДействия", ДанныеСверки.Справка2, "СозданиеСоответствия"));
		Если Найденные.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Найденные[0];
	КонецЕсли;
	
	Возврат Элементы.ПланИзменений.ТекущиеДанные;
	
КонецФункции

// Список номенклатур с марок. Одна — вопрос «добавить», несколько — выбор из этого списка.
&НаКлиенте
Процедура ПредложитьСоответствиеИзМарок(СтрокаПлана)
	
	Идентификатор = СтрокаПлана.ПолучитьИдентификатор();
	Варианты = ВариантыСоответствияНаСервере(СтрокаПлана.Объект);
	
	Если Варианты.Количество() = 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ДобавитьСоответствиеИзСправочника", ЭтотОбъект, Идентификатор);
		ПоказатьПредупреждение(Оповещение,
			"На марках этой алкопродукции номенклатуры нет. Откроется справочник. Новую номенклатуру не создаём.");
		Возврат;
	КонецЕсли;
	
	Если Варианты.Количество() = 1 Тогда
		Доп = Новый Структура("Идентификатор, Номенклатура", Идентификатор, Варианты[0].Номенклатура);
		Оповещение = Новый ОписаниеОповещения("ДобавитьСоответствиеПодтверждение", ЭтотОбъект, Доп);
		ПоказатьВопрос(Оповещение,
			"Добавить в соответствие: " + Варианты[0].Представление + "?",
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Для Каждого Вариант Из Варианты Цикл
		Список.Добавить(Вариант.Номенклатура, Вариант.Представление);
	КонецЦикла;
	Оповещение = Новый ОписаниеОповещения("ДобавитьСоответствиеИзСписка", ЭтотОбъект, Идентификатор);
	ПоказатьВыборИзСписка(Оповещение, Список, Элементы.ПланИзменений);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСоответствиеПодтверждение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	СообщитьРезультатСоответствия(ДобавитьСоответствиеНаСервере(
		ДополнительныеПараметры.Идентификатор, ДополнительныеПараметры.Номенклатура));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСоответствиеИзСписка(ВыбранныйЭлемент, Идентификатор) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СообщитьРезультатСоответствия(ДобавитьСоответствиеНаСервере(Идентификатор, ВыбранныйЭлемент.Значение));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСоответствиеИзСправочника(ДополнительныеПараметры) Экспорт
	
