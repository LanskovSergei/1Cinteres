&НаКлиенте
Процедура ОбработатьОчередьОбработчик() Экспорт
	
	Если Объект.ОчередьЗапросов.Количество() > 0 Тогда
		
		БылоПолучено = Объект.ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Получен")).Количество();
		ОбработатьОчередьНаСервере();
		СталоПолучено = Объект.ОчередьЗапросов.НайтиСтроки(Новый Структура("Статус", "Получен")).Количество();
		
		// Пришли марки — повторная диагностика: могут всплыть кейсы 1–3.
		Если СталоПолучено > БылоПолучено И ЗначениеЗаполнено(Объект.Акт) Тогда
			ДиагностикаИПланНаСервере();
			ДиагностикаСвежая = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// Сверка статусов с уже полученным регистром №3, даже если очередь пуста.
	Если ЗначениеЗаполнено(Объект.Акт) И Объект.СверкаМарок.Количество() > 0 Тогда
		АктуализироватьРасхожденияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

