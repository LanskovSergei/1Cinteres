// Пустая строка — записано. Иначе текст ошибки для предупреждения.
&НаСервере
Функция ДобавитьСоответствиеНаСервере(Идентификатор, Номенклатура)
	
	СтрокаПлана = Объект.ПланИзменений.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаПлана = Неопределено Тогда
		Возврат "Строка плана не найдена. Сформируйте план ещё раз.";
	КонецЕсли;
	
	П = Неопределено;
	Если ЗначениеЗаполнено(СтрокаПлана.ПараметрыСтрокой) Тогда
		П = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
	КонецЕсли;
	Если ТипЗнч(П) <> Тип("Структура") Тогда
		П = Новый Структура;
	КонецЕсли;
	
	Алкопродукция = СтрокаПлана.Объект;
	Если П.Свойство("Алкопродукция") И ЗначениеЗаполнено(П.Алкопродукция) Тогда
		Алкопродукция = П.Алкопродукция;
	КонецЕсли;
	Справки = Неопределено;
	П.Свойство("Справки", Справки);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		ОбработкаОбъект.ДобавитьСоответствие(Алкопродукция, Номенклатура, Справки);
	Исключение
		СтрокаПлана.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СтрокаПлана.Выполнено = Ложь;
		Возврат СтрокаПлана.Результат;
	КонецПопытки;
	
	П.Вставить("Номенклатура", Номенклатура);
	СтрокаПлана.ПараметрыСтрокой = ЗначениеВСтрокуВнутр(П);
	СтрокаПлана.Стало = ОбработкаОбъект.ПредставлениеНоменклатурыДляПлана(Номенклатура);
	СтрокаПлана.Основание = "Добавлено в соответствие из номенклатуры марки";
	СтрокаПлана.Подтверждено = Истина;
	СтрокаПлана.Выполнено = Истина;
	СтрокаПлана.Результат = "OK";
	Возврат "";
	
КонецФункции

&НаСервере
Процедура УстановитьНоменклатуруВСтрокеПлана(Идентификатор, Номенклатура)
	
	СтрокаПлана = Объект.ПланИзменений.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаПлана = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	П = ЗначениеИзСтрокиВнутр(СтрокаПлана.ПараметрыСтрокой);
	П.Вставить("Номенклатура", Номенклатура);
	
	СтрокаПлана.ПараметрыСтрокой = ЗначениеВСтрокуВнутр(П);
	СтрокаПлана.Стало = РеквизитФормыВЗначение("Объект").ПредставлениеНоменклатурыДляПлана(Номенклатура);
	СтрокаПлана.Основание = "Выбрано вручную";
	СтрокаПлана.Подтверждено = Истина;
	
КонецПроцедуры

